 = "filesystem-metadata-v1"
FILESYSTEM_METADATA_SECCOMP_POLICIES = {
    "x86_64": {
        "audit_arch": 0xC000003E,
        "entries": (
            ("chmod", 90),
            ("fchmod", 91),
            ("chown", 92),
            ("fchown", 93),
            ("lchown", 94),
            ("utime", 132),
            ("setxattr", 188),
            ("lsetxattr", 189),
            ("fsetxattr", 190),
            ("removexattr", 197),
            ("lremovexattr", 198),
            ("fremovexattr", 199),
            ("utimes", 235),
            ("fchownat", 260),
            ("futimesat", 261),
            ("fchmodat", 268),
            ("utimensat", 280),
            ("fchmodat2", 452),
        ),
    },
    "aarch64": {
        "audit_arch": 0xC00000B7,
        "entries": (
            ("setxattr", 5),
            ("lsetxattr", 6),
            ("fsetxattr", 7),
            ("removexattr", 14),
            ("lremovexattr", 15),
            ("fremovexattr", 16),
            ("fchmod", 52),
            ("fchmodat", 53),
            ("fchownat", 54),
            ("fchown", 55),
            ("utimensat", 88),
            ("fchmodat2", 452),
