#!/usr/bin/env bash
set -euo pipefail

PAYLOAD_PATH='.github/tmp/pr2231-current-authority-state-qualification-v1.payload.gz'
EXPECTED_COMPRESSED_PAYLOAD_BLOB='7fe045e91efefbc3e5c4dc7041824aafd795d06a'
EXPECTED_EFFECTIVE_GIT_BLOB='49a79b28466625d1234a483f4d958f88e7bb54ee'
EXPECTED_EFFECTIVE_SHA256='3a4d611f6764e303f5658d1e8057e4126dc25bf64afb970877aef104105e3bb6'
EFFECTIVE_SCRIPT='/tmp/pr2231-v5-effective.sh'

test "$(git hash-object "$GITHUB_WORKSPACE/$PAYLOAD_PATH")" = "$EXPECTED_COMPRESSED_PAYLOAD_BLOB"
gzip -dc "$GITHUB_WORKSPACE/$PAYLOAD_PATH" > "$EFFECTIVE_SCRIPT"
test "$(git hash-object "$EFFECTIVE_SCRIPT")" = "$EXPECTED_EFFECTIVE_GIT_BLOB"
printf '%s  %s\n' "$EXPECTED_EFFECTIVE_SHA256" "$EFFECTIVE_SCRIPT" | sha256sum -c -
bash -n "$EFFECTIVE_SCRIPT"
if [[ "${WRAPPER_ONLY:-0}" = '1' ]]; then
  printf '%s\n' 'WRAPPER_RECONSTRUCTION_SUCCESS_V5'
  exit 0
fi
exec bash "$EFFECTIVE_SCRIPT"
