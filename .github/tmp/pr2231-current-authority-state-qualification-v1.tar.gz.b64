#!/usr/bin/env bash
set -euo pipefail

BASE_CONTROLLER_PAYLOAD_BLOB='b8d35fc5d881e36ea4fc906c8baf9049c4471726'
EXPECTED_EFFECTIVE_GIT_BLOB='53986bb7661e11dfe99fa1267e9d2cf5eb4adfee'
EXPECTED_EFFECTIVE_SHA256='da6d239017ee17ebc08e19783408d0c55c7ce7003c1f05e81d6d5541fc9bc90b'
EFFECTIVE_SCRIPT='/tmp/pr2231-v3-effective.sh'
PATCH_FILE='/tmp/pr2231-v2-to-v3.patch'

git cat-file blob "$BASE_CONTROLLER_PAYLOAD_BLOB" > "$EFFECTIVE_SCRIPT"
test "$(git hash-object "$EFFECTIVE_SCRIPT")" = "$BASE_CONTROLLER_PAYLOAD_BLOB"
cat > "$PATCH_FILE" <<'PATCH'
--- /tmp/pr2231-artifact-v2/controller-script.sh	2026-08-29 18:44:20.000000000 +0000
+++ /tmp/pr2231-v3/controller-script.sh	2026-08-29 20:19:46.465099268 +0000
@@ -19,7 +19,8 @@
 
 rm -rf "$RECEIPT_DIR" "$PRODUCT_DIR" "$MAIN_DIR" "$PATCHED_DIR"
 mkdir -p "$RECEIPT_DIR/logs" "$PATCHED_DIR/tools/lib" "$PATCHED_DIR/test"
-cp "$GITHUB_WORKSPACE/$PAYLOAD_PATH" "$RECEIPT_DIR/controller-script.sh"
+cp /tmp/pr2231-v3-effective.sh "$RECEIPT_DIR/controller-script.sh"
+cp "$GITHUB_WORKSPACE/$PAYLOAD_PATH" "$RECEIPT_DIR/controller-wrapper.sh"
 cp "$GITHUB_WORKSPACE/.github/workflows/temporary-pr2231-current-authority-state-qualification-v1.yml" \
   "$RECEIPT_DIR/controller-workflow.yml"
 
@@ -106,6 +107,14 @@
     witness(actual) {
       assert.equal(actual.includes('3.14'), false);
     }
+  },
+  {
+    name: 'decimal-observation-before-dash-led-independent-phone',
+    input: 'Archive 09012345678 3.14-03-6216-8041',
+    expected: 'Archive [contact omitted] 3.14-[contact omitted]',
+    witness(actual) {
+      assert.equal(actual, 'Archive [contact omitted] 3.14-03-6216-8041');
+    }
   }
 ];
 
@@ -314,7 +323,59 @@
     'extension calendar validation'
 )
 
-sentinel = 'exact authority-state regression: invalid calendar, dotted phone, dash decimal'
+old_optimizer_entry = """  const completeDateRanges = completeDateObservationRanges(candidate, groups);
+  const intervals = Array.from({ length: groups.length }, () => []);
+  for (let first = 0; first < groups.length; first += 1) {
+    if (!allowInitialGroup) {
+      if (first === 0) continue;
+      const previousEnd = groups[first - 1].index + groups[first - 1][0].length;
+      if (!/\s/u.test(candidate.slice(previousEnd, groups[first].index))) continue;
+    }
+    for (let last = first;
+      last < groups.length && last < first + MAX_PHONE_DIGIT_GROUPS;
+      last += 1) {"""
+new_optimizer_entry = """  const completeDateRanges = completeDateObservationRanges(candidate, groups);
+  const intervals = Array.from({ length: groups.length }, () => []);
+  for (let first = 0; first < groups.length; first += 1) {
+    if (!allowInitialGroup) {
+      if (first === 0) continue;
+      const previousEnd = groups[first - 1].index + groups[first - 1][0].length;
+      if (!/\s/u.test(candidate.slice(previousEnd, groups[first].index))) continue;
+    }
+
+    // Context-free validation may prove that one telephone beginning at this
+    // group ends before an independent telephone or strong observation. Once
+    // that exact interval exists, generic labelled optimization may not enlarge
+    // the same start across the proved boundary and consume the next source.
+    const intrinsicBoundary = validatedIntrinsicPhoneContinuation(
+      candidate,
+      groups,
+      first
+    );
+    let intrinsicBoundaryLast = groups.length - 1;
+    if (intrinsicBoundary && intrinsicBoundary.end < candidate.length) {
+      intrinsicBoundaryLast = first;
+      while (intrinsicBoundaryLast + 1 < groups.length
+          && groups[intrinsicBoundaryLast + 1].index
+            + groups[intrinsicBoundaryLast + 1][0].length
+            <= intrinsicBoundary.end) {
+        intrinsicBoundaryLast += 1;
+      }
+    }
+
+    for (let last = first;
+      last < groups.length
+        && last < first + MAX_PHONE_DIGIT_GROUPS
+        && last <= intrinsicBoundaryLast;
+      last += 1) {"""
+library = replace_once(
+    library,
+    old_optimizer_entry,
+    new_optimizer_entry,
+    'exact intrinsic interval optimizer boundary'
+)
+
+sentinel = 'exact authority-state regression: invalid calendar, dotted phone, dash decimal v3'
 if sentinel in tests:
     raise SystemExit('focused regression sentinel already present')
 
@@ -330,12 +391,32 @@
   [
     'Phone: 09012345678 03.6216.8041',
     'Phone: [contact omitted] [contact omitted]',
-    'a complete dotted phone must outrank its decimal prefix under explicit phone authority'
+    'a complete intrinsic phone may not enlarge into the first group of a later dotted phone'
+  ],
+  [
+    'Mobile number: 09012345678 03.6216.8041',
+    'Mobile number: [contact omitted] [contact omitted]',
+    'mobile label authority must preserve two exact independent telephone intervals'
+  ],
+  [
+    'Phone: ０９０１２３４５６７８ ０３．６２１６．８０４１',
+    'Phone: [contact omitted] [contact omitted]',
+    'fullwidth dotted telephone intervals must retain the same exact boundary custody'
   ],
   [
     'Archive +81 3 6216 8041–3.14',
     'Archive [contact omitted]–3.14',
     'a dash-led decimal observation must begin after the proved international phone interval'
+  ],
+  [
+    'Archive +81 3 6216 8041—３．１４',
+    'Archive [contact omitted]—３．１４',
+    'typographic-dash and fullwidth decimal source bytes must survive exact redaction'
+  ],
+  [
+    'Archive 09012345678 3.14-03-6216-8041',
+    'Archive [contact omitted] 3.14-[contact omitted]',
+    'a complete decimal observation must bridge to a dash-led independent telephone'
   ]
 ]) {{
   assert.equal(redactContactData(input), expected, message);
@@ -344,6 +425,7 @@
 for (const observation of [
   'Archive 2026-08-17',
   'Archive 17.08.2026',
+  'Archive 29.02.2024',
   'Archive 3.14',
   'Archive 10-20 people'
 ]) {{
@@ -373,7 +455,11 @@
 for (const [input, expected] of [
   ['Archive 03-6216-8041-3.14', 'Archive [contact omitted]-3.14'],
   ['Phone: 09012345678 03.6216.8041', 'Phone: [contact omitted] [contact omitted]'],
-  ['Archive +81 3 6216 8041–3.14', 'Archive [contact omitted]–3.14']
+  ['Mobile number: 09012345678 03.6216.8041', 'Mobile number: [contact omitted] [contact omitted]'],
+  ['Phone: ０９０１２３４５６７８ ０３．６２１６．８０４１', 'Phone: [contact omitted] [contact omitted]'],
+  ['Archive +81 3 6216 8041–3.14', 'Archive [contact omitted]–3.14'],
+  ['Archive +81 3 6216 8041—３．１４', 'Archive [contact omitted]—３．１４'],
+  ['Archive 09012345678 3.14-03-6216-8041', 'Archive [contact omitted] 3.14-[contact omitted]']
 ]) {
   assert.equal(redactContactData(input), expected);
 }
@@ -487,7 +573,7 @@
 test "$pr_head" = "$EXPECTED_PRODUCT"
 
 cat > "$RECEIPT_DIR/result.txt" <<EOF
-QUALIFICATION_SUCCESS
+QUALIFICATION_SUCCESS_V3
 product_moved=false
 draft_changed=false
 review_threads_changed=false
@@ -497,4 +583,4 @@
 candidate_test_blob=${candidate_test_blob}
 EOF
 
-printf '%s\n' 'QUALIFICATION_SUCCESS'
+printf '%s\n' 'QUALIFICATION_SUCCESS_V3'
PATCH
patch --silent "$EFFECTIVE_SCRIPT" "$PATCH_FILE"
test "$(git hash-object "$EFFECTIVE_SCRIPT")" = "$EXPECTED_EFFECTIVE_GIT_BLOB"
printf '%s  %s\n' "$EXPECTED_EFFECTIVE_SHA256" "$EFFECTIVE_SCRIPT" | sha256sum -c -
bash -n "$EFFECTIVE_SCRIPT"
if [[ "${WRAPPER_ONLY:-0}" = '1' ]]; then
  printf '%s\n' 'WRAPPER_RECONSTRUCTION_SUCCESS'
  exit 0
fi
exec bash "$EFFECTIVE_SCRIPT"
