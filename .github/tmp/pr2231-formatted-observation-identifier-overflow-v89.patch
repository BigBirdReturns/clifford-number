+
+// PR2231 formatted-observation dash-boundary custody regressions
+for (const [name, input, expected] of [
+  [
+    'labelled formatted time with seconds preserves the time before an intrinsic phone',
+    'Phone: 09012345678 12:30:45-03-6216-8041',
+    'Phone: [contact omitted] 12:30:45-[contact omitted]'
+  ],
+  [
+    'unlabelled formatted time with seconds preserves the time before an intrinsic phone',
+    'Archive 09012345678 12:30:45-03-6216-8041',
+    'Archive [contact omitted] 12:30:45-[contact omitted]'
+  ],
+  [
+    'labelled formatted time with minutes preserves the time before an intrinsic phone',
+    'Phone: 09012345678 12:30-03-6216-8041',
+    'Phone: [contact omitted] 12:30-[contact omitted]'
+  ],
+  [
+    'fullwidth formatted time preserves the time before an intrinsic phone',
+    '電話：０９０１２３４５６７８ １２：３０：４５－０３－６２１６－８０４１',
+    '電話：[contact omitted] １２：３０：４５－[contact omitted]'
+  ],
+  [
+    'an attached dash does not transport a phone label into a weak local range',
+    'Phone: 09012345678 12:30:45-555-1212',
+    'Phone: [contact omitted] 12:30:45-555-1212'
+  ],
+  [
+    'an attached dash does not convert a bare numeric tail into a phone',
+    'Phone: 09012345678 12:30:45-12345678',
+    'Phone: [contact omitted] 12:30:45-12345678'
+  ],
+  [
+    'an attached date after a formatted time retains date custody',
+    'Phone: 09012345678 12:30:45-2027-09-18',
+    'Phone: [contact omitted] 12:30:45-2027-09-18'
+  ],
+  [
+    'an attached decimal after a formatted time retains decimal custody',
+    'Phone: 09012345678 12:30:45-3.14',
+    'Phone: [contact omitted] 12:30:45-3.14'
+  ],
+  [
+    'an attached unit-bearing observation retains exact source custody',
+    'Phone: 09012345678 12:30:45-03-62165111 people 03-6216-8041',
+    'Phone: [contact omitted] 12:30:45-03-62165111 people [contact omitted]'
+  ],
+  [
+    'an outer wrapper around trunk notation remains outside the telephone interval',
+    'Phone: 09012345678 12:30:45-((03) 6216 8041)',
+    'Phone: [contact omitted] 12:30:45-([contact omitted])'
+  ],
+  [
+    'the existing whitespace bridge still carries one-use explicit label authority',
+    'Phone: 09012345678 12:30:45 555-1212',
+    'Phone: [contact omitted] 12:30:45 [contact omitted]'
+  ]
+]) {
+  assert.equal(
+    redactContactData(input),
+    expected,
+    `${name}: complete formatted observations must keep exact source custody and dash boundaries must require context-free telephone proof`
+  );
+}
+
+// PR2231 identifier-label chain cap regressions
+const identifierChainAtLimit = `Archive ${'ID '.repeat(4096)}09012345678`;
+const identifierChainPastLimit = `Archive ${'ID '.repeat(4097)}09012345678`;
+const phoneChainAtLimit = `Phone ${'ID '.repeat(4096)}09012345678`;
+const phoneChainPastLimit = `Phone ${'ID '.repeat(4097)}09012345678`;
+assert.equal(
+  redactContactData(identifierChainAtLimit),
+  identifierChainAtLimit,
+  'the maximum fully inspected identifier-label chain must retain identifier custody'
+);
+assert.equal(
+  redactContactData(identifierChainPastLimit),
+  identifierChainPastLimit,
+  'overflowing the bounded identifier-label scan must not synthesize telephone-label authority'
+);
+assert.equal(
+  redactContactData(phoneChainAtLimit),
+  `Phone ${'ID '.repeat(4096)}[contact omitted]`,
+  'a telephone label proved within the bounded identifier-label scan must remain authoritative'
+);
+assert.equal(
+  redactContactData(phoneChainPastLimit),
+  phoneChainPastLimit,
+  'a telephone label outside the bounded identifier-label scan must not be fabricated as proved authority'
+);
