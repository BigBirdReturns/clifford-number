    }

    const descriptorRootStats = fs.fstatSync(session.descriptorRootDescriptor);
    const descriptorRootPathStats = fs.statSync(RECEIPT_DESCRIPTOR_ROOT);
    if (!descriptorRootStats.isDirectory()
