--- /dev/null
+++ b/test/scheduled-crawl-pr-identity.test.js
@@ -0,0 +1,110 @@
+#!/usr/bin/env node
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const ACTION = 'actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1';
+const canonical = {
+  industrial: readFileSync('.github/workflows/crawl-industrial-exhaust.yml', 'utf8'),
+  official: readFileSync('.github/workflows/crawl-official.yml', 'utf8'),
+  helper: readFileSync('.github/scripts/promote-scheduled-crawl.sh', 'utf8')
+};
+
+function requireMatch(errors, text, pattern, message) {
+  if (!pattern.test(text)) errors.push(message);
+}
+
+function requireAbsent(errors, text, pattern, message) {
+  if (pattern.test(text)) errors.push(message);
+}
+
+export function validateScheduledCrawlPrIdentity(files) {
+  const errors = [];
+  for (const [label, workflow] of [
+    ['industrial-exhaust workflow', files.industrial],
+    ['official-record workflow', files.official]
+  ]) {
+    requireMatch(errors, workflow,
+      /CONFIGURED: \$\{\{ secrets\.SCHEDULED_CRAWL_PR_APP_CLIENT_ID != '' && secrets\.SCHEDULED_CRAWL_PR_APP_PRIVATE_KEY != '' \}\}/,
+      `${label} must detect the complete App credential pair without exposing either secret`);
+    requireMatch(errors, workflow, new RegExp(`uses: ${ACTION.replaceAll('/', '\\/')}`),
+      `${label} must pin the App-token action to the reviewed v3.2.0 commit`);
+    requireMatch(errors, workflow, /if: steps\.pr-identity\.outputs\.configured == 'true'/,
+      `${label} must mint only when both App credentials are configured`);
+    requireMatch(errors, workflow, /continue-on-error: true\n        uses: actions\/create-github-app-token@/,
+      `${label} must preserve candidate recovery when token minting fails`);
+    requireMatch(errors, workflow,
+      /owner: \$\{\{ github\.repository_owner \}\}\n          repositories: \$\{\{ github\.event\.repository\.name \}\}\n          permission-pull-requests: write/,
+      `${label} must scope the installation token to this repository and PR write`);
+    requireMatch(errors, workflow,
+      /SCHEDULED_CRAWL_PR_TOKEN: \$\{\{ steps\.pr-token\.outputs\.token \}\}/,
+      `${label} must pass the App token separately from GITHUB_TOKEN`);
+    requireAbsent(errors, workflow,
+      /GH_TOKEN: \$\{\{ steps\.pr-token\.outputs\.token \}\}/,
+      `${label} must not replace the job's GITHUB_TOKEN globally`);
+  }
+
+  const helper = files.helper;
+  requireMatch(errors, helper,
+    /^#!\/usr\/bin\/env bash\nset -Eeuo pipefail\n\nPR_TOKEN="\$\{SCHEDULED_CRAWL_PR_TOKEN:-\}"\nunset SCHEDULED_CRAWL_PR_TOKEN\n/,
+    'helper must capture and de-export the App token before any child process runs');
+  requireMatch(errors, helper, /PR_AUTHOR=''/,
+    'helper must retain PR-author attribution');
+  requireMatch(errors, helper, /pull_request_author=%s/,
+    'checkpoint must retain PR-author attribution');
+  requireMatch(errors, helper, /STAGE='require-pull-request-publication-identity'/,
+    'helper must declare the publication-identity gate');
+  requireMatch(errors, helper, /publication_identity_missing/,
+    'missing App identity must have a distinct terminal outcome');
+  requireMatch(errors, helper, /publication_identity_not_distinct/,
+    'GITHUB_TOKEN reuse must have a distinct terminal outcome');
+
+  const identity = helper.indexOf("STAGE='require-pull-request-publication-identity'");
+  const publish = helper.indexOf("STAGE='publish-run-scoped-candidate'");
+  const open = helper.indexOf("STAGE='open-ordinary-pull-request'");
+  const dispatch = helper.indexOf("STAGE='dispatch-required-checks'");
+  if (!(identity >= 0 && publish > identity && open > publish && dispatch > open)) {
+    errors.push('identity, branch publication, PR creation and dispatch must remain ordered');
+  }
+
+  const prSection = helper.slice(open, dispatch);
+  requireMatch(errors, prSection,
+    /GH_TOKEN="\$PR_TOKEN" \\\n  gh api --method POST "repos\/\$REPO\/pulls"/,
+    'App token must wrap only the PR creation API call');
+  requireMatch(errors, prSection, /unset PR_TOKEN/,
+    'helper must erase the unexported App token immediately after PR creation');
+  requireMatch(errors, prSection,
+    /\.user\.type == "Bot"[\s\S]*\.user\.login != "github-actions\[bot\]"/,
+    'created PR must bind a distinct GitHub App bot author');
+  requireMatch(errors, prSection, /pull-request-author\.json/,
+    'PR publication must retain a non-secret author receipt');
+  requireAbsent(errors, helper.slice(dispatch), /PR_TOKEN|SCHEDULED_CRAWL_PR_TOKEN/,
+    'App token must not reach dispatch, qualification, merge or cleanup');
+
+  return errors;
+}
+
+assert.deepEqual(validateScheduledCrawlPrIdentity(canonical), [],
+  'canonical scheduled-crawl PR identity contract must validate');
+
+const mutations = [
+  ['remove industrial App mint', (c) => { c.industrial = c.industrial.replace(ACTION, 'actions/checkout@v4'); }],
+  ['remove official App mint', (c) => { c.official = c.official.replace(ACTION, 'actions/checkout@v4'); }],
+  ['broaden token permission', (c) => { c.industrial = c.industrial.replace('permission-pull-requests: write', 'permission-contents: write'); }],
+  ['remove repository scope', (c) => { c.official = c.official.replace('          repositories: ${{ github.event.repository.name }}\n', ''); }],
+  ['replace global GH token', (c) => { c.industrial = c.industrial.replace('GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}', 'GH_TOKEN: ${{ steps.pr-token.outputs.token }}'); }],
+  ['drop missing-identity outcome', (c) => { c.helper = c.helper.replace('publication_identity_missing', 'failed_closed'); }],
+  ['reuse GITHUB_TOKEN identity', (c) => { c.helper = c.helper.replace('publication_identity_not_distinct', 'failed_closed'); }],
+  ['open PR with global token', (c) => { c.helper = c.helper.replace('GH_TOKEN="$PR_TOKEN" \\\n  gh api --method POST', 'gh api --method POST'); }],
+  ['retain App token after PR creation', (c) => { c.helper = c.helper.replace('unset PR_TOKEN\nPR_NUMBER=', 'PR_NUMBER='); }],
+  ['drop App author binding', (c) => { c.helper = c.helper.replace('.user.type == "Bot"', 'true'); }],
+  ['leak App token into dispatch', (c) => { c.helper = c.helper.replace("STAGE='dispatch-required-checks'", "STAGE='dispatch-required-checks'\nGH_TOKEN=\"$PR_TOKEN\""); }]
+];
+
+for (const [label, mutate] of mutations) {
+  const candidate = structuredClone(canonical);
+  mutate(candidate);
+  assert.ok(validateScheduledCrawlPrIdentity(candidate).length > 0,
+    `mutation should fail closed: ${label}`);
+}
+
+console.log(`scheduled-crawl-pr-identity.test: ${mutations.length} adversarial mutations PASS`);
