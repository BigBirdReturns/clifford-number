        "import path from 'node:path';\nimport zlib from 'node:zlib';\n",
        'zlib import',
    )
    text = replace_once(text, '\nclass HostGate{\n', f'\n{GLOBAL_TIDE_CODE}\nclass HostGate{{\n', 'global tide implementation')
