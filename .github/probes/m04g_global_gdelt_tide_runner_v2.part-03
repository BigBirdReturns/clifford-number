test "$(git rev-parse HEAD^)" = "$BASE_SHA"
test "$(git diff-tree --no-commit-id --name-only -r HEAD | wc -l | tr -d ' ')" = 3
git push origin "HEAD:refs/heads/$CANDIDATE_BRANCH"
