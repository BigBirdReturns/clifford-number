mapfile -t changed < <(git diff --name-only | sort)
expected=(
  data/project/m04g-source-ecology-v2-policy.json
  test/m05-answerable-power-sprint-03-leg-07.test.js
  tools/lib/m04g-source-ecology-v2.mjs
)
