eline': {
        'summary': baseline_receipt['summary'],
        'gdelt_route_successes': baseline_successes,
        'gdelt_network_attempts': baseline_attempts,
    },
    'candidate': {
        'summary': summary,
        'gdelt_route_successes': 12,
        'gdelt_network_requests': 1,
    },
    'boundaries': {
        'denominator_changed': False,
        'thresholds_changed': False,
        'failure_taxonomy_changed': False,
        'locator_content_treated_as_evidence': False,
        'evidentiary_sufficiency_promoted': False,
        'answer_effectiveness_promoted': False,
    },
}
(root/'decision.json').write_text(json.dumps(decision, indent=2)+'\n')
print(json.dumps(decision, indent=2))
PY

