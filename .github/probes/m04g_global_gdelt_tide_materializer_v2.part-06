ync(path.join(outputDir,'m04g-source-ecology-v2-basin-health.json'),JSON.stringify(byBasin,null,2)+'\\n');\n    fs.writeFileSync(path.join(outputDir,'m04g-source-ecology-v2-global-tides.json'),JSON.stringify(globalTideResult.receipts,null,2)+'\\n');\n    for(const artifact of globalTideResult.artifacts){\n      if(artifact.compressed.length)fs.writeFileSync(path.join(outputDir,artifact.receipt.artifacts.compressed),artifact.compressed);\n      if(artifact.decompressed.length)fs.writeFileSync(path.join(outputDir,artifact.receipt.artifacts.decompressed),artifact.decompressed);\n    }\n    fs.writeFileSync(path.join(outputDir,'m04g-source-ecology-v2-receipt.json'),JSON.stringify(receipt,null,2)+'\\n');\n",
        'global tide artifacts',
    )
    text = replace_once(
        text,
        "  return {discovery,observations,failures,byBasin,summary,receipt};\n}",
        "  return {discovery,observations,failures,byBasin,summary,receipt,global_tides:globalTideResult.receipts};\n}",
        'orbit return',
    )
    path.write_text(text)


