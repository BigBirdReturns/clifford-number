    }
  ],
  "dimensions": [
    {
      "id": "CS-01",
      "name": "support_adjusted_surplus",
      "question": "Does independently reviewable output materially exceed what the available support, runway, title, authority, staff, or sponsorship would predict?"
    },
    {
      "id": "CS-02",
      "name": "cross_domain_transfer",
      "question": "Does the same governing operation produce valid state transitions across materially different domains?"
    },
    {
      "id": "CS-03",
      "name": "exception_handling",
      "question": "When the script fails, does the operator detect propagation, preserve viable branches, and restore a recoverable state?"
    },
    {
      "id": "CS-04",
      "name": "custody",
      "question": "Do entrusted accounts, data, equipment, systems, people, or unfinished work return usable, inspectable, and without hidden damage?"
    },
    {
      "id": "CS-05",
      "name": "model_elasticity",
      "question": "Can documented contradiction enter the model without retaliation, secrecy, explanation mutation, or prosecution of the critic?"
    },
    {
      "id": "CS-06",
      "name": "governed_capacity",
      "question": "Does the operator allocate attention and force according to stakes rather than audience or status pressure?"
    },
    {
      "id": "CS-07",
      "name": "non_zero_sum_orientation",
      "question": "Does another capable person enlarge the system rather than trigger compulsory dominance, authorship, or rank defense?"
    },
    {
      "id": "CS-08",
      "name": "epistemic_restraint",
      "question": "Does the operator preserve distinctions among observation, interpretation, hypothesis, receipt, non-link, and falsifier?"
    }
  ],
  "review_stages": [
    {
      "stage_id": "CS-S0",
      "name": "source_routed_intake",
      "required": "one bounded public-source or consented-private artifact, transition, custody event, control, or repair sequence",
      "output": "typed graph-inert intake object"
    },
    {
      "stage_id": "CS-S1",
      "name": "blind_first_review",
      "required": "artifact packet without title, employer, school, follower count, demographic identity, political alignment, or network sponsorship where lawful and practicable",
      "output": "artifact-validity and missing-receipt ledger"
    },
    {
      "stage_id": "CS-S2",
      "name": "support_ledger",
      "required": "time, tools, authority, money, collaborators, institutional access, constraints, and missing support",
      "output": "support-adjusted context without a merit shortcut"
    },
    {
      "stage_id": "CS-S3",
      "name": "bounded_transfer_test",
      "required": "one unfamiliar problem or independently documented transfer across a materially different domain",
      "output": "task-specific transfer result"
    },
    {
      "stage_id": "CS-S4",
      "name": "contradiction_and_disruption_test",
      "required": "one accurate contradiction plus one changed requirement, removed tool, false source, dependency failure, or revealed harm",
      "output": "update, exception-handling, and damage-localization record"
    },
    {
      "stage_id": "CS-S5",
      "name": "custody_and_handoff",
      "required": "an independent operator can inspect, resume, reverse, or safely decline the work",
      "output": "custody, rollback, and handoff receipt"
    },
    {
      "stage_id": "CS-S6",
      "name": "second_party_review",
      "required": "independent review of the evidence vector, class assignment, matched control, counterevidence, and falsifier",
      "output": "reviewed bounded disposition"
    },
    {
      "stage_id": "CS-S7",
      "name": "bounded_collaboration",
      "required": "consent, task-specific scope, reciprocal value or compensation, stop rule, exit, and privacy boundary",
      "output": "observed collaboration result including failure or withdrawal"
    }
  ],
