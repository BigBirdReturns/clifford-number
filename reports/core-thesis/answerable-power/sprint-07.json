  "adjudication_roles": [
    {
      "role_id": "A1-ROLE-01",
      "name": "independence_adjudicator",
      "function": "Determine identity, legal-entity separation, funding, relationships, contribution history, selection integrity, and conflicts without deciding technical evidence sufficiency."
    },
    {
      "role_id": "A1-ROLE-02",
      "name": "evidence_adjudicator",
      "function": "Inspect exact-reference custody, command chronology, logs, failures, output fingerprints, signatures, and reproducibility without deciding the reproducer’s institutional independence."
    },
    {
      "role_id": "A1-ROLE-03",
      "name": "challenge_reviewer",
      "function": "Review timely public challenges and require a new transaction when a material challenge, dissent, or contradiction remains unresolved."
    },
    {
      "role_id": "A1-ROLE-04",
      "name": "registry_custodian",
      "function": "Verify mechanical transaction completeness and append the approved entry without changing substantive findings or suppressing history."
    },
    {
      "role_id": "A1-ROLE-05",
      "name": "public_observer",
      "function": "Inspect the docket, selection record, decisions, challenges, blockers, registry history, and later revocation or expiry."
    }
  ],
