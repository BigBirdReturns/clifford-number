{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clifford-comprehension-session@1",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "claim_id",
    "artifact",
    "independence",
    "ordinary_surface_actions",
    "post_action_explanation"
  ],
  "properties": {
    "schema_version": { "const": "clifford-comprehension-session@1" },
    "session_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "independence": {
      "type": "object",
      "required": ["fresh_operator", "forbidden_channels_used"],
      "properties": {
        "fresh_operator": { "const": true },
        "forbidden_channels_used": { "type": "array" }
      }
    },
    "precommit_expectation": { "type": "string", "minLength": 1 },
    "ordinary_surface_actions": { "type": "array", "minItems": 1 },
    "post_action_explanation": { "type": "string", "minLength": 1 },
    "adjudication": {
      "type": "object",
      "properties": {
        "semantic_verdict": { "enum": ["FAIL", "INCONCLUSIVE", "READY_FOR_ADJUDICATION"] }
      }
    }
  }
}
