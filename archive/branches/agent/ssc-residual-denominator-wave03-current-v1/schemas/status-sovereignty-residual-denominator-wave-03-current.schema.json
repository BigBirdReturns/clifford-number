  "$defs": {
    "classReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "class_id",
        "issue",
        "source_pr",
        "merge_commit",
        "constitutional_exact_label",
        "receipt_class_label",
        "labels_exact_match",
        "label_reconciliation",
        "terminal_state",
        "closure_reference_path",
        "class_receipt_path",
        "manifest_combined_sha256",
        "class_closed"
      ],
      "properties": {
        "lane_id": {
          "pattern": "^RD-0[1-6]$"
        },
        "class_id": {
          "pattern": "^RD-0[1-6]-C0[1-8]$"
        },
        "issue": {
          "type": "integer"
        },
        "source_pr": {
          "type": "integer"
        },
        "merge_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "constitutional_exact_label": {
          "type": "string",
          "minLength": 1
        },
        "receipt_class_label": {
          "type": "string",
          "minLength": 1
        },
        "labels_exact_match": {
          "type": "boolean"
        },
        "label_reconciliation": {
          "type": "string",
          "minLength": 1
        },
        "terminal_state": {
          "enum": [
            "evidence_complete",
            "bounded_non_link",
            "bounded_source_restricted",
            "bounded_source_unavailable"
          ]
        },
        "closure_reference_path": {
          "type": "string",
          "minLength": 1
        },
        "class_receipt_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_combined_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "class_closed": {
          "const": true
        }
