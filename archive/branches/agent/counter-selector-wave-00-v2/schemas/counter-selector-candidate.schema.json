{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-candidate-v1.json",
  "title":"Counter-Selector Candidate Record",
  "type":"object",
  "additionalProperties":false,
  "required":["candidate_id","candidate_type","surface","domain","jurisdiction","conventional_status_metadata","available_support","state_load","observed_artifacts","observed_state_transitions","support_adjusted_surplus","cross_domain_transfer","exception_handling","custody","model_elasticity","governed_capacity","non_zero_sum_orientation","epistemic_restraint","status_output_residual","comparators","matched_control","alternative_explanations","counterevidence","falsifier","missing_receipt","bounded_test","handoff_test","contradiction_test","field_result","review_state","graph_effect"],
  "properties":{
    "candidate_id":{"type":"string","pattern":"^CS-C[0-9]{4,}$"},
    "candidate_type":{"enum":["individual","team","project","maintainer_group"]},
    "surface":{"type":"string","minLength":2},
    "domain":{"type":"string","minLength":2},
    "jurisdiction":{"type":"string","minLength":2},
    "conventional_status_metadata":{"type":"object"},
    "available_support":{"type":"object"},
    "state_load":{"type":"object"},
    "observed_artifacts":{"type":"array","minItems":1,"items":{"type":"string"}},
    "observed_state_transitions":{"type":"array","minItems":1,"items":{"type":"object"}},
    "support_adjusted_surplus":{"$ref":"#/$defs/dimension"},
    "cross_domain_transfer":{"$ref":"#/$defs/dimension"},
    "exception_handling":{"$ref":"#/$defs/dimension"},
    "custody":{"$ref":"#/$defs/dimension"},
    "model_elasticity":{"$ref":"#/$defs/dimension"},
    "governed_capacity":{"$ref":"#/$defs/dimension"},
    "non_zero_sum_orientation":{"$ref":"#/$defs/dimension"},
    "epistemic_restraint":{"$ref":"#/$defs/dimension"},
    "status_output_residual":{"type":"object","required":["state","evidence","limits"],"additionalProperties":true},
    "comparators":{"type":"array","minItems":1,"items":{"type":"string"}},
    "matched_control":{"type":["string","null"]},
    "alternative_explanations":{"type":"array","minItems":1,"items":{"type":"string"}},
    "counterevidence":{"type":"array","items":{"type":"object"}},
    "falsifier":{"type":"string","minLength":4},
    "missing_receipt":{"type":"array","items":{"type":"string"}},
    "bounded_test":{"type":"object"},
    "handoff_test":{"type":"object"},
    "contradiction_test":{"type":"object"},
    "field_result":{"type":"object"},
    "review_state":{"enum":["candidate_only","blind_artifact_reviewed","support_ledger_complete","transfer_tested","disruption_tested","custody_tested","second_party_reviewed","supported_for_bounded_field_test","supported_as_repair_capable_operator","supported_as_domain_limited_operator","retained_candidate_only","bounded_non_link","false_positive_outsider_myth","falsified","identity_ambiguous","source_restricted","requires_additional_acquisition","withdrawn"]},
    "graph_effect":{"const":"none"}
  },
  "$defs":{"dimension":{"type":"object","required":["score","evidence","limits"],"properties":{"score":{"type":"integer","minimum":0,"maximum":4},"evidence":{"type":"array","items":{"type":"string"}},"limits":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}}
}
