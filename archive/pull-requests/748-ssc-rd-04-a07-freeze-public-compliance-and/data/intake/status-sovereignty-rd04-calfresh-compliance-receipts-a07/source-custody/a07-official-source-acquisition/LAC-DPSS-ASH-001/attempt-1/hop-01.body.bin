  <script>

    var forms = document.querySelectorAll("form");
    for (var i = 0; i < forms.length; i++) {
      var formId = forms[i].id;
      var form = document.querySelector('form');
      if (formId !== "dpss-miniCalendarSearchForm") {

        window.adobeDataLayer = window.adobeDataLayer || [];
        window.adobeDataLayer.push({
          "event": "form_start",
          "formInfo": {
            "name": formId,
          },
        });
      }
    }
    const urlParams = new URLSearchParams(window.location.search);
    const myParam = urlParams.get('intcid');
    if (myParam !== null) {
      document.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', (e) => {
          let targetUrl = e.target.href;
          if ((targetUrl != null) && (targetUrl.includes("?intcid"))) {
            const queryParam = targetUrl.split('?');
            let indexofq = targetUrl.indexOf("?");
            let substringval = targetUrl.substr(0, indexofq);
            let finalurl = substringval + ".html?" + queryParam[queryParam.length - 1];
            $("a").attr("href", finalurl);
          }
        });
      });
    }

    window.adobeDataLayer = window.adobeDataLayer || [];
    window.adobeDataLayer.push({
      "event": "pageLoaded",
      "web": {
        "webPageDetails": {
          "name": 'dpss:public:en:home:epolicy:integrity:ash:state\u002Dhearing\u002Dprocedures',
          "server": window.location.hostname,
          "siteSection": 'public home',
          "pageViews": {
            "value": 1
          }
        }
      },
      "pageInfo": {
        "siteSection1": 'epolicy',
        "siteSection2": 'program integrity',
        "siteSection3": 'ash',
        "siteSection4": 'ash 001 – state hearing procedures',
        "siteSection5": '',
        "pageType": 'epolicy program content page',
        "pageURL": window.location.href,
        "language": "english"
      },
      "userInfo": {
        "id": '',
        "type": ''
      }
    });
    var rteDivs = document.querySelectorAll('div.cmp-text.rte__content');
    for (var i = 0; i < rteDivs.length; i++) {
      var rteDiv = rteDivs[i];
      // Get all anchor tags within the div
      var anchors = rteDiv.querySelectorAll('a');
      // Loop through each anchor tag and add attributes
      for (var j = 0; j < anchors.length; j++) {
        var anchor = anchors[j];
        // Add your custom attributes here
        anchor.setAttribute('data-componenttype', 'Text');
        anchor.setAttribute('data-linkLocation', 'body');
        var textContent = anchor.textContent;
        anchor.setAttribute('data-linkText', textContent);

      }
    }
  </script>

