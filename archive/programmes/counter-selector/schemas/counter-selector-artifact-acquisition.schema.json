{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-artifact-acquisition.schema.json",
  "title": "Counter-Selector artifact acquisition record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "candidate_id",
    "blind_token",
    "denominator_class",
    "qualification",
    "acquisition_state",
    "source_packet_ids",
    "artifact_summary",
    "missing_receipts",
    "falsifier",
    "review_state",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-artifact-acquisition@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W03-B01"
    },
    "candidate_id": {
      "pattern": "^CS-C\\d{4}$"
    },
    "blind_token": {
      "pattern": "^CS-BP\\d{4}$"
    },
    "denominator_class": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "enum": [
        "qualifying_for_blind_packet",
        "partial_not_blind_ready",
        "bounded_non_link"
      ]
    },
    "acquisition_state": {
      "type": "string",
      "minLength": 1
    },
    "source_packet_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^CS-W03-S\\d{3}$"
      }
    },
    "artifact_summary": {
      "type": "string",
      "minLength": 40
    },
    "missing_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "falsifier": {
      "type": "string",
      "minLength": 30
    },
    "review_state": {
      "enum": [
        "blind_packet_ready_not_reviewed",
        "partial_acquisition_retained",
        "bounded_non_link_retained"
      ]
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
