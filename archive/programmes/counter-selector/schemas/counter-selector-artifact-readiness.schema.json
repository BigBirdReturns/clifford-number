{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-artifact-readiness-v1.json",
  "title": "Counter-Selector Artifact Readiness Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "candidate_id",
    "blind_token",
    "candidate_type",
    "denominator_class",
    "public_label",
    "source_family",
    "source_path",
    "source_record_id",
    "source_outcome",
    "source_route_digest",
    "observed_artifact_refs",
    "observed_artifact_ref_class",
    "qualifying_artifact_present",
    "artifact_readiness_state",
    "blind_packet_ready",
    "artifact_requirements",
    "identity_minimization_plan",
    "matched_control_id",
    "acquisition",
    "review_state",
    "privacy",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {"const": "counter-selector-artifact-readiness@1"},
    "program_id": {"const": "counter-selector-v1"},
    "wave_id": {"const": "CS-W02-W02"},
    "candidate_id": {"type": "string", "pattern": "^CS-C[0-9]{4,}$"},
    "blind_token": {"type": "string", "pattern": "^CS-BP[0-9]{4,}$"},
    "candidate_type": {"type": "string", "minLength": 3},
    "denominator_class": {
      "enum": [
        "positive_candidate_operators",
        "false_positive_outsider_genius_candidates",
        "ordinary_specialists",
        "high_status_selected_operators",
        "repair_capable_partnerships",
        "brittle_or_failed_partnerships"
      ]
    },
    "public_label": {"type": "string", "minLength": 8},
    "source_family": {"const": "K0"},
    "source_path": {"type": "string", "pattern": "^data/research/k0-role-neutral-wave-[0-9]{2}\\.json$"},
    "source_record_id": {"type": "string", "pattern": "^K0-W[0-9]{2}-R[0-9]{3}$"},
    "source_outcome": {"type": "string", "minLength": 3},
    "source_route_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^K0-W[0-9]{2}-R[0-9]{3}$"}
    },
    "observed_artifact_ref_class": {"const": "source_route_identifier_only"},
    "qualifying_artifact_present": {"const": false},
    "artifact_readiness_state": {
      "enum": [
        "source_route_only_requires_artifact_acquisition",
        "control_fixture_only_requires_underlying_record",
        "policy_or_correction_architecture_only_requires_observed_use",
        "artifact_ready_for_blind_packet",
        "privacy_or_consent_blocked",
        "bounded_non_link"
      ]
    },
    "blind_packet_ready": {"const": false},
    "artifact_requirements": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "identity_minimization_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remove_before_blind_review", "retain_for_review", "blind_packet_created"],
      "properties": {
        "remove_before_blind_review": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "retain_for_review": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "blind_packet_created": {"const": false}
      }
    },
    "matched_control_id": {"type": "string", "pattern": "^CS-C[0-9]{4,}$"},
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "batch_ordinal", "required_before_blind_review", "next_action"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^CS-AQ-B0[1-5]$"},
        "batch_ordinal": {"type": "integer", "minimum": 1, "maximum": 5},
        "required_before_blind_review": {"const": true},
        "next_action": {"type": "string", "minLength": 20}
      }
    },
    "review_state": {"const": "artifact_acquisition_required"},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_evidence_used", "public_identity_release_authorized", "consent_required_before_field_test"],
      "properties": {
        "private_evidence_used": {"const": false},
        "public_identity_release_authorized": {"const": false},
        "consent_required_before_field_test": {"const": true}
      }
    },
    "graph_effect": {"const": "none"}
  }
}
