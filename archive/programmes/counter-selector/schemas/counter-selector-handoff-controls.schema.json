{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-handoff-controls.schema.json",
  "title": "Counter-Selector public handoff positive controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "parent_wave_id",
    "as_of",
    "observed_at",
    "title",
    "status",
    "purpose",
    "counts",
    "handoff_contract",
    "controls",
    "boundaries",
    "next_action",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-handoff-controls@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W30-HC-01"
    },
    "parent_wave_id": {
      "const": "CS-W29-RA-01"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "two_public_authority_transfers_observed_zero_complete_state_handoffs_zero_operator_findings"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_controls_audited",
        "public_source_records",
        "named_outgoing_entities",
        "named_incoming_entities",
        "selecting_or_authorizing_bodies",
        "authority_transfer_events",
        "credential_or_key_rotations",
        "successor_action_chains",
        "function_custody_refinements",
        "complete_outgoing_state_packages",
        "recipient_acknowledged_state_packages",
        "open_decision_inventories",
        "rollback_or_safe_decline_packages",
        "complete_direct_handoffs",
        "person_dimension_supports_added",
        "valid_resource_normalized_comparators",
        "external_independent_reviews",
        "complete_operator_findings",
        "field_test_eligible_candidates",
        "contacts_authorized",
        "bounded_collaborations_authorized",
        "promotions",
        "person_rankings",
        "public_identity_profiles",
        "graph_effects",
        "adversarial_mutations"
      ],
      "properties": {
        "handoff_controls_audited": {
          "type": "integer",
          "minimum": 0
        },
        "public_source_records": {
          "type": "integer",
          "minimum": 0
        },
        "named_outgoing_entities": {
          "type": "integer",
          "minimum": 0
        },
        "named_incoming_entities": {
          "type": "integer",
          "minimum": 0
        },
        "selecting_or_authorizing_bodies": {
          "type": "integer",
          "minimum": 0
        },
        "authority_transfer_events": {
          "type": "integer",
          "minimum": 0
        },
        "credential_or_key_rotations": {
          "type": "integer",
          "minimum": 0
        },
        "successor_action_chains": {
          "type": "integer",
          "minimum": 0
        },
        "function_custody_refinements": {
          "type": "integer",
          "minimum": 0
        },
        "complete_outgoing_state_packages": {
          "type": "integer",
          "minimum": 0
        },
        "recipient_acknowledged_state_packages": {
          "type": "integer",
          "minimum": 0
        },
        "open_decision_inventories": {
          "type": "integer",
          "minimum": 0
        },
        "rollback_or_safe_decline_packages": {
          "type": "integer",
          "minimum": 0
        },
        "complete_direct_handoffs": {
          "type": "integer",
          "minimum": 0
        },
        "person_dimension_supports_added": {
          "type": "integer",
          "minimum": 0
        },
        "valid_resource_normalized_comparators": {
          "type": "integer",
          "minimum": 0
        },
        "external_independent_reviews": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "handoff_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_order",
        "complete_direct_handoff_requires",
        "contact_required",
        "positive_control_is_promotion"
      ],
      "properties": {
        "component_order": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "complete_direct_handoff_requires": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "contact_required": {
          "const": false
        },
        "positive_control_is_promotion": {
          "const": false
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "public_label",
          "transition_type",
          "outgoing_entity",
          "incoming_entities",
          "authorizing_body",
          "source_records",
          "components",
          "adjudication",
          "counterevidence",
          "falsifiers",
          "operator_finding",
          "field_test_eligible",
          "contact_authorized",
          "graph_effect"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^CS-W30-HC-0[12]$"
          },
          "public_label": {
            "type": "string"
          },
          "transition_type": {
            "type": "string"
          },
          "outgoing_entity": {
            "type": "string"
          },
          "incoming_entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "authorizing_body": {
            "type": "string"
          },
          "source_records": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "title",
                "publisher",
                "date",
                "url",
                "source_class",
                "artifact_scope"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^CS-W30-S(0[1-9]|1[0-3])$"
                },
                "title": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "source_class": {
                  "type": "string"
                },
                "artifact_scope": {
                  "type": "string"
                }
              }
            }
          },
          "components": {
            "type": "object",
            "minProperties": 9,
            "additionalProperties": {
              "type": "string"
            }
          },
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_transfer",
              "direct_state_handoff",
              "person_custody_support_added",
              "function_refinement",
              "classification"
            ],
            "properties": {
              "authority_transfer": {
                "const": "bounded_positive"
              },
              "direct_state_handoff": {
                "const": "not_established"
              },
              "person_custody_support_added": {
                "const": false
              },
              "function_refinement": {
                "type": "string"
              },
              "classification": {
                "type": "string"
              }
            }
          },
          "counterevidence": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          },
          "falsifiers": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "operator_finding": {
            "const": false
          },
          "field_test_eligible": {
            "const": false
          },
          "contact_authorized": {
            "const": false
          },
          "graph_effect": {
            "const": "none"
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_change_is_complete_state_handoff",
        "vote_is_credential_transfer",
        "current_title_is_recipient_acknowledgment",
        "key_rotation_is_knowledge_transfer",
        "successor_action_is_predecessor_handoff",
        "continuous_operation_is_complete_custody",
        "transition_plan_is_completed_transition",
        "manual_fallback_is_equivalent_automation",
        "positive_control_is_candidate_promotion",
        "function_refinement_is_person_support",
        "same_system_adjudication_is_external_review",
        "living_person_is_contact_authorization",
        "field_test_authorized",
        "promotion_authorized",
        "person_ranking_authorized",
        "public_identity_profile_authorized",
        "graph_effect"
      ],
      "properties": {
        "role_change_is_complete_state_handoff": {
          "const": false
        },
        "vote_is_credential_transfer": {
          "const": false
        },
        "current_title_is_recipient_acknowledgment": {
          "const": false
        },
        "key_rotation_is_knowledge_transfer": {
          "const": false
        },
        "successor_action_is_predecessor_handoff": {
          "const": false
        },
        "continuous_operation_is_complete_custody": {
          "const": false
        },
        "transition_plan_is_completed_transition": {
          "const": false
        },
        "manual_fallback_is_equivalent_automation": {
          "const": false
        },
        "positive_control_is_candidate_promotion": {
          "const": false
        },
        "function_refinement_is_person_support": {
          "const": false
        },
        "same_system_adjudication_is_external_review": {
          "const": false
        },
        "living_person_is_contact_authorization": {
          "const": false
        },
        "field_test_authorized": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "person_ranking_authorized": {
          "const": false
        },
        "public_identity_profile_authorized": {
          "const": false
        },
        "graph_effect": {
          "const": "none"
        }
      }
    },
    "next_action": {
      "type": "string"
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
