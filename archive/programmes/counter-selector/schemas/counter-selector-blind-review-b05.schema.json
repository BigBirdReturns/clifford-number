{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-blind-review-b05.schema.json",
  "title": "Counter-Selector Batch 05 blind review contract",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "batch_id",
    "parent_wave_id",
    "parent_release_sha256",
    "as_of",
    "title",
    "status",
    "expected_counts",
    "independence",
    "records",
    "disagreements",
    "boundaries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "counter-selector-wave-14-blind-review@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W14-B05"
    },
    "batch_id": {
      "const": "CS-AQ-B05"
    },
    "parent_wave_id": {
      "type": "string"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "protocol_frozen_execution_by_deterministic_builder"
    },
    "expected_counts": {
      "type": "object"
    },
    "independence": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "packet_id",
          "blind_token",
          "packet_kind",
          "review_authority",
          "historical_class",
          "review_passes",
          "dimension_vector",
          "synthesis",
          "disposition",
          "analysis_class_recommendation",
          "new_bounded_dimension_supports",
          "field_test_eligible",
          "operator_finding",
          "person_or_partnership_finding",
          "graph_effect"
        ]
      }
    },
    "disagreements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "boundaries": {
      "type": "object"
    }
  }
}
