{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-resumability-audit.schema.json",
  "title": "Counter-Selector public resumability and authority-key audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "parent_wave_ids",
    "as_of",
    "observed_at",
    "title",
    "status",
    "purpose",
    "counts",
    "audit_contract",
    "lanes",
    "disagreements",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-resumability-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W29-RA-01"
    },
    "parent_wave_ids": {
      "type": "array",
      "const": [
        "CS-W27-BA-01",
        "CS-W28-BB-01"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "four_lanes_resumability_stressed_zero_person_handoffs_one_collective_continuation_zero_operator_findings"
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lanes_audited",
        "public_source_records",
        "public_reproduction_surfaces",
        "independent_verification_surfaces",
        "founder_independent_collective_continuation_surfaces",
        "authority_concentration_findings",
        "partial_or_negative_resumability_findings",
        "function_custody_refinements",
        "person_dimension_supports_added",
        "direct_person_handoff_receipts",
        "observed_person_successor_releases",
        "independently_resumable_project_findings",
        "valid_resource_normalized_comparators",
        "external_independent_reviews",
        "complete_operator_findings",
        "field_test_eligible_candidates",
        "contacts_authorized",
        "bounded_collaborations_authorized",
        "promotions",
        "person_rankings",
        "public_identity_profiles",
        "graph_effects",
        "adversarial_mutations"
      ],
      "properties": {
        "lanes_audited": {
          "type": "integer",
          "minimum": 0
        },
        "public_source_records": {
          "type": "integer",
          "minimum": 0
        },
        "public_reproduction_surfaces": {
          "type": "integer",
          "minimum": 0
        },
        "independent_verification_surfaces": {
          "type": "integer",
          "minimum": 0
        },
        "founder_independent_collective_continuation_surfaces": {
          "type": "integer",
          "minimum": 0
        },
        "authority_concentration_findings": {
          "type": "integer",
          "minimum": 0
        },
        "partial_or_negative_resumability_findings": {
          "type": "integer",
          "minimum": 0
        },
        "function_custody_refinements": {
          "type": "integer",
          "minimum": 0
        },
        "person_dimension_supports_added": {
          "type": "integer",
          "minimum": 0
        },
        "direct_person_handoff_receipts": {
          "type": "integer",
          "minimum": 0
        },
        "observed_person_successor_releases": {
          "type": "integer",
          "minimum": 0
        },
        "independently_resumable_project_findings": {
          "type": "integer",
          "minimum": 0
        },
        "valid_resource_normalized_comparators": {
          "type": "integer",
          "minimum": 0
        },
        "external_independent_reviews": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "audit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_reproduction_requires",
        "independent_resumability_requires",
        "direct_handoff_requires",
        "contact_required"
      ],
      "properties": {
        "public_reproduction_requires": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "independent_resumability_requires": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "direct_handoff_requires": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "contact_required": {
          "const": false
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "source_packet_id",
          "subject_type",
          "source_identity",
          "public_label",
          "source_records",
          "tested_claims",
          "findings",
          "counterevidence",
          "dimension_effects",
          "disposition",
          "next_receipts"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "pattern": "^CS-W29-L0[1-4]$"
          },
          "source_packet_id": {
            "type": "string"
          },
          "subject_type": {
            "type": "string"
          },
          "source_identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_label": {
            "type": "string"
          },
          "retained_person_supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retained_function_supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_records": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "title",
                "publisher",
                "date",
                "url",
                "source_class",
                "artifact_scope"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^CS-W29-S\\d{2}$"
                },
                "title": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "source_class": {
                  "type": "string"
                },
                "artifact_scope": {
                  "type": "string"
                }
              }
            }
          },
          "tested_claims": {
            "type": "object",
            "required": [
              "public_reproduction",
              "independent_verification",
              "independent_resumability",
              "observed_succession",
              "direct_handoff",
              "authority_concentration"
            ]
          },
          "findings": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "counterevidence": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "dimension_effects": {
            "type": "object",
            "required": [
              "person_supports_added",
              "function_refinements",
              "person_custody_added"
            ]
          },
          "disposition": {
            "type": "string"
          },
          "next_receipts": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "boundaries": {
      "type": "object"
    },
    "next_action": {
      "type": "string",
      "minLength": 40
    }
  }
}
