{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-blind-review-b03.schema.json",
  "title": "Counter-Selector Batch 03 blind review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "batch_id",
    "parent_wave_id",
    "parent_release_sha256",
    "as_of",
    "title",
    "status",
    "purpose",
    "expected_counts",
    "independence",
    "packet_results",
    "disagreements",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-wave-10-program@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W10-B03"
    },
    "batch_id": {
      "const": "CS-AQ-B03"
    },
    "parent_wave_id": {
      "const": "CS-W09-B03"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "protocol_frozen_execution_by_deterministic_builder"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "expected_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "packet_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "packet_id",
          "blind_token",
          "packet_kind",
          "review_authority",
          "historical_class",
          "review_passes",
          "dimension_vector",
          "synthesis",
          "disposition",
          "analysis_class_recommendation",
          "new_bounded_dimension_supports",
          "field_test_eligible",
          "operator_finding",
          "person_or_partnership_finding",
          "graph_effect"
        ],
        "properties": {
          "packet_id": {
            "type": "string"
          },
          "blind_token": {
            "type": "string"
          },
          "packet_kind": {
            "enum": [
              "operator_artifact_packet",
              "system_failure_packet"
            ]
          },
          "review_authority": {
            "type": "string"
          },
          "historical_class": {
            "type": "string"
          },
          "review_passes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "dimension_vector": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8
          },
          "mechanism_observations": {},
          "synthesis": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "analysis_class_recommendation": {
            "type": "object"
          },
          "new_bounded_dimension_supports": {
            "type": "integer",
            "minimum": 0
          },
          "field_test_eligible": {
            "const": false
          },
          "operator_finding": {
            "const": false
          },
          "person_or_partnership_finding": {
            "const": false
          },
          "graph_effect": {
            "const": "none"
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "boundaries": {
      "type": "object"
    }
  }
}
