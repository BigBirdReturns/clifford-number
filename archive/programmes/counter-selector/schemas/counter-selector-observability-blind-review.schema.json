{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-observability-blind-review.schema.json",
  "title": "Counter-Selector observability blind review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "parent_wave_id",
    "parent_release_sha256",
    "as_of",
    "observed_at",
    "title",
    "status",
    "purpose",
    "counts",
    "review_independence",
    "review_input_contract",
    "packets",
    "disagreements",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-observability-blind-review@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W27-BA-01"
    },
    "parent_wave_id": {
      "const": "CS-W26-OP-01"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "batch_a_two_pass_review_completed_five_person_supports_one_function_support_zero_operator_findings"
    },
    "purpose": {
      "type": "string",
      "minLength": 80
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_packets_audited",
        "public_source_records",
        "identity_minimized_packets_created",
        "identity_minimized_packets_reviewed",
        "procedurally_separated_review_passes",
        "external_independent_reviews",
        "support_ledgers_completed",
        "packets_with_person_bounded_support",
        "person_bounded_dimension_supports",
        "function_bounded_dimension_supports",
        "disagreements_preserved",
        "direct_handoff_receipts",
        "valid_resource_normalized_comparators",
        "complete_operator_findings",
        "field_test_eligible_candidates",
        "contacts_authorized",
        "bounded_collaborations_authorized",
        "promotions",
        "person_rankings",
        "public_identity_profiles",
        "graph_effects",
        "adversarial_mutations"
      ],
      "properties": {
        "source_packets_audited": {
          "type": "integer",
          "minimum": 0
        },
        "public_source_records": {
          "type": "integer",
          "minimum": 0
        },
        "identity_minimized_packets_created": {
          "type": "integer",
          "minimum": 0
        },
        "identity_minimized_packets_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "procedurally_separated_review_passes": {
          "type": "integer",
          "minimum": 0
        },
        "external_independent_reviews": {
          "type": "integer",
          "minimum": 0
        },
        "support_ledgers_completed": {
          "type": "integer",
          "minimum": 0
        },
        "packets_with_person_bounded_support": {
          "type": "integer",
          "minimum": 0
        },
        "person_bounded_dimension_supports": {
          "type": "integer",
          "minimum": 0
        },
        "function_bounded_dimension_supports": {
          "type": "integer",
          "minimum": 0
        },
        "disagreements_preserved": {
          "type": "integer",
          "minimum": 0
        },
        "direct_handoff_receipts": {
          "type": "integer",
          "minimum": 0
        },
        "valid_resource_normalized_comparators": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_labels_removed",
        "identity_blindness_claimed",
        "artifact_inferability",
        "procedural_separation_claimed",
        "fresh_context_claimed",
        "external_human_independence_claimed",
        "different_model_or_institution_claimed",
        "same_system_limitation_preserved",
        "private_identity_map_available_during_passes"
      ],
      "properties": {
        "identity_labels_removed": {
          "type": "boolean"
        },
        "identity_blindness_claimed": {
          "type": "boolean"
        },
        "artifact_inferability": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "procedural_separation_claimed": {
          "type": "boolean"
        },
        "fresh_context_claimed": {
          "type": "boolean"
        },
        "external_human_independence_claimed": {
          "type": "boolean"
        },
        "different_model_or_institution_claimed": {
          "type": "boolean"
        },
        "same_system_limitation_preserved": {
          "type": "boolean"
        },
        "private_identity_map_available_during_passes": {
          "type": "boolean"
        }
      }
    },
    "review_input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_fields",
        "prohibited_cues"
      ],
      "properties": {
        "allowed_fields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "prohibited_cues": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "source_packet_id",
          "review_packet_id",
          "blind_token",
          "source_identity",
          "public_label",
          "candidate_type",
          "source_records",
          "blind_packet",
          "support_ledger",
          "review_passes",
          "dimension_vector",
          "person_bounded_supports",
          "function_bounded_supports",
          "synthesis",
          "disposition",
          "field_test_eligible",
          "operator_finding",
          "contact_authorized",
          "graph_effect"
        ],
        "properties": {
          "source_packet_id": {
            "type": "string"
          },
          "review_packet_id": {
            "type": "string"
          },
          "blind_token": {
            "type": "string"
          },
          "source_identity": {
            "type": "string",
            "minLength": 1
          },
          "public_label": {
            "type": "string",
            "minLength": 10
          },
          "candidate_type": {
            "const": "person_attributable_living_operator"
          },
          "source_records": {
            "type": "array",
            "minItems": 6,
            "items": {
              "$ref": "#/$defs/sourceRecord"
            }
          },
          "blind_packet": {
            "$ref": "#/$defs/blindPacket"
          },
          "support_ledger": {
            "$ref": "#/$defs/supportLedger"
          },
          "review_passes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object"
            }
          },
          "dimension_vector": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8
          },
          "person_bounded_supports": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "function_bounded_supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "synthesis": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "field_test_eligible": {
            "const": false
          },
          "operator_finding": {
            "const": false
          },
          "contact_authorized": {
            "const": false
          },
          "graph_effect": {
            "const": "none"
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "boundaries": {
      "type": "object",
      "minProperties": 25
    },
    "next_action": {
      "type": "string",
      "minLength": 80
    }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "date",
        "url",
        "source_class",
        "artifact_scope"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^CS-W27-S[0-9]{2}$"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_class": {
          "type": "string"
        },
        "artifact_scope": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "blindPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "blind_token",
        "review_authority",
        "task",
        "requirements",
        "bounded_chronology",
        "observable_transition",
        "support_context",
        "counterevidence",
        "falsifier"
      ],
      "properties": {
        "packet_id": {
          "type": "string"
        },
        "blind_token": {
          "type": "string"
        },
        "review_authority": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "minLength": 50
        },
        "requirements": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "bounded_chronology": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "observable_transition": {
          "type": "object"
        },
        "support_context": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "counterevidence": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "falsifier": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "supportLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "complete_for_current_public_surface",
        "valid_resource_normalized_comparator",
        "support_elements",
        "missing_normalization",
        "support_adjusted_surplus_supported"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "complete_for_current_public_surface": {
          "const": true
        },
        "valid_resource_normalized_comparator": {
          "const": false
        },
        "support_elements": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "missing_normalization": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "support_adjusted_surplus_supported": {
          "const": false
        }
      }
    }
  }
}
