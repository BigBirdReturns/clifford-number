{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-observability-batch-b-review.schema.json",
  "title": "Counter-Selector Wave 28 Batch B blind review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "parent_wave_id",
    "parent_release_sha256",
    "sibling_wave_id",
    "sibling_release_sha256",
    "as_of",
    "observed_at",
    "title",
    "status",
    "purpose",
    "counts",
    "review_independence",
    "review_input_contract",
    "packets",
    "disagreements",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-observability-batch-b-blind-review@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W28-BB-01"
    },
    "parent_wave_id": {
      "const": "CS-W26-OP-01"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sibling_wave_id": {
      "const": "CS-W27-BA-01"
    },
    "sibling_release_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "batch_b_two_pass_review_completed_three_person_supports_eight_function_supports_zero_operator_findings"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_packets_audited",
        "public_source_records",
        "identity_minimized_packets_created",
        "identity_minimized_packets_reviewed",
        "procedurally_separated_review_passes",
        "external_independent_reviews",
        "support_ledgers_completed",
        "packets_with_person_bounded_support",
        "person_bounded_dimension_supports",
        "packets_with_function_bounded_support",
        "function_bounded_dimension_supports",
        "disagreements_preserved",
        "direct_handoff_receipts",
        "observed_project_successions",
        "valid_resource_normalized_comparators",
        "complete_operator_findings",
        "field_test_eligible_candidates",
        "contacts_authorized",
        "bounded_collaborations_authorized",
        "promotions",
        "person_rankings",
        "public_identity_profiles",
        "graph_effects",
        "adversarial_mutations"
      ],
      "properties": {
        "source_packets_audited": {
          "type": "integer",
          "minimum": 0
        },
        "public_source_records": {
          "type": "integer",
          "minimum": 0
        },
        "identity_minimized_packets_created": {
          "type": "integer",
          "minimum": 0
        },
        "identity_minimized_packets_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "procedurally_separated_review_passes": {
          "type": "integer",
          "minimum": 0
        },
        "external_independent_reviews": {
          "type": "integer",
          "minimum": 0
        },
        "support_ledgers_completed": {
          "type": "integer",
          "minimum": 0
        },
        "packets_with_person_bounded_support": {
          "type": "integer",
          "minimum": 0
        },
        "person_bounded_dimension_supports": {
          "type": "integer",
          "minimum": 0
        },
        "packets_with_function_bounded_support": {
          "type": "integer",
          "minimum": 0
        },
        "function_bounded_dimension_supports": {
          "type": "integer",
          "minimum": 0
        },
        "disagreements_preserved": {
          "type": "integer",
          "minimum": 0
        },
        "direct_handoff_receipts": {
          "type": "integer",
          "minimum": 0
        },
        "observed_project_successions": {
          "type": "integer",
          "minimum": 0
        },
        "valid_resource_normalized_comparators": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "review_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_labels_removed",
        "identity_blindness_claimed",
        "artifact_inferability",
        "procedural_separation_claimed",
        "fresh_context_claimed",
        "external_human_independence_claimed",
        "different_model_or_institution_claimed",
        "same_system_limitation_preserved",
        "private_identity_map_available_during_passes"
      ],
      "properties": {
        "identity_labels_removed": {
          "const": true
        },
        "identity_blindness_claimed": {
          "const": false
        },
        "artifact_inferability": {
          "const": "high"
        },
        "procedural_separation_claimed": {
          "const": true
        },
        "fresh_context_claimed": {
          "const": true
        },
        "external_human_independence_claimed": {
          "const": false
        },
        "different_model_or_institution_claimed": {
          "const": false
        },
        "same_system_limitation_preserved": {
          "const": true
        },
        "private_identity_map_available_during_passes": {
          "const": false
        }
      }
    },
    "review_input_contract": {
      "type": "object"
    },
    "packets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "source_packet_id",
          "review_packet_id",
          "blind_token",
          "source_identity",
          "public_label",
          "candidate_type",
          "source_records",
          "blind_packet",
          "support_ledger",
          "review_passes",
          "dimension_vector",
          "person_bounded_supports",
          "function_bounded_supports",
          "synthesis",
          "disposition",
          "field_test_eligible",
          "operator_finding",
          "contact_authorized",
          "graph_effect"
        ],
        "properties": {
          "source_packet_id": {
            "type": "string"
          },
          "review_packet_id": {
            "type": "string"
          },
          "blind_token": {
            "type": "string"
          },
          "source_identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_label": {
            "type": "string"
          },
          "candidate_type": {
            "enum": [
              "collective_custody_system",
              "person_attributable_living_operator"
            ]
          },
          "source_records": {
            "type": "array",
            "minItems": 5
          },
          "blind_packet": {
            "type": "object"
          },
          "support_ledger": {
            "type": "object"
          },
          "review_passes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "dimension_vector": {
            "type": "object",
            "minProperties": 8,
            "maxProperties": 8
          },
          "person_bounded_supports": {
            "type": "array"
          },
          "function_bounded_supports": {
            "type": "array"
          },
          "synthesis": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "field_test_eligible": {
            "const": false
          },
          "operator_finding": {
            "const": false
          },
          "contact_authorized": {
            "const": false
          },
          "graph_effect": {
            "const": "none"
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "boundaries": {
      "type": "object"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
