{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-repair-continuation.schema.json",
  "title": "Counter-Selector repair-continuation audit",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_release_sha256",
    "counts",
    "person_updates",
    "identity_block_updates",
    "external_review_exports",
    "sources",
    "acquisition_lanes",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-repair-continuation-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W18-RC-01"
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object"
    },
    "person_updates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "identity_block_updates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "external_review_exports": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "sources": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "acquisition_lanes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
