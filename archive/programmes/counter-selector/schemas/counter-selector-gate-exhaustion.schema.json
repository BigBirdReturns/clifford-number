{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-gate-exhaustion.schema.json",
  "title": "Counter-Selector remaining-gate exhaustion audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "title",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_wave_id",
    "parent_release_sha256",
    "purpose",
    "counts",
    "candidate_gate_state",
    "contemporaneous_corroboration",
    "model_elasticity_tests",
    "support_adjusted_surplus_adjudication",
    "direct_handoff_adjudication",
    "archive_request_packets",
    "external_review",
    "sources",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-gate-exhaustion-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W21-GE-01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "minLength": 20
    },
    "publication_status": {
      "const": "staged_public_review_request_source_custody"
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_wave_id": {
      "const": "CS-W20-EF-01"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 100
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_lanes_audited",
        "gate_families_attacked",
        "official_or_contemporaneous_source_records",
        "contemporaneous_corroboration_records",
        "person_causality_upgrades",
        "model_elasticity_indicators_tested",
        "new_model_elasticity_supports",
        "support_comparator_lanes_tested",
        "new_support_adjusted_surplus_supports",
        "direct_handoff_routes_tested",
        "direct_handoff_receipts",
        "archive_request_packets_prepared",
        "archive_requests_sent",
        "external_review_requests_opened",
        "external_review_responses_received",
        "external_selector_reviews_executed",
        "new_dimension_supports",
        "complete_operator_findings",
        "field_test_eligible_candidates",
        "source_subject_contacts_authorized",
        "custodian_contacts_authorized",
        "bounded_collaborations_authorized",
        "promotions",
        "person_rankings",
        "public_identity_profiles",
        "graph_effects",
        "adversarial_mutations"
      ],
      "properties": {
        "candidate_lanes_audited": {
          "type": "integer",
          "minimum": 0
        },
        "gate_families_attacked": {
          "type": "integer",
          "minimum": 0
        },
        "official_or_contemporaneous_source_records": {
          "type": "integer",
          "minimum": 0
        },
        "contemporaneous_corroboration_records": {
          "type": "integer",
          "minimum": 0
        },
        "person_causality_upgrades": {
          "type": "integer",
          "minimum": 0
        },
        "model_elasticity_indicators_tested": {
          "type": "integer",
          "minimum": 0
        },
        "new_model_elasticity_supports": {
          "type": "integer",
          "minimum": 0
        },
        "support_comparator_lanes_tested": {
          "type": "integer",
          "minimum": 0
        },
        "new_support_adjusted_surplus_supports": {
          "type": "integer",
          "minimum": 0
        },
        "direct_handoff_routes_tested": {
          "type": "integer",
          "minimum": 0
        },
        "direct_handoff_receipts": {
          "type": "integer",
          "minimum": 0
        },
        "archive_request_packets_prepared": {
          "type": "integer",
          "minimum": 0
        },
        "archive_requests_sent": {
          "type": "integer",
          "minimum": 0
        },
        "external_review_requests_opened": {
          "type": "integer",
          "minimum": 0
        },
        "external_review_responses_received": {
          "type": "integer",
          "minimum": 0
        },
        "external_selector_reviews_executed": {
          "type": "integer",
          "minimum": 0
        },
        "new_dimension_supports": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "source_subject_contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "custodian_contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidate_gate_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "packet_id",
        "source_identity",
        "artifact_scope",
        "previous_supported_dimensions",
        "previous_unresolved_dimensions",
        "gate_results",
        "supported_dimensions_after_exhaustion",
        "unresolved_dimensions_after_exhaustion",
        "complete_operator_finding",
        "field_test_eligible",
        "contact_authorized",
        "public_identity_profile_authorized",
        "graph_effect"
      ],
      "properties": {
        "candidate_id": {
          "const": "CS-C0019"
        },
        "packet_id": {
          "const": "CS-BLIND-0019"
        },
        "source_identity": {
          "const": "Elliot Richardson"
        },
        "artifact_scope": {
          "type": "string",
          "minLength": 20
        },
        "previous_supported_dimensions": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "previous_unresolved_dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gate_results": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/gateResult"
          }
        },
        "supported_dimensions_after_exhaustion": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unresolved_dimensions_after_exhaustion": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "complete_operator_finding": {
          "const": false
        },
        "field_test_eligible": {
          "const": false
        },
        "contact_authorized": {
          "const": false
        },
        "public_identity_profile_authorized": {
          "const": false
        },
        "graph_effect": {
          "const": "none"
        }
      }
    },
    "contemporaneous_corroboration": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/corroboration"
      }
    },
    "model_elasticity_tests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/modelTest"
      }
    },
    "support_adjusted_surplus_adjudication": {
      "type": "object"
    },
    "direct_handoff_adjudication": {
      "type": "object"
    },
    "archive_request_packets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/archiveRequest"
      }
    },
    "external_review": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 100
    },
    "boundaries": {
      "type": "object",
      "minProperties": 20
    }
  },
  "$defs": {
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "state",
        "basis",
        "source_ids",
        "cleared"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 5
        },
        "state": {
          "type": "string",
          "minLength": 5
        },
        "basis": {
          "type": "string",
          "minLength": 50
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CS-W21-S[0-9]{3}$"
          }
        },
        "cleared": {
          "const": false
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corroboration_id",
        "claim_surface",
        "finding",
        "source_ids",
        "person_causality_upgraded",
        "ceiling"
      ],
      "properties": {
        "corroboration_id": {
          "type": "string",
          "pattern": "^CS-W21-C[0-9]{3}$"
        },
        "claim_surface": {
          "type": "string"
        },
        "finding": {
          "type": "string",
          "minLength": 40
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "person_causality_upgraded": {
          "const": false
        },
        "ceiling": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "modelTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "indicator",
        "classification",
        "supported",
        "missing_sequence",
        "source_ids"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^CS-W21-ME[0-9]{3}$"
        },
        "indicator": {
          "type": "string",
          "minLength": 40
        },
        "classification": {
          "type": "string",
          "minLength": 20
        },
        "supported": {
          "const": false
        },
        "missing_sequence": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "archiveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "custodian",
        "contact",
        "document_path",
        "target_collections",
        "state",
        "route_executed",
        "contact_authorized",
        "source_ids"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^CS-W21-AQ-"
        },
        "custodian": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "document_path": {
          "type": "string",
          "pattern": "^docs/requests/"
        },
        "target_collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "state": {
          "const": "prepared_not_sent"
        },
        "route_executed": {
          "const": false
        },
        "contact_authorized": {
          "const": false
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "source_class",
        "record_state",
        "supports",
        "limits"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^CS-W21-S[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_class": {
          "type": "string",
          "minLength": 5
        },
        "record_state": {
          "type": "string",
          "minLength": 10
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
