{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-exception-falsification.schema.json",
  "title": "Counter-Selector exception falsification audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "title",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_wave_id",
    "parent_release_sha256",
    "purpose",
    "counts",
    "candidate_audit",
    "negative_controls",
    "sources",
    "external_review_export_update",
    "acquisition_lanes",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-exception-falsification-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W20-EF-01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "minLength": 20
    },
    "publication_status": {
      "const": "staged_nonpublic_source_custody"
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_wave_id": {
      "const": "CS-W19-XD-01"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 80
    },
    "counts": {
      "type": "object",
      "minProperties": 20,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "candidate_audit": {
      "$ref": "#/$defs/candidateAudit"
    },
    "negative_controls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "external_review_export_update": {
      "$ref": "#/$defs/reviewExport"
    },
    "acquisition_lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/acquisitionLane"
      }
    },
    "boundaries": {
      "type": "object",
      "minProperties": 25,
      "additionalProperties": {
        "oneOf": [
          {
            "const": false
          },
          {
            "const": "none"
          }
        ]
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 100
    }
  },
  "$defs": {
    "candidateAudit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_id",
        "packet_id",
        "source_identity",
        "artifact_scope",
        "previous_supported_dimensions",
        "new_support_assignments",
        "supported_dimensions_after_update",
        "unresolved_dimensions",
        "team_mechanisms_not_person_support",
        "model_elasticity_adjudication",
        "support_context",
        "custody_adjudication",
        "countermodels",
        "external_review_ready",
        "complete_operator_finding",
        "field_test_eligible",
        "contact_authorized",
        "public_identity_profile_authorized",
        "graph_effect"
      ],
      "properties": {
        "candidate_id": {
          "const": "CS-C0019"
        },
        "packet_id": {
          "const": "CS-BLIND-0019"
        },
        "source_identity": {
          "const": "Elliot Richardson"
        },
        "previous_supported_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "new_support_assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object"
          }
        },
        "supported_dimensions_after_update": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unresolved_dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "team_mechanisms_not_person_support": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "external_review_ready": {
          "const": true
        },
        "complete_operator_finding": {
          "const": false
        },
        "field_test_eligible": {
          "const": false
        },
        "contact_authorized": {
          "const": false
        },
        "public_identity_profile_authorized": {
          "const": false
        },
        "graph_effect": {
          "const": "none"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "control_class",
        "finding",
        "new_dimension_supports",
        "graph_effect"
      ],
      "properties": {
        "control_id": {
          "type": "string"
        },
        "control_class": {
          "type": "string"
        },
        "finding": {
          "type": "string"
        },
        "new_dimension_supports": {
          "const": 0
        },
        "graph_effect": {
          "const": "none"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "source_class",
        "record_state",
        "supports",
        "limits",
        "acquired_on"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^CS-W20-S[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_class": {
          "type": "string"
        },
        "record_state": {
          "type": "string"
        },
        "supports": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "acquired_on": {
          "const": "2026-08-01"
        }
      }
    },
    "reviewExport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "export_id",
        "source_trace_or_candidate_id",
        "review_token",
        "identity_key",
        "artifact_scope",
        "supported_dimensions",
        "unresolved_dimensions",
        "review_questions",
        "countermodels",
        "falsifiers",
        "missing_receipts",
        "source_identity_omitted_from_export",
        "artifact_may_remain_inferable",
        "export_state",
        "external_review_executed",
        "contact_required",
        "contact_authorized",
        "field_test_authorized",
        "public_identity_profile_authorized",
        "graph_effect"
      ]
    },
    "acquisitionLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "subject",
        "required_objects",
        "known_routes",
        "route_executed",
        "contact_authorized",
        "graph_effect"
      ],
      "properties": {
        "lane_id": {
          "const": "CS-AQ-W20-RICHARDSON-NICARAGUA"
        },
        "subject": {
          "const": "Elliot Richardson"
        },
        "required_objects": {
          "type": "array",
          "minItems": 6
        },
        "known_routes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "route_executed": {
          "const": false
        },
        "contact_authorized": {
          "const": false
        },
        "graph_effect": {
          "const": "none"
        }
      }
    }
  }
}
