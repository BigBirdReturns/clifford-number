{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.axm.tools/schemas/status-sovereignty-wave-02-intake.schema.json",
  "title": "SSC-H01 Wave 02 intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "intake_id",
    "as_of",
    "status",
    "title",
    "selection_contract",
    "source_denominator_path",
    "structural_synthesis_path",
    "candidate_lane_ids",
    "counts",
    "lane_counts",
    "disposition_counts",
    "observations",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "status-sovereignty-wave-02-intake@1"
    },
    "hypothesis_id": {
      "const": "SSC-H01"
    },
    "wave_id": {
      "const": "SSC-W02"
    },
    "intake_id": {
      "const": "SSC-W02-I01"
    },
    "as_of": {
      "type": "string"
    },
    "status": {
      "const": "frozen_source_denominator_eight_candidate_packets_zero_review"
    },
    "title": {
      "type": "string"
    },
    "selection_contract": {
      "type": "object"
    },
    "source_denominator_path": {
      "type": "string"
    },
    "structural_synthesis_path": {
      "type": "string"
    },
    "candidate_lane_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "counts": {
      "type": "object"
    },
    "lane_counts": {
      "type": "object"
    },
    "disposition_counts": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "current_result": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "lane_id",
        "jurisdiction",
        "time_window",
        "protected_center",
        "affected_population_or_institution",
        "status_order_claim",
        "patriotic_or_security_frame",
        "qualified_knower_or_evidence",
        "epistemic_reclassification",
        "counterpower_function",
        "counterpower_action",
        "selector",
        "option_universe",
        "public_conversion_instrument",
        "public_contribution",
        "private_capacity_or_right",
        "conditional_incorporation",
        "counterfactual_foreclosure",
        "material_consequence",
        "correction_substitution_exit",
        "observed_facts",
        "working_interpretation",
        "alternative_explanations",
        "counterevidence",
        "source_ids",
        "disposition",
        "review_state",
        "graph_effect"
      ],
      "properties": {
        "observation_id": {},
        "lane_id": {},
        "jurisdiction": {},
        "time_window": {},
        "protected_center": {},
        "affected_population_or_institution": {},
        "status_order_claim": {},
        "patriotic_or_security_frame": {},
        "qualified_knower_or_evidence": {},
        "epistemic_reclassification": {},
        "counterpower_function": {},
        "counterpower_action": {},
        "selector": {},
        "option_universe": {},
        "public_conversion_instrument": {},
        "public_contribution": {},
        "private_capacity_or_right": {},
        "conditional_incorporation": {},
        "counterfactual_foreclosure": {},
        "material_consequence": {},
        "correction_substitution_exit": {},
        "observed_facts": {},
        "working_interpretation": {},
        "alternative_explanations": {},
        "counterevidence": {},
        "source_ids": {},
        "disposition": {
          "enum": [
            "supported_bounded_compact",
            "partial_functional_convergence",
            "heterogeneous_coalition_limited_overlap",
            "ordinary_patriotic_or_industrial_policy",
            "racial_hierarchy_unsupported",
            "capital_conversion_unsupported",
            "bounded_non_link",
            "falsified",
            "source_restricted",
            "source_unavailable",
            "requires_additional_acquisition"
          ]
        },
        "review_state": {
          "const": "unreviewed"
        },
        "graph_effect": {
          "const": "none"
        }
      }
    }
  }
}
