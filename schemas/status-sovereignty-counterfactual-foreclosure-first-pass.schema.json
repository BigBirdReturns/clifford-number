{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-counterfactual-foreclosure-first-pass.schema.json",
  "title": "SSC-F13 counterfactual-foreclosure first pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "sources",
    "chronology",
    "first_pass_findings",
    "open_denominators",
    "candidate_terminal_states",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-counterfactual-foreclosure-first-pass@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 545 },
    "observation_id": { "const": "SSC-OBS-0021" },
    "lane_id": { "const": "SSC-F13" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "multi_architecture_and_correction_chronology_recovered_foreclosure_not_established" },
    "authority": { "const": "source_acquisition_only_not_review_or_adjudication" },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SSC-F13-DCGSA-S[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_class": { "type": "string", "minLength": 1 },
          "retrieved_facts": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "chronology": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "event": { "type": "string", "minLength": 1 }
        }
      }
    },
    "first_pass_findings": { "type": "object" },
    "open_denominators": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
    "candidate_terminal_states": { "type": "array", "minItems": 9, "items": { "type": "string", "minLength": 1 } },
    "current_result": { "type": "object" },
    "boundaries": { "type": "object" }
  }
}
