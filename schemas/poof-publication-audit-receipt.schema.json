{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-publication-audit-receipt-v1.json",
  "title": "POOF publication audit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_receipt_id",
    "release_id",
    "auditor",
    "audit_class",
    "target",
    "observed_result",
    "limitations",
    "artifacts",
    "substantive_evidence_effect",
    "canonical_write",
    "effect_contract",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-publication-audit-receipt@1"
    },
    "audit_receipt_id": {
      "type": "string",
      "pattern": "^POOF-AUD-[A-Z0-9-]{4,64}$"
    },
    "release_id": {
      "type": "string",
      "minLength": 3
    },
    "auditor": {
      "type": "string",
      "minLength": 2
    },
    "audit_class": {
      "enum": [
        "websiteiq",
        "accessibility",
        "browser",
        "machine_discovery",
        "performance",
        "security",
        "human_usability"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 3
    },
    "observed_result": {
      "type": "string",
      "minLength": 5
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "substantive_evidence_effect": {
      "const": false
    },
    "canonical_write": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    },
    "effect_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "graph",
        "review_queue",
        "publication",
        "visibility",
        "ranking",
        "custody"
      ],
      "properties": {
        "evidence": {
          "const": "none"
        },
        "graph": {
          "const": "none"
        },
        "review_queue": {
          "const": "opens_publication_repair_review"
        },
        "publication": {
          "const": "separate_decision_required"
        },
        "visibility": {
          "const": "none"
        },
        "ranking": {
          "const": "none"
        },
        "custody": {
          "const": "audit_append_only"
        }
      }
    }
  }
}
