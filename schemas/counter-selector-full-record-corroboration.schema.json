{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-full-record-corroboration.schema.json",
  "title": "Counter-Selector full-record corroboration audit",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "observed_at",
    "counts",
    "candidate_state",
    "source_records",
    "corroborations",
    "support_ledger",
    "catalogue_refinements",
    "independent_review",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-full-record-corroboration-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W23-FR-01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "observed_at": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "candidate_state": {
      "type": "object"
    },
    "source_records": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "corroborations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "support_ledger": {
      "type": "object"
    },
    "catalogue_refinements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "independent_review": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
