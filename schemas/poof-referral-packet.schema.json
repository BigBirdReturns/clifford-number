{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-referral-packet-v1.json",
  "title": "POOF referral packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "referral_id",
    "source_jurisdiction",
    "exact_proposition",
    "current_evidence_ceiling",
    "required_record_or_test",
    "lawful_acquisition_route",
    "responsible_custodian",
    "consequence_if_unresolved",
    "privacy_boundary",
    "status",
    "promotes_to",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-referral-packet@1"
    },
    "referral_id": {
      "type": "string",
      "pattern": "^POOF-REF-[A-Z0-9-]{4,64}$"
    },
    "source_jurisdiction": {
      "enum": [
        "Report",
        "Reader File",
        "Examination",
        "Estate",
        "Newsroom",
        "Publication Audit",
        "Subject Response"
      ]
    },
    "exact_proposition": {
      "type": "string",
      "minLength": 15
    },
    "current_evidence_ceiling": {
      "type": "string",
      "minLength": 8
    },
    "required_record_or_test": {
      "type": "string",
      "minLength": 8
    },
    "lawful_acquisition_route": {
      "type": "string",
      "minLength": 8
    },
    "responsible_custodian": {
      "type": "string",
      "minLength": 3
    },
    "consequence_if_unresolved": {
      "type": "string",
      "minLength": 8
    },
    "privacy_boundary": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "open",
        "source_restricted",
        "source_unavailable",
        "resolved_non_link",
        "resolved_candidate",
        "withdrawn"
      ]
    },
    "promotes_to": {
      "const": "candidate_only"
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
