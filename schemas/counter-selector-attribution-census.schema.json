{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-attribution-census.schema.json",
  "title": "Counter-Selector attribution census",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "wave_id", "as_of", "title", "status", "parent_main_sha", "parent_release_sha256", "purpose", "counts", "identity_reintroduction", "person_near_hits", "function_level_support", "mechanism_control_packet_ids", "next_action", "boundaries"],
  "properties": {
    "schema_version": {"const": "counter-selector-wave-15-attribution-census@1"},
    "program_id": {"const": "counter-selector-v1"},
    "wave_id": {"const": "CS-W15-ATTR-01"},
    "as_of": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "parent_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "parent_release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"type": "string"},
    "counts": {"type": "object"},
    "identity_reintroduction": {"type": "object"},
    "person_near_hits": {"type": "array", "minItems": 3, "maxItems": 3},
    "function_level_support": {"type": "array", "minItems": 5, "maxItems": 5},
    "mechanism_control_packet_ids": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true},
    "next_action": {"type": "string"},
    "boundaries": {"type": "object"}
  }
}
