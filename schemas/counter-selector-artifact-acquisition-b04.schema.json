{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-artifact-acquisition-b04.schema.json",
  "title": "Counter-Selector Wave 11 Batch 04 acquisition contract",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "batch_id",
    "parent_release_sha256",
    "as_of",
    "title",
    "status",
    "expected_counts",
    "records",
    "blind_packets",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-wave-11-program@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W11-B04"
    },
    "batch_id": {
      "const": "CS-AQ-B04"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "expected_counts": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "blind_packets": {
      "type": "array"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
