{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/dca-field-record-v1.json",
  "title": "Distributed Counterpower Aversion Field Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "hypothesis_id",
    "case_id",
    "domain",
    "jurisdiction",
    "protected_center",
    "bounded_gate",
    "status_prior",
    "epistemic_prior",
    "qualified_knower_or_alternative",
    "contradiction",
    "reclassification",
    "explanation_mutation",
    "option_set_effect",
    "conversion_instrument",
    "infrastructure_effect",
    "dependency_effect",
    "residual_authority_or_value",
    "correction_topology",
    "status_signal",
    "personnel_router",
    "compatible_interface",
    "selection_effect",
    "counterfactual_foreclosure",
    "alternative_explanations",
    "counterevidence",
    "matched_control",
    "falsifier",
    "source_ids",
    "confidence",
    "review_state",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {"const": "dca-field-record@1"},
    "record_id": {"type": "string", "pattern": "^DCA-R[0-9]{4,}$"},
    "hypothesis_id": {"const": "DCA-H01"},
    "case_id": {"type": "string", "minLength": 2},
    "domain": {"type": "string", "minLength": 2},
    "jurisdiction": {"type": "string", "minLength": 2},
    "protected_center": {
      "type": "object",
      "required": ["name", "authority", "scope"],
      "properties": {
        "name": {"type": "string"},
        "authority": {"type": "string"},
        "scope": {"type": "string"}
      },
      "additionalProperties": true
    },
    "bounded_gate": {
      "type": "object",
      "required": ["gate_type", "instrument", "date_window"],
      "properties": {
        "gate_type": {"type": "string"},
        "instrument": {"type": "string"},
        "date_window": {"type": "string"}
      },
      "additionalProperties": true
    },
    "status_prior": {"type": ["string", "null"]},
    "epistemic_prior": {"type": ["string", "null"]},
    "qualified_knower_or_alternative": {"type": "object"},
    "contradiction": {"type": "object"},
    "reclassification": {"type": "object"},
    "explanation_mutation": {"type": "object"},
    "option_set_effect": {"type": "object"},
    "conversion_instrument": {"type": "object"},
    "infrastructure_effect": {"type": "object"},
    "dependency_effect": {"type": "object"},
    "residual_authority_or_value": {"type": "object"},
    "correction_topology": {"type": "object"},
    "status_signal": {"type": ["object", "null"]},
    "personnel_router": {"type": ["object", "null"]},
    "compatible_interface": {"type": ["object", "null"]},
    "selection_effect": {"type": ["object", "null"]},
    "counterfactual_foreclosure": {"type": ["object", "null"]},
    "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "object"}},
    "matched_control": {"type": ["string", "null"]},
    "falsifier": {"type": "string", "minLength": 4},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"enum": ["low", "moderate", "high"]},
    "review_state": {
      "enum": [
        "candidate",
        "supported_for_field_review",
        "bounded_non_link",
        "falsified",
        "selection_unresolved",
        "source_restricted",
        "requires_named_acquisition",
        "positive_control",
        "partial_control"
      ]
    },
    "graph_effect": {"const": "none"}
  }
}
