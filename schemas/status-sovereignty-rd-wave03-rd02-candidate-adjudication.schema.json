{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clifford-number.local/schemas/status-sovereignty-rd-wave03-rd02-candidate-adjudication.schema.json",
  "title": "SSC RD-02 Wave-03 search-candidate adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "class_id",
    "issue",
    "as_of",
    "authority",
    "source_custody",
    "adjudication_contract",
    "counts",
    "shards",
    "current_result",
    "boundaries",
    "next_bounded_operation"
  ],
  "properties": {
    "schema_version": {
      "const": "ssc-rd02-wave03-search-candidate-adjudication@1"
    },
    "wave_id": {
      "const": "SSC-RD-W03"
    },
    "lane_id": {
      "const": "RD-02"
    },
    "class_id": {
      "const": "RD-02-C05"
    },
    "issue": {
      "const": 1015
    },
    "as_of": {
      "const": "2026-08-04"
    },
    "authority": {
      "const": "complete_unique_url_candidate_adjudication_and_bounded_followup_selection_not_source_admission"
    },
    "source_custody": {
      "type": "object"
    },
    "adjudication_contract": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_rows",
        "unique_candidate_urls",
        "exact_manager_site_candidates",
        "name_aligned_parent_organization_candidates",
        "official_domain_lexical_collisions",
        "nonresponsive_lexical_collisions_or_generic_results",
        "fixed_followup_routes",
        "candidate_urls_admitted",
        "lifecycle_events_observed",
        "withheld_row_candidates",
        "external_contacts",
        "external_reviews"
      ],
      "properties": {
        "candidate_rows": {
          "const": 480
        },
        "unique_candidate_urls": {
          "const": 210
        },
        "exact_manager_site_candidates": {
          "const": 1
        },
        "name_aligned_parent_organization_candidates": {
          "const": 9
        },
        "official_domain_lexical_collisions": {
          "const": 2
        },
        "nonresponsive_lexical_collisions_or_generic_results": {
          "const": 198
        },
        "fixed_followup_routes": {
          "const": 10
        },
        "candidate_urls_admitted": {
          "const": 0
        },
        "lifecycle_events_observed": {
          "const": 0
        },
        "withheld_row_candidates": {
          "const": 0
        },
        "external_contacts": {
          "const": 0
        },
        "external_reviews": {
          "const": 0
        }
      }
    },
    "current_result": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    },
    "next_bounded_operation": {
      "type": "string",
      "minLength": 1
    },
    "shards": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_ordinal",
          "path",
          "first_candidate_ordinal",
          "last_candidate_ordinal",
          "candidate_urls",
          "sha256"
        ],
        "properties": {
          "shard_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "path": {
            "type": "string",
            "pattern": "^data/intake/status-sovereignty-rd-wave03-rd02-portfolio-lifecycle/candidate-adjudication/candidates-[0-9]{3}-[0-9]{3}\\.json$"
          },
          "first_candidate_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 210
          },
          "last_candidate_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 210
          },
          "candidate_urls": {
            "const": 30
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ordinal",
        "candidate_id",
        "url",
        "domain",
        "occurrences",
        "unit_ordinals",
        "query_classes",
        "classification",
        "classification_reason",
        "followup_route_id",
        "admitted_source",
        "lifecycle_event_observed",
        "field_effect",
        "class_effect"
      ],
      "properties": {
        "candidate_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 210
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "unit_ordinals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 17
          }
        },
        "query_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "disposition",
              "portfolio",
              "recovery"
            ]
          }
        },
        "classification": {
          "enum": [
            "exact_manager_site_candidate",
            "name_aligned_parent_organization_candidate",
            "official_domain_lexical_collision",
            "nonresponsive_lexical_collision_or_generic_result"
          ]
        },
        "classification_reason": {
          "type": "string",
          "minLength": 1
        },
        "followup_route_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^RD02-W03-CF[0-9]{3}$"
            }
          ]
        },
        "admitted_source": {
          "const": false
        },
        "lifecycle_event_observed": {
          "const": false
        },
        "field_effect": {
          "const": "none"
        },
        "class_effect": {
          "const": "none"
        }
      }
    }
  }
}
