{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-rd04-snap-route-adjudication-a04.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["core", "routes", "sources", "decisions", "scores"],
  "properties": {
    "core": {"$ref": "#/$defs/core"},
    "routes": {"$ref": "#/$defs/routeLedger"},
    "sources": {"$ref": "#/$defs/sourceLedger"},
    "decisions": {"$ref": "#/$defs/decisionLedger"},
    "scores": {"$ref": "#/$defs/scoreLedger"}
  },
  "$defs": {
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "execution_id", "issue", "parent_lane_issue", "parent_wave_issue", "parent_a02_issue", "parent_a03_issue", "parent_a03_head", "as_of", "authority", "counts", "route_dispositions", "a02_reconciliation_states", "selection", "current_result", "boundaries"],
      "properties": {
        "schema_version": {"const": "ssc-rd04-a04-core@1"},
        "execution_id": {"const": "SSC-RD04-SNAP-A04"},
        "issue": {"const": 690},
        "parent_lane_issue": {"const": 620},
        "parent_wave_issue": {"const": 615},
        "parent_a02_issue": {"const": 666},
        "parent_a03_issue": {"const": 687},
        "parent_a03_head": {"const": "a516a05ee137233e93542a5e9886f0acada4f33b"},
        "as_of": {"type": "string", "pattern": "^2026-08-[0-9]{2}$"},
        "authority": {"const": "page_level_source_relevance_and_score_custody_not_review_or_adjudication"},
        "counts": {"type": "object"},
        "route_dispositions": {"type": "object"},
        "a02_reconciliation_states": {"type": "object"},
        "selection": {"type": "object"},
        "current_result": {"type": "object"},
        "boundaries": {"type": "object"}
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_url", "attempt_count", "retry_reason", "attempts", "accessible", "final_url", "final_host", "final_http_status", "final_content_type", "official_after_redirects", "page_title", "parse_state", "text_sha256"],
      "properties": {
        "requested_url": {"type": "string"},
        "attempt_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "retry_reason": {"type": ["string", "null"]},
        "attempts": {"type": "array", "minItems": 1, "maxItems": 2},
        "accessible": {"type": "boolean"},
        "final_url": {"type": ["string", "null"]},
        "final_host": {"type": ["string", "null"]},
        "final_http_status": {"type": "integer", "minimum": 0, "maximum": 599},
        "final_content_type": {"type": "string"},
        "official_after_redirects": {"type": "boolean"},
        "page_title": {"type": ["string", "null"]},
        "parse_state": {"type": ["string", "null"]},
        "text_sha256": {"type": ["string", "null"]},
        "exception": {"type": "string"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_url", "candidate_domain", "first_result_id", "queries", "query_states", "query_dimension_ceiling", "fetch", "state_scope_inferred", "host_state_hint", "page_state_mentions", "state_relevance", "official_domain_basis", "snap_program_relevance", "dimension_relevance", "supporting_passages", "limitations", "duplicate_or_alias_of", "pre_alias_disposition", "terminal_disposition", "score_eligible"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^A03C-[0-9]{3}$"},
        "candidate_url": {"type": "string"},
        "candidate_domain": {"type": ["string", "null"]},
        "first_result_id": {"type": ["string", "null"]},
        "queries": {"type": "array"},
        "query_states": {"type": "array"},
        "query_dimension_ceiling": {"type": "array"},
        "fetch": {"$ref": "#/$defs/fetch"},
        "state_scope_inferred": {"type": "array"},
        "host_state_hint": {"type": ["string", "null"]},
        "page_state_mentions": {"type": "array"},
        "state_relevance": {"enum": ["matched", "wrong_or_unrecovered"]},
        "official_domain_basis": {"enum": ["official_after_redirects", "not_official_after_redirects"]},
        "snap_program_relevance": {"type": "boolean"},
        "dimension_relevance": {"type": "array"},
        "supporting_passages": {"type": "object"},
        "limitations": {"type": "array"},
        "duplicate_or_alias_of": {"type": ["string", "null"]},
        "pre_alias_disposition": {"$ref": "#/$defs/routeDisposition"},
        "terminal_disposition": {"$ref": "#/$defs/routeDisposition"},
        "score_eligible": {"type": "boolean"}
      }
    },
    "routeDisposition": {
      "enum": ["official_relevant_support", "official_route_only_generic", "official_wrong_state", "official_wrong_program", "official_page_unavailable_after_bounded_retry", "official_binary_or_unparsed_content", "official_snap_page_no_dimension_support", "duplicate_or_redirect_alias", "not_official_after_page_review"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "publisher", "title", "state_scope", "dimensions", "support", "limitations", "replay_state", "fetch", "terminal_reconciliation", "exact_alias_to_a03_candidate", "baseline_score_preserved", "source_removal_authorized", "boundaries"],
      "properties": {
        "source_id": {"type": "string"}, "url": {"type": "string"}, "publisher": {"type": ["string", "null"]}, "title": {"type": ["string", "null"]},
        "state_scope": {}, "dimensions": {"type": "array"}, "support": {"type": ["string", "null"]}, "limitations": {"type": ["string", "null"]},
        "replay_state": {"const": "not_returned_by_frozen_replay"}, "fetch": {"$ref": "#/$defs/fetch"},
        "terminal_reconciliation": {"enum": ["exact_alias_to_a03_route", "official_page_unavailable_after_bounded_retry", "not_official_after_page_review", "official_binary_or_unparsed_content", "accessible_official_content_rechecked"]},
        "exact_alias_to_a03_candidate": {"type": ["string", "null"]}, "baseline_score_preserved": {"const": true}, "source_removal_authorized": {"const": false}, "boundaries": {"type": "object"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "state", "state_name", "dimension", "prior_score", "prior_source_ids", "new_adjudicated_candidate_ids", "removed_source_ids", "new_score", "score_change", "score_change_rationale", "review_boundary"],
      "properties": {
        "decision_id": {"type": "string"}, "state": {"type": "string"}, "state_name": {"type": "string"}, "dimension": {"pattern": "^D[1-8]$"},
        "prior_score": {"type": "integer", "minimum": 0, "maximum": 2}, "prior_source_ids": {"type": "array"}, "new_adjudicated_candidate_ids": {"type": "array"},
        "removed_source_ids": {"type": "array", "maxItems": 0}, "new_score": {"type": "integer", "minimum": 0, "maximum": 2}, "score_change": {"type": "integer", "minimum": 0, "maximum": 1},
        "score_change_rationale": {"type": "string"}, "review_boundary": {"type": "string"}
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "state_name", "prior_total", "new_total", "score_change", "dimension_scores", "dimension_evidence", "missing_dimensions", "not_full_dimensions"],
      "properties": {
        "state": {"type": "string"}, "state_name": {"type": "string"}, "prior_total": {"type": "integer"}, "new_total": {"type": "integer"}, "score_change": {"type": "integer"},
        "dimension_scores": {"type": "object"}, "dimension_evidence": {"type": "object"}, "missing_dimensions": {"type": "array"}, "not_full_dimensions": {"type": "array"}
      }
    },
    "routeLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "rows"], "properties": {"schema_version": {"const": "ssc-rd04-a04-route-ledger@1"}, "rows": {"type": "array", "minItems": 59, "maxItems": 59, "items": {"$ref": "#/$defs/route"}}}},
    "sourceLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "rows"], "properties": {"schema_version": {"const": "ssc-rd04-a04-a02-reconciliation@1"}, "rows": {"type": "array", "minItems": 53, "maxItems": 53, "items": {"$ref": "#/$defs/source"}}}},
    "decisionLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "rows"], "properties": {"schema_version": {"const": "ssc-rd04-a04-decision-matrix@1"}, "rows": {"type": "array", "minItems": 400, "maxItems": 400, "items": {"$ref": "#/$defs/decision"}}}},
    "scoreLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "rows", "selection"], "properties": {"schema_version": {"const": "ssc-rd04-a04-state-scores@1"}, "rows": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/score"}}, "selection": {"type": "object"}}}
  }
}
