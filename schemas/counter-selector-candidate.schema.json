{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-candidate-v1.json",
  "title": "Counter-Selector Candidate Intake Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "candidate_id",
    "candidate_type",
    "denominator_class",
    "public_label",
    "surface",
    "domain",
    "jurisdiction",
    "identity_status",
    "conventional_status_metadata",
    "available_support",
    "state_load",
    "observed_artifacts",
    "observed_state_transitions",
    "support_adjusted_surplus",
    "cross_domain_transfer",
    "exception_handling",
    "custody",
    "model_elasticity",
    "governed_capacity",
    "non_zero_sum_orientation",
    "epistemic_restraint",
    "dimension_evidence_ceiling",
    "status_output_residual",
    "comparators",
    "matched_control",
    "alternative_explanations",
    "counterevidence",
    "falsifier",
    "missing_receipt",
    "blind_first_review",
    "bounded_test",
    "handoff_test",
    "contradiction_test",
    "field_result",
    "source_ids",
    "source_routes",
    "review_state",
    "privacy",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-candidate@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CS-C[0-9]{4,}$"
    },
    "candidate_type": {
      "enum": [
        "operator_trace",
        "team_trace",
        "control_fixture",
        "specialist_trace",
        "institutional_specialist_trace",
        "formal_role_trace",
        "repair_trace",
        "repair_mechanism",
        "partnership_trace"
      ]
    },
    "denominator_class": {
      "enum": [
        "positive_candidate_operators",
        "false_positive_outsider_genius_candidates",
        "ordinary_specialists",
        "high_status_selected_operators",
        "repair_capable_partnerships",
        "brittle_or_failed_partnerships"
      ]
    },
    "class_role": {
      "const": "source_routed_sampling_object_not_disposition"
    },
    "public_label": {
      "type": "string",
      "minLength": 5
    },
    "surface": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string",
      "minLength": 3
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "identity_status": {
      "enum": [
        "withheld",
        "public_record_role_only",
        "consented"
      ]
    },
    "conventional_status_metadata": {
      "type": "object",
      "required": [
        "state",
        "blind_packet_created",
        "known_cues"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "available_in_source_not_used_for_promotion",
            "withheld"
          ]
        },
        "blind_packet_created": {
          "type": "boolean"
        },
        "known_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "available_support": {
      "type": "object",
      "required": [
        "state",
        "known",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_acquired",
            "partial",
            "complete"
          ]
        },
        "known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state_load": {
      "type": "object",
      "required": [
        "state",
        "known",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_acquired",
            "partial",
            "complete"
          ]
        },
        "known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observed_state_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "support_adjusted_surplus": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "cross_domain_transfer": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "exception_handling": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "custody": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "model_elasticity": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "governed_capacity": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "non_zero_sum_orientation": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "epistemic_restraint": {
      "enum": [
        "not_tested",
        "claim_only",
        "bounded_observation",
        "independently_reviewed",
        "repeated_across_distinct_events",
        "contradicted"
      ]
    },
    "dimension_evidence_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "status_output_residual": {
      "type": [
        "number",
        "null"
      ]
    },
    "comparators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CS-C[0-9]{4,}$"
      }
    },
    "matched_control": {
      "type": "object",
      "required": [
        "state",
        "candidate_id",
        "denominator_class",
        "matching_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "assigned_for_second_party_review",
            "reviewed",
            "unavailable"
          ]
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CS-C[0-9]{4,}$"
        },
        "denominator_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "matching_basis": {
          "type": "string"
        }
      }
    },
    "alternative_explanations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "counterevidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "falsifier": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "missing_receipt": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "blind_first_review": {
      "enum": [
        "not_executed",
        "in_review",
        "complete"
      ]
    },
    "bounded_test": {
      "enum": [
        "not_run",
        "planned",
        "running",
        "complete",
        "withdrawn"
      ]
    },
    "handoff_test": {
      "enum": [
        "not_run",
        "planned",
        "complete",
        "withdrawn"
      ]
    },
    "contradiction_test": {
      "enum": [
        "not_run",
        "planned",
        "complete",
        "withdrawn"
      ]
    },
    "field_result": {
      "enum": [
        "not_observed",
        "partial",
        "observed"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^K0-W[0-9]{2}-R[0-9]{3}$"
      }
    },
    "source_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "path",
          "record_id",
          "source_outcome",
          "authority_ceiling"
        ],
        "additionalProperties": false,
        "properties": {
          "family_id": {
            "const": "K0"
          },
          "path": {
            "type": "string",
            "pattern": "^data/research/k0-role-neutral-wave-[0-9]{2}\\.json$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^K0-W[0-9]{2}-R[0-9]{3}$"
          },
          "source_outcome": {
            "type": "string"
          },
          "authority_ceiling": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "review_state": {
      "enum": [
        "supported_for_bounded_field_test",
        "supported_as_repair_capable_operator",
        "supported_as_domain_limited_operator",
        "retained_candidate_only",
        "bounded_non_link",
        "false_positive_outsider_myth",
        "falsified",
        "identity_ambiguous",
        "source_restricted",
        "requires_additional_acquisition"
      ]
    },
    "privacy": {
      "type": "object",
      "required": [
        "private_evidence_used",
        "public_identity_release_authorized",
        "sensitive_data_minimized",
        "consent_required_before_bounded_collaboration",
        "candidate_withdrawal_supported"
      ],
      "additionalProperties": false,
      "properties": {
        "private_evidence_used": {
          "type": "boolean"
        },
        "public_identity_release_authorized": {
          "type": "boolean"
        },
        "sensitive_data_minimized": {
          "type": "boolean"
        },
        "consent_required_before_bounded_collaboration": {
          "type": "boolean"
        },
        "candidate_withdrawal_supported": {
          "type": "boolean"
        }
      }
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
