{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-comprehension-receipt-v1.json",
  "title": "POOF comprehension receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at",
    "participant_class",
    "operations",
    "transfer_case",
    "result",
    "interpretation_contract",
    "canonical_write",
    "effect_contract",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-comprehension-receipt@1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^POOF-COMP-[A-Z0-9-]{4,64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "participant_class": {
      "enum": [
        "reporter",
        "editor",
        "researcher",
        "legal_standards",
        "general_reader",
        "synthetic_fixture"
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "demonstrated",
          "not_demonstrated",
          "not_tested"
        ]
      },
      "required": [
        "supportable_claim",
        "receipt_boundary",
        "counterweight",
        "next_record",
        "selection_defense",
        "temporal_honesty",
        "candidate_status",
        "editorial_ownership"
      ]
    },
    "transfer_case": {
      "type": "string",
      "minLength": 3
    },
    "result": {
      "enum": [
        "orientation_complete",
        "operational_use",
        "transfer_verified",
        "retention_verified",
        "not_verified"
      ]
    },
    "interpretation_contract": {
      "type": "object",
      "required": [
        "does_prove",
        "does_not_prove"
      ],
      "properties": {
        "does_prove": {
          "type": "string"
        },
        "does_not_prove": {
          "type": "string"
        }
      }
    },
    "canonical_write": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    },
    "effect_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "graph",
        "review_queue",
        "publication",
        "visibility",
        "ranking",
        "custody"
      ],
      "properties": {
        "evidence": {
          "const": "none"
        },
        "graph": {
          "const": "none"
        },
        "review_queue": {
          "const": "advisory_candidate"
        },
        "publication": {
          "const": "advisory_only"
        },
        "visibility": {
          "const": "none"
        },
        "ranking": {
          "const": "none"
        },
        "custody": {
          "const": "reader_local_or_voluntary_export"
        }
      }
    }
  }
}
