{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-natsec100-denominator-first-pass.schema.json",
  "title": "NatSec100 selector and downstream-outcome denominator first pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "parent_custody",
    "sources",
    "recovered_denominator",
    "downstream_join_state",
    "next_acquisitions",
    "allowed_terminal_states",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-open-obligation-first-pass@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 540 },
    "observation_id": { "const": "SSC-OBS-0007" },
    "lane_id": { "const": "SSC-F09" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "published_selected_denominator_recovered_candidate_and_causal_denominators_open" },
    "authority": { "const": "source_acquisition_only_not_review_or_adjudication" },
    "parent_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "const": "data/research/status-sovereignty-wave-01-targeted-acquisition.json" },
        "state": { "const": "partially_repaired_open" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts", "does_not_support"],
        "properties": {
          "source_id": { "const": "SSC-NS100-FP-S001" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_class": { "const": "first_party_methodology_and_selected_roster" },
          "retrieved_facts": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
          "does_not_support": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "recovered_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_selected_rows",
        "explicit_assessed_nonselection_examples",
        "complete_candidate_rows",
        "complete_rejected_rows",
        "exact_weights_published",
        "reproducible_scoring_data_published",
        "FOCI_decision_records_published"
      ],
      "properties": {
        "published_selected_rows": { "const": 100 },
        "explicit_assessed_nonselection_examples": { "const": 2 },
        "complete_candidate_rows": { "type": "null" },
        "complete_rejected_rows": { "type": "null" },
        "exact_weights_published": { "const": false },
        "reproducible_scoring_data_published": { "const": false },
        "FOCI_decision_records_published": { "const": false }
      }
    },
    "downstream_join_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capital_denominator_complete",
        "award_and_nonaward_denominator_complete",
        "deployment_and_failure_denominator_complete",
        "exit_denominator_complete",
        "matched_nonselected_controls_complete",
        "causal_join_generated"
      ],
      "properties": {
        "capital_denominator_complete": { "const": false },
        "award_and_nonaward_denominator_complete": { "const": false },
        "deployment_and_failure_denominator_complete": { "const": false },
        "exit_denominator_complete": { "const": false },
        "matched_nonselected_controls_complete": { "const": false },
        "causal_join_generated": { "const": false }
      }
    },
    "next_acquisitions": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
    "allowed_terminal_states": { "type": "array", "minItems": 7, "items": { "type": "string", "minLength": 1 } },
    "current_result": { "type": "object" },
    "boundaries": { "type": "object" }
  }
}
