{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Counter-Selector Batch 03 acquisition record",
  "type": "object",
  "required": [
    "candidate_id",
    "blind_token",
    "denominator_class",
    "acquisition_state",
    "qualification",
    "packet_kind",
    "source_packet_ids",
    "missing_receipts",
    "review_state",
    "blind_packet_ready"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^CS-C[0-9]{4}$"
    },
    "blind_token": {
      "type": "string",
      "pattern": "^CS-BP[0-9]{4}$"
    },
    "denominator_class": {
      "type": "string"
    },
    "acquisition_state": {
      "type": "string"
    },
    "qualification": {
      "enum": [
        "qualifying_for_blind_packet",
        "partial_not_blind_ready"
      ]
    },
    "packet_kind": {
      "enum": [
        "operator_artifact_packet",
        "system_failure_packet",
        "none"
      ]
    },
    "source_packet_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "missing_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_state": {
      "type": "string"
    },
    "blind_packet_ready": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
