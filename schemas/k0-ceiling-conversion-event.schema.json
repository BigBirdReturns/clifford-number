{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/k0-ceiling-conversion-event-v2.json",
  "title": "K0 ceiling-conversion event fixture",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "event_name",
    "corpus_role",
    "gateholder_id",
    "qualified_knower_id",
    "institution_id",
    "jurisdiction",
    "domain",
    "bounded_domain",
    "knower_qualification_basis",
    "failure_species",
    "explanation_mutation_types",
    "controlled_gate_types",
    "path",
    "ccd_depth",
    "ccd_chain_depth",
    "furthest_documented_stage",
    "ccd_missing",
    "field_audit_disposition",
    "audit_record_id",
    "maintainer_source_audit_complete",
    "independent_review_complete",
    "direct_personal_attribution",
    "attribution_basis",
    "evidence_tiers",
    "sources",
    "alternative_explanations",
    "counterevidence",
    "review_status",
    "graph_effect"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^K0-(SEED|EXP|CTRL)-[0-9]{3}$"
    },
    "corpus_role": {
      "enum": [
        "seed_positive_fixture",
        "seed_boundary_fixture",
        "seed_strategic_boundary_fixture",
        "expanded_positive_candidate",
        "expanded_candidate",
        "expanded_boundary_candidate",
        "positive_control",
        "remedial_control"
      ]
    },
    "failure_species": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "comprehension_failure",
          "status_protective_reclassification",
          "designed_comprehension_ceiling",
          "strategic_bypass",
          "mixed"
        ]
      }
    },
    "ccd_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "Backward-compatible alias that must equal ccd_chain_depth."
    },
    "ccd_chain_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "furthest_documented_stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "field_audit_disposition": {
      "enum": [
        "supported_for_human_review",
        "retained_candidate_only",
        "bounded_non_link",
        "falsified",
        "identity_ambiguous",
        "temporal_order_unresolved",
        "source_restricted",
        "source_unavailable",
        "requires_additional_acquisition"
      ]
    },
    "maintainer_source_audit_complete": {
      "const": true
    },
    "independent_review_complete": {
      "const": false
    },
    "direct_personal_attribution": {
      "type": "boolean"
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
