{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-projection-manifest-v1.json",
  "title": "POOF projection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "projection_kind",
    "source_release",
    "source_commit",
    "source_objects",
    "selection_contract",
    "qualification_state",
    "review_state",
    "generated_artifact",
    "interpretation_contract",
    "effect_contract",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-projection-manifest@1"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^POOF-PROJ-[A-Z0-9-]{4,64}$"
    },
    "projection_kind": {
      "enum": [
        "report_passage",
        "decision_file",
        "real_steel_dossier",
        "steel_mirror_audit",
        "newsroom_tree_packet",
        "examination_exhibit",
        "machine_summary"
      ]
    },
    "source_release": {
      "type": "string",
      "minLength": 3
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ids",
        "event_ids",
        "receipt_ids"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualification_state": {
      "enum": [
        "claim_specific",
        "inherited_boundary",
        "mixed",
        "fixture_only",
        "open_record"
      ]
    },
    "review_state": {
      "enum": [
        "review_required",
        "independently_reviewed",
        "approved_publication",
        "fixture_only"
      ]
    },
    "generated_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interpretation_contract": {
      "type": "object",
      "required": [
        "what_this_is",
        "what_this_is_not"
      ],
      "properties": {
        "what_this_is": {
          "type": "string",
          "minLength": 10
        },
        "what_this_is_not": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "graph_effect": {
      "const": "none"
    },
    "effect_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "graph",
        "review_queue",
        "publication",
        "visibility",
        "ranking",
        "custody"
      ],
      "properties": {
        "evidence": {
          "const": "none"
        },
        "graph": {
          "const": "none"
        },
        "review_queue": {
          "const": "none"
        },
        "publication": {
          "const": "binds_projection_custody"
        },
        "visibility": {
          "const": "none"
        },
        "ranking": {
          "const": "none"
        },
        "custody": {
          "const": "release_attached"
        }
      }
    },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_universe_ref",
        "candidate_set_hash",
        "candidate_set_hash_mode",
        "candidate_count",
        "included_count",
        "inclusion_rule",
        "exclusion_rule",
        "ordering_rule",
        "truncation_rule",
        "missingness_statement",
        "counterevidence_ids",
        "null_result_policy",
        "override_receipt_ids",
        "compression_disclosure"
      ],
      "properties": {
        "bounded_universe_ref": {
          "type": "string",
          "minLength": 3
        },
        "candidate_set_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_set_hash_mode": {
          "const": "sha256_stable_source_object_ids"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_count": {
          "type": "integer",
          "minimum": 0
        },
        "inclusion_rule": {
          "type": "string",
          "minLength": 10
        },
        "exclusion_rule": {
          "type": "string",
          "minLength": 10
        },
        "ordering_rule": {
          "type": "string",
          "minLength": 10
        },
        "truncation_rule": {
          "type": "string",
          "minLength": 10
        },
        "missingness_statement": {
          "type": "string",
          "minLength": 10
        },
        "counterevidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "null_result_policy": {
          "enum": [
            "publish_explicit_null",
            "withhold_and_explain",
            "fixture_only"
          ]
        },
        "override_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "compression_disclosure": {
          "type": "string",
          "minLength": 15
        }
      }
    }
  }
}
