{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-projection-manifest-v1.json",
  "title": "POOF projection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "projection_kind",
    "source_release",
    "source_commit",
    "source_objects",
    "qualification_state",
    "review_state",
    "generated_artifact",
    "interpretation_contract",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-projection-manifest@1"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^POOF-PROJ-[A-Z0-9-]{4,64}$"
    },
    "projection_kind": {
      "enum": [
        "report_passage",
        "decision_file",
        "real_steel_dossier",
        "steel_mirror_audit",
        "newsroom_tree_packet",
        "examination_exhibit",
        "machine_summary"
      ]
    },
    "source_release": {
      "type": "string",
      "minLength": 3
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ids",
        "event_ids",
        "receipt_ids"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualification_state": {
      "enum": [
        "claim_specific",
        "inherited_boundary",
        "mixed",
        "fixture_only",
        "open_record"
      ]
    },
    "review_state": {
      "enum": [
        "review_required",
        "independently_reviewed",
        "approved_publication",
        "fixture_only"
      ]
    },
    "generated_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interpretation_contract": {
      "type": "object",
      "required": [
        "what_this_is",
        "what_this_is_not"
      ],
      "properties": {
        "what_this_is": {
          "type": "string",
          "minLength": 10
        },
        "what_this_is_not": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
