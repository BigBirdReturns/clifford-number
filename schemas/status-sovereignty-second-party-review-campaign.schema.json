{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-second-party-review-campaign.schema.json",
  "title": "SSC-W01 separated second-party review campaign",
  "type": "object",
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "campaign_id",
    "status",
    "authority_tier",
    "parent_checkpoint",
    "source_paths",
    "packet_ids",
    "state_model",
    "eligibility_contract",
    "required_review_receipt_fields",
    "allowed_review_effects",
    "authority_contract",
    "counts",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-second-party-review-campaign@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "wave_id": { "const": "SSC-W01" },
    "campaign_id": { "const": "SSC-W01-SPR01" },
    "as_of": { "type": "string", "format": "date" },
    "issue": { "const": 507 },
    "status": { "const": "campaign_infrastructure_zero_external_receipts" },
    "authority_tier": { "const": "AT-2" },
    "title": { "type": "string", "minLength": 1 },
    "parent_checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "path", "merge_commit"],
      "properties": {
        "checkpoint_id": { "const": "SG-2026-07-30-08" },
        "path": { "const": "data/project/project-stable-ground-sg08.json" },
        "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "source_paths": {
      "type": "object",
      "required": [
        "maintainer_review",
        "maintainer_review_release_manifest",
        "targeted_acquisition",
        "targeted_acquisition_release_manifest",
        "candidate_registry",
        "response_registry"
      ],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "packet_ids": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SSC-OBS-00(0[1-9]|1[0-4])$" }
    },
    "state_model": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate_only",
          "invited",
          "nonresponse",
          "refused",
          "conflict_disclosed",
          "ineligible",
          "accepted",
          "submitted_unvalidated",
          "valid_review",
          "withdrawn",
          "superseded"
        ]
      }
    },
    "eligibility_contract": {
      "type": "object",
      "required": [
        "packet_specific",
        "prestige_establishes_independence",
        "one_conflict_establishes_universal_ineligibility",
        "required_disclosures",
        "automatic_ineligibility_reasons"
      ],
      "properties": {
        "packet_specific": { "const": true },
        "prestige_establishes_independence": { "const": false },
        "one_conflict_establishes_universal_ineligibility": { "const": false },
        "required_disclosures": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "automatic_ineligibility_reasons": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "required_review_receipt_fields": { "type": "array", "minItems": 23, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "allowed_review_effects": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authority_contract": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "current_result": { "type": "object" },
    "boundaries": { "type": "object" }
  },
  "additionalProperties": false
}
