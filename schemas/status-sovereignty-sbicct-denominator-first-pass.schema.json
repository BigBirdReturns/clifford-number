{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-sbicct-denominator-first-pass.schema.json",
  "title": "SBIC Critical Technologies applicant, leverage, performance, and recovery denominator first pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "parent_custody",
    "sources",
    "recovered_checkpoints",
    "state_distinctions",
    "open_denominators",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-open-obligation-first-pass@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 541 },
    "observation_id": { "const": "SSC-OBS-0008" },
    "lane_id": { "const": "SSC-F10" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "application_and_first_cohort_checkpoints_recovered_fund_level_flow_and_recovery_open" },
    "authority": { "const": "source_acquisition_only_not_review_or_adjudication" },
    "parent_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "const": "data/research/status-sovereignty-wave-01-targeted-acquisition.json" },
        "state": { "const": "partially_repaired_open" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SSC-SBICCT-FP-S[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_class": { "type": "string", "minLength": 1 },
          "retrieved_facts": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "recovered_checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expressions_of_interest_minimum",
        "formal_applications_as_of_2024_10_22",
        "approved_as_of_2024_10_22",
        "first_published_cohort",
        "publicly_named_first_cohort",
        "withheld_first_cohort",
        "fully_licensed_as_of_2025_01_17"
      ],
      "properties": {
        "expressions_of_interest_minimum": { "const": 100 },
        "formal_applications_as_of_2024_10_22": { "const": 22 },
        "approved_as_of_2024_10_22": { "const": 13 },
        "first_published_cohort": { "const": 18 },
        "publicly_named_first_cohort": { "const": 17 },
        "withheld_first_cohort": { "const": 1 },
        "fully_licensed_as_of_2025_01_17": { "const": 7 }
      }
    },
    "state_distinctions": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string", "minLength": 1 } },
    "open_denominators": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
    "current_result": { "type": "object" },
    "boundaries": { "type": "object" }
  }
}
