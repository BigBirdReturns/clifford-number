{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-wave-02-second-party-review-receipt.schema.json",
  "title": "SSC-W02 second-party review receipt",
  "type": "object",
  "required": [
    "review_id",
    "reviewer_id",
    "reviewer_identity_receipt",
    "affiliation",
    "packet_id",
    "packet_sha256",
    "parent_review_release_sha256",
    "reviewed_at",
    "source_access_statement",
    "conflict_disclosure",
    "eligibility_decision",
    "four_gate_assessment",
    "recommended_disposition",
    "authority_ceiling",
    "alternatives_and_counterevidence",
    "missing_acquisitions",
    "unresolved_questions",
    "relationship_to_maintainer_review",
    "confidence_and_scope_limits",
    "authenticity_receipt",
    "publication_effect",
    "graph_effect",
    "adoption_effect"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^SSC-W02-SPR01-R[0-9]{4}$"
    },
    "reviewer_id": {
      "type": "string"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^SSC-W02-PKT-000[1-8]$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_review_release_sha256": {
      "const": "e002f289a614bad16b215a346b0e1238b567d75c2a5f3e8a413816a1e690db09"
    },
    "publication_effect": {
      "const": "none"
    },
    "graph_effect": {
      "const": "none"
    },
    "adoption_effect": {
      "const": "none"
    }
  },
  "additionalProperties": true
}
