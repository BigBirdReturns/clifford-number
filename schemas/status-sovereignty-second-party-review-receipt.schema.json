{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-second-party-review-receipt.schema.json",
  "title": "SSC-W01 second-party review receipt",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "review_id",
    "reviewer_id",
    "reviewer_identity",
    "affiliation",
    "packet_id",
    "packet_sha256",
    "parent_review_release_sha256",
    "reviewed_at",
    "source_access_statement",
    "conflict_disclosure",
    "eligibility_decision",
    "four_gate_assessment",
    "recommended_disposition",
    "authority_ceiling",
    "alternatives_retained",
    "counterevidence_retained",
    "missing_acquisitions",
    "unresolved_questions",
    "maintainer_review_relation",
    "confidence",
    "scope_limits",
    "authenticity_receipt",
    "review_effect",
    "publication_effect",
    "graph_effect",
    "adoption_effect"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-second-party-review-receipt@1" },
    "campaign_id": { "const": "SSC-W01-SPR01" },
    "review_id": { "type": "string", "pattern": "^SSC-W01-SPR01-R[0-9]{4}$" },
    "reviewer_id": { "type": "string", "pattern": "^SSC-REVIEWER-[0-9]{4}$" },
    "reviewer_identity": {
      "type": "object",
      "required": ["display_name", "identity_receipt"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "identity_receipt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "affiliation": { "type": ["string", "null"] },
    "packet_id": { "type": "string", "pattern": "^SSC-OBS-00(0[1-9]|1[0-4])$" },
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parent_review_release_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_access_statement": {
      "type": "object",
      "required": ["packet_received", "source_routes_reviewed", "held_source_bytes_received", "limitations"],
      "properties": {
        "packet_received": { "const": true },
        "source_routes_reviewed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "held_source_bytes_received": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "conflict_disclosure": {
      "type": "object",
      "required": ["complete", "disclosed_interests", "automatic_ineligibility_reason"],
      "properties": {
        "complete": { "const": true },
        "disclosed_interests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "automatic_ineligibility_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "eligibility_decision": {
      "type": "object",
      "required": ["state", "decided_by", "reason"],
      "properties": {
        "state": { "enum": ["eligible", "ineligible", "unresolved"] },
        "decided_by": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "four_gate_assessment": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["gate_id", "state", "rationale"],
        "properties": {
          "gate_id": { "enum": ["SSC-G1", "SSC-G2", "SSC-G3", "SSC-G4"] },
          "state": { "enum": ["supported_bounded", "partially_supported", "not_established", "contradicted", "not_assessed"] },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recommended_disposition": { "type": "string", "minLength": 1 },
    "authority_ceiling": { "type": "string", "minLength": 1 },
    "alternatives_retained": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "counterevidence_retained": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "missing_acquisitions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unresolved_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "maintainer_review_relation": { "enum": ["agree", "agree_with_narrowing", "agree_with_expansion", "disagree_bounded", "unable_to_assess"] },
    "confidence": { "enum": ["low", "moderate", "high"] },
    "scope_limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authenticity_receipt": {
      "type": "object",
      "required": ["method", "value"],
      "properties": {
        "method": { "enum": ["cryptographic_signature", "verified_email_attestation", "signed_document", "other_evaluable_receipt"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review_effect": { "enum": ["affirm_maintainer_ceiling", "recommend_narrowing", "recommend_expansion", "identify_control_or_non_link", "identify_new_acquisition_obligation", "record_bounded_disagreement"] },
    "publication_effect": { "const": "none" },
    "graph_effect": { "const": "none" },
    "adoption_effect": { "const": "none" }
  },
  "allOf": [
    {
      "if": { "properties": { "eligibility_decision": { "properties": { "state": { "const": "eligible" } } } } },
      "then": { "properties": { "conflict_disclosure": { "properties": { "automatic_ineligibility_reason": { "type": "null" } } } } }
    }
  ],
  "additionalProperties": false
}
