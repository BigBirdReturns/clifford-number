{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status-sovereignty-wave-02-second-party-review-candidate.schema.json",
  "title": "SSC-W02 packet-specific reviewer candidate registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "campaign_id",
    "as_of",
    "status",
    "selection_contract",
    "records",
    "failure_denominator",
    "counts",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "status-sovereignty-wave-02-second-party-review-candidates@1"
    },
    "hypothesis_id": {
      "const": "SSC-H01"
    },
    "wave_id": {
      "const": "SSC-W02"
    },
    "campaign_id": {
      "const": "SSC-W02-SPR01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "status": {
      "const": "candidate_discovery_wave_01_eight_uncontacted_two_screened_ineligible"
    },
    "selection_contract": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "packet_id",
          "observation_id",
          "lane_id",
          "selected_at",
          "candidate_state",
          "eligibility_state",
          "invitation_state",
          "invitation_authorized",
          "conflict_disclosure_received",
          "authenticity_receipt_received",
          "public_identity",
          "public_profile_receipt",
          "expertise_fit",
          "selection_basis",
          "source_author_screen",
          "disqualifier_screen",
          "valid_review_count",
          "publication_effect",
          "graph_effect",
          "adoption_effect"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^SSC-W02-CAND-[0-9]{4}$"
          },
          "packet_id": {
            "type": "string",
            "pattern": "^SSC-W02-PKT-[0-9]{4}$"
          },
          "observation_id": {
            "type": "string",
            "pattern": "^SSC-OBS-[0-9]{4}$"
          },
          "lane_id": {
            "type": "string",
            "pattern": "^SSC-F[0-9]{2}$"
          },
          "selected_at": {
            "const": "2026-08-01"
          },
          "candidate_state": {
            "const": "candidate_only_uncontacted"
          },
          "eligibility_state": {
            "const": "unresolved_pending_candidate_disclosure"
          },
          "invitation_state": {
            "const": "not_sent"
          },
          "invitation_authorized": {
            "const": false
          },
          "conflict_disclosure_received": {
            "const": false
          },
          "authenticity_receipt_received": {
            "const": false
          },
          "public_identity": {
            "type": "object",
            "required": [
              "name",
              "affiliation",
              "title"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "affiliation": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "public_email": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "public_profile_receipt": {
            "type": "object",
            "required": [
              "authority",
              "reviewed_at",
              "url",
              "normalized_facts"
            ],
            "properties": {
              "authority": {
                "const": "official_institutional_profile"
              },
              "reviewed_at": {
                "const": "2026-08-01"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "normalized_facts": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "expertise_fit": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "selection_basis": {
            "type": "string"
          },
          "source_author_screen": {
            "type": "object"
          },
          "disqualifier_screen": {
            "type": "object"
          },
          "valid_review_count": {
            "const": 0
          },
          "publication_effect": {
            "const": "none"
          },
          "graph_effect": {
            "const": "none"
          },
          "adoption_effect": {
            "const": "none"
          }
        }
      }
    },
    "failure_denominator": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  }
}
