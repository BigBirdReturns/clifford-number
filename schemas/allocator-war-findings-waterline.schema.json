{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.axm.tools/schemas/allocator-war-findings-waterline.schema.json",
  "title": "Allocator war findings waterline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "waterline_id",
    "title",
    "as_of",
    "status",
    "authority_tier",
    "graph_effect",
    "publication_status",
    "purpose",
    "working_definition",
    "parent_custody",
    "counts",
    "observation_denominator",
    "finding_classes",
    "cross_class_findings",
    "promotion_requirements",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "allocator-war-findings-waterline@1"
    },
    "waterline_id": {
      "const": "AW-WL-01"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authority_tier": {
      "const": "AT-2-derived-routing"
    },
    "graph_effect": {
      "const": "none"
    },
    "publication_status": {
      "const": "blocked"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "working_definition": {
      "type": "string",
      "minLength": 1
    },
    "parent_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "wave_id",
        "maintainer_review_id",
        "targeted_acquisition_id",
        "paths"
      ],
      "properties": {
        "hypothesis_id": {
          "const": "SSC-H01"
        },
        "wave_id": {
          "const": "SSC-W01"
        },
        "maintainer_review_id": {
          "const": "SSC-W01-MR01"
        },
        "targeted_acquisition_id": {
          "const": "SSC-W01-TA01"
        },
        "paths": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": [
        "source_records",
        "retained_observations",
        "maintainer_reviewed_observations",
        "second_party_reviewed_observations",
        "adjudicated_observations",
        "partial_functional_convergence",
        "effective_counterpower_controls",
        "ordinary_industrial_policy_controls",
        "requires_additional_acquisition",
        "capital_conversion_unsupported",
        "supported_complete_compact",
        "racial_order_findings",
        "prevalence_findings",
        "coordination_findings",
        "common_purpose_findings",
        "personal_hostility_findings",
        "graph_effects",
        "publication_clearances"
      ]
    },
    "observation_denominator": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SSC-OBS-[0-9]{4}$"
      }
    },
    "finding_classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "label",
          "classification",
          "observation_ids",
          "supported_statement",
          "evidence_ceiling",
          "next_required_records"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^AW-[FCOR][0-9]{2}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "maintainer_reviewed_bounded_mechanism",
              "maintainer_reviewed_positive_control",
              "maintainer_reviewed_open_acquisition",
              "maintainer_reviewed_nonpromotion"
            ]
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SSC-OBS-[0-9]{4}$"
            }
          },
          "supported_statement": {
            "type": "string",
            "minLength": 1
          },
          "refused_statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ceiling": {
            "type": "string",
            "minLength": 1
          },
          "four_gate_state": {
            "type": "object"
          },
          "targeted_acquisition_state": {
            "type": "string"
          },
          "next_required_records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "cross_class_findings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "label",
          "state",
          "basis_finding_ids",
          "statement",
          "limit"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^AW-X[0-9]{2}$"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "basis_finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "statement": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          }
        }
      }
    },
    "promotion_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "graph_effect"
      ],
      "properties": {
        "graph_effect": {
          "const": "none"
        }
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      }
    }
  }
}
