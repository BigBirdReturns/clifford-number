{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/poof-right-of-reply-v1.json",
  "title": "POOF right-of-reply and correction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "subject_id",
    "notice",
    "response",
    "disputed_predicates",
    "correction_disposition",
    "publication_versions",
    "unresolved_objections",
    "absence_interpretation",
    "canonical_write",
    "effect_contract",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "poof-right-of-reply@1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^POOF-ROR-[A-Z0-9-]{4,64}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 2
    },
    "notice": {
      "type": "object",
      "required": [
        "sent_at",
        "route",
        "scope"
      ],
      "properties": {
        "sent_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "state",
        "received_at",
        "evidence_state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_sent",
            "awaiting",
            "received",
            "declined",
            "unavailable"
          ]
        },
        "received_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_state": {
          "enum": [
            "none",
            "attributed_claim",
            "primary_public",
            "official",
            "legal_disposition",
            "mixed"
          ]
        }
      }
    },
    "disputed_predicates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correction_disposition": {
      "enum": [
        "not_applicable",
        "pending",
        "corrected",
        "qualified",
        "rejected_with_reason",
        "withdrawn"
      ]
    },
    "publication_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_objections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "absence_interpretation": {
      "const": "no_response_is_not_admission"
    },
    "canonical_write": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    },
    "effect_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "graph",
        "review_queue",
        "publication",
        "visibility",
        "ranking",
        "custody"
      ],
      "properties": {
        "evidence": {
          "const": "none"
        },
        "graph": {
          "const": "none"
        },
        "review_queue": {
          "const": "opens_correction_review"
        },
        "publication": {
          "const": "separate_decision_required"
        },
        "visibility": {
          "const": "none"
        },
        "ranking": {
          "const": "none"
        },
        "custody": {
          "const": "versioned_append_only"
        }
      }
    }
  }
}
