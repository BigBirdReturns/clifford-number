{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status-sovereignty-wave-02-internal-adversarial-review.schema.json",
  "title": "SSC-W02 internal adversarial counter-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "review_id",
    "as_of",
    "status",
    "title",
    "parent_review",
    "review_contract",
    "counts",
    "records",
    "recommendations",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "status-sovereignty-wave-02-internal-adversarial-review@1"
    },
    "hypothesis_id": {
      "const": "SSC-H01"
    },
    "wave_id": {
      "const": "SSC-W02"
    },
    "review_id": {
      "const": "SSC-W02-IAR01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "status": {
      "const": "complete_internal_adversarial_counterreview_zero_external_authority"
    },
    "title": {
      "type": "string",
      "minLength": 20
    },
    "parent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "path",
        "release_sha256",
        "packets"
      ],
      "properties": {
        "review_id": {
          "const": "SSC-W02-MR01"
        },
        "path": {
          "const": "data/research/status-sovereignty-wave-02-maintainer-review.json"
        },
        "release_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packets": {
          "const": 8
        }
      }
    },
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "roles",
        "is_external_review",
        "counts_as_second_party_review",
        "counts_as_adjudication",
        "may_recommend_authority_narrowing",
        "may_recommend_taxonomy_change",
        "may_change_canonical_disposition",
        "may_clear_publication",
        "may_create_graph_effect",
        "may_advance_adoption",
        "continues_without_external_participation"
      ],
      "properties": {
        "authority": {
          "const": "internal_machine_assisted_adversarial_counterreview"
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "is_external_review": {
          "const": false
        },
        "counts_as_second_party_review": {
          "const": false
        },
        "counts_as_adjudication": {
          "const": false
        },
        "may_recommend_authority_narrowing": {
          "const": true
        },
        "may_recommend_taxonomy_change": {
          "const": true
        },
        "may_change_canonical_disposition": {
          "const": false
        },
        "may_clear_publication": {
          "const": false
        },
        "may_create_graph_effect": {
          "const": false
        },
        "may_advance_adoption": {
          "const": false
        },
        "continues_without_external_participation": {
          "const": true
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "counterreview_id",
          "packet_id",
          "observation_id",
          "lane_id",
          "packet_sha256",
          "canonical_disposition",
          "strongest_null",
          "overclaim_attack",
          "decisive_discriminator",
          "adversarial_result",
          "recommended_disposition",
          "recommended_authority_ceiling",
          "acquisition_priority",
          "counterreview_finding",
          "canonical_change_authorized",
          "counts_as_external_review",
          "publication_effect",
          "graph_effect",
          "adoption_effect"
        ],
        "properties": {
          "counterreview_id": {
            "type": "string",
            "pattern": "^SSC-W02-IAR-[0-9]{4}$"
          },
          "packet_id": {
            "type": "string",
            "pattern": "^SSC-W02-PKT-[0-9]{4}$"
          },
          "observation_id": {
            "type": "string",
            "pattern": "^SSC-OBS-[0-9]{4}$"
          },
          "lane_id": {
            "type": "string",
            "pattern": "^SSC-F[0-9]{2}$"
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_disposition": {
            "type": "string",
            "minLength": 5
          },
          "strongest_null": {
            "type": "string",
            "minLength": 60
          },
          "overclaim_attack": {
            "type": "string",
            "minLength": 60
          },
          "decisive_discriminator": {
            "type": "string",
            "minLength": 60
          },
          "adversarial_result": {
            "type": "string",
            "minLength": 10
          },
          "recommended_disposition": {
            "type": "string",
            "minLength": 5
          },
          "recommended_authority_ceiling": {
            "type": "string",
            "minLength": 30
          },
          "acquisition_priority": {
            "enum": [
              "none_for_current_disposition",
              "medium",
              "high"
            ]
          },
          "counterreview_finding": {
            "type": "string",
            "minLength": 60
          },
          "canonical_change_authorized": {
            "const": false
          },
          "counts_as_external_review": {
            "const": false
          },
          "publication_effect": {
            "const": "none"
          },
          "graph_effect": {
            "const": "none"
          },
          "adoption_effect": {
            "const": "none"
          }
        }
      }
    },
    "recommendations": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  }
}
