{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clifford-number.local/schemas/status-sovereignty-rd-wave03-rd02-disclosure-leaf.schema.json",
  "title": "SSC RD-02 Wave-03 disclosure-leaf adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "class_id",
    "issue",
    "as_of",
    "authority",
    "source_custody",
    "frozen_unit",
    "denominator",
    "selection_law",
    "selected_records",
    "terminal_without_request",
    "annual_report_disposition",
    "current_result",
    "refused_inferences",
    "authority_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "ssc-rd02-wave03-disclosure-leaf-adjudication@1"
    },
    "wave_id": {
      "const": "SSC-RD-W03"
    },
    "lane_id": {
      "const": "RD-02"
    },
    "class_id": {
      "const": "RD-02-C05"
    },
    "issue": {
      "const": 1015
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authority": {
      "const": "terminal_captured_link_adjudication_not_source_admission_or_lifecycle_finding"
    },
    "source_custody": {
      "type": "object"
    },
    "frozen_unit": {
      "type": "object",
      "required": [
        "unit_ordinal",
        "unit_id",
        "legal_vehicle"
      ],
      "properties": {
        "unit_ordinal": {
          "const": 15
        },
        "unit_id": {
          "const": "SBICCT-FIRST-COHORT-15"
        },
        "legal_vehicle": {
          "const": "Stifel North Atlantic AM-Forward, LP"
        }
      },
      "additionalProperties": false
    },
    "denominator": {
      "type": "object",
      "required": [
        "captured_candidate_urls",
        "terminally_adjudicated_urls",
        "fixed_leaf_pdf_routes",
        "terminal_without_request_urls",
        "selected_source_route_candidates",
        "silent_urls"
      ],
      "properties": {
        "captured_candidate_urls": {
          "const": 457
        },
        "terminally_adjudicated_urls": {
          "const": 457
        },
        "fixed_leaf_pdf_routes": {
          "const": 2
        },
        "terminal_without_request_urls": {
          "const": 455
        },
        "selected_source_route_candidates": {
          "const": 2
        },
        "silent_urls": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "selection_law": {
      "type": "object"
    },
    "selected_records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "terminal_without_request": {
      "type": "object"
    },
    "annual_report_disposition": {
      "type": "object"
    },
    "current_result": {
      "type": "object"
    },
    "refused_inferences": {
      "type": "array",
      "minItems": 8
    },
    "authority_boundaries": {
      "type": "object"
    }
  }
}
