{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-custody-finality.schema.json",
  "title": "Counter-Selector custody and finality record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "lane_type",
    "disposition",
    "source_ids",
    "findings",
    "dimension_vector",
    "new_bounded_dimension_supports",
    "field_test_eligible",
    "operator_finding",
    "graph_effect"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^CS-BLIND-[0-9]{4}$"
    },
    "lane_type": {
      "type": "string",
      "enum": [
        "same_matter_successor_custody",
        "public_finality_and_durable_custody"
      ]
    },
    "prior_disposition": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CS-W06-S[0-9]{3}$"
      }
    },
    "findings": {
      "type": "object",
      "minProperties": 1
    },
    "dimension_vector": {
      "type": "object",
      "required": [
        "support_adjusted_surplus",
        "cross_domain_transfer",
        "exception_handling",
        "custody",
        "model_elasticity",
        "governed_capacity",
        "non_zero_sum_orientation",
        "epistemic_restraint"
      ],
      "additionalProperties": false
    },
    "new_bounded_dimension_supports": {
      "type": "integer",
      "const": 0
    },
    "field_test_eligible": {
      "type": "boolean",
      "const": false
    },
    "operator_finding": {
      "type": "boolean",
      "const": false
    },
    "graph_effect": {
      "type": "string",
      "const": "none"
    }
  }
}
