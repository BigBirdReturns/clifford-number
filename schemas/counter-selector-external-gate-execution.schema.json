{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-external-gate-execution.schema.json",
  "title": "Counter-Selector external gate execution audit",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "observed_at",
    "parent_main_sha",
    "parent_wave_id",
    "parent_release_sha256",
    "counts",
    "candidate_state",
    "archive_requests",
    "independent_review",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-external-gate-execution-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W22-EX-01"
    },
    "as_of": {
      "const": "2026-08-01"
    },
    "observed_at": {
      "type": "string"
    },
    "parent_main_sha": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_wave_id": {
      "const": "CS-W21-GE-01"
    },
    "parent_release_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object"
    },
    "candidate_state": {
      "type": "object"
    },
    "archive_requests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "custodian",
          "recipient",
          "subject",
          "official_route_url",
          "official_route_verified",
          "sent_at",
          "gmail_message_id",
          "gmail_thread_id",
          "gmail_submission_receipt",
          "recipient_delivery_confirmed",
          "response_state",
          "response_received",
          "substantive_reference_response",
          "evidence_objects_acquired",
          "next_state"
        ]
      }
    },
    "independent_review": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
