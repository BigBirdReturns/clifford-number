{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-osc-denominator-first-pass.schema.json",
  "title": "Office of Strategic Capital applicant, underwriting, instrument, and recovery denominator first pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "parent_custody",
    "sources",
    "published_program_denominator",
    "named_instrument_subset",
    "state_distinctions",
    "open_denominators",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-open-obligation-first-pass@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 542 },
    "observation_id": { "const": "SSC-OBS-0009" },
    "lane_id": { "const": "SSC-F10" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "published_program_and_named_instrument_checkpoints_recovered_complete_cohort_and_recovery_open" },
    "authority": { "const": "source_acquisition_only_not_review_or_adjudication" },
    "parent_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": { "const": "data/research/status-sovereignty-wave-01-targeted-acquisition.json" },
        "state": { "const": "partially_repaired_open" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SSC-OSC-FP-S[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_class": { "type": "string", "minLength": 1 },
          "retrieved_facts": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "published_program_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applications_minimum",
        "requested_usd",
        "initial_capacity_usd",
        "states_represented",
        "request_minimum_usd",
        "request_maximum_usd",
        "complete_applicant_identities_published",
        "complete_selected_and_rejected_rows_published"
      ],
      "properties": {
        "applications_minimum": { "const": 200 },
        "requested_usd": { "const": 8900000000 },
        "initial_capacity_usd": { "const": 984000000 },
        "states_represented": { "const": 38 },
        "request_minimum_usd": { "const": 10000000 },
        "request_maximum_usd": { "const": 150000000 },
        "complete_applicant_identities_published": { "const": false },
        "complete_selected_and_rejected_rows_published": { "const": false }
      }
    },
    "named_instrument_subset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_direct_loans",
        "conditional_commitments",
        "named_amounts_usd",
        "reconciled_to_inaugural_NOFA",
        "complete_current_OSC_commitment_denominator"
      ],
      "properties": {
        "executed_direct_loans": { "const": 1 },
        "conditional_commitments": { "const": 4 },
        "named_amounts_usd": { "const": 2075000000 },
        "reconciled_to_inaugural_NOFA": { "const": false },
        "complete_current_OSC_commitment_denominator": { "const": false }
      }
    },
    "state_distinctions": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
    "open_denominators": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
    "current_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_state",
        "reviewed_disposition_changed",
        "complete_underwriting_to_recovery_chain",
        "favoritism_finding",
        "extraction_finding",
        "complete_compact_finding",
        "graph_effect",
        "publication_effect"
      ],
      "properties": {
        "terminal_state": { "const": "requires_additional_acquisition" },
        "reviewed_disposition_changed": { "const": false },
        "complete_underwriting_to_recovery_chain": { "const": false },
        "favoritism_finding": { "const": false },
        "extraction_finding": { "const": false },
        "complete_compact_finding": { "const": false },
        "graph_effect": { "const": "none" },
        "publication_effect": { "const": "none" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_volume_proves_selection_quality",
        "strategic_financing_proves_favoritism",
        "conditional_commitment_is_executed_loan",
        "executed_loan_is_disbursed_and_repaid",
        "named_subset_is_complete_cohort",
        "private_capacity_proves_extraction",
        "graph_effect"
      ],
      "properties": {
        "application_volume_proves_selection_quality": { "const": false },
        "strategic_financing_proves_favoritism": { "const": false },
        "conditional_commitment_is_executed_loan": { "const": false },
        "executed_loan_is_disbursed_and_repaid": { "const": false },
        "named_subset_is_complete_cohort": { "const": false },
        "private_capacity_proves_extraction": { "const": false },
        "graph_effect": { "const": "none" }
      }
    }
  }
}
