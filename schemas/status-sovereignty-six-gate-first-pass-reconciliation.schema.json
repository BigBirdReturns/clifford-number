{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-six-gate-first-pass-reconciliation.schema.json",
  "title": "SSC six-gate first-pass reconciliation and residual denominator atlas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reconciliation_id",
    "hypothesis_id",
    "issue",
    "as_of",
    "title",
    "authority",
    "parent_program",
    "gate_receipts",
    "residual_denominator_atlas",
    "counts",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-six-gate-first-pass-reconciliation@1" },
    "reconciliation_id": { "const": "SSC-FANOUT-R01" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 607 },
    "as_of": { "const": "2026-08-01" },
    "title": { "type": "string", "minLength": 1 },
    "authority": { "const": "cross_lane_source_acquisition_reconciliation_not_review_or_adjudication" },
    "parent_program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_issue", "wave_issue", "first_pass_issue_range"],
      "properties": {
        "program_issue": { "const": 468 },
        "wave_issue": { "const": 508 },
        "first_pass_issue_range": { "const": "540-545" }
      }
    },
    "gate_receipts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "issue",
          "pr",
          "lane_id",
          "observation_id",
          "first_pass_id",
          "review_head",
          "merge_commit",
          "source_path",
          "release_manifest_path",
          "release_sha256",
          "source_records",
          "residual_field",
          "residual_denominator_classes",
          "terminal_state",
          "retained_controls",
          "allowed_true_result_fields"
        ],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "issue": { "type": "integer", "minimum": 540, "maximum": 545 },
          "pr": { "type": "integer", "minimum": 554, "maximum": 559 },
          "lane_id": { "type": "string", "pattern": "^SSC-F[0-9]{2}$" },
          "observation_id": { "type": "string", "pattern": "^SSC-OBS-[0-9]{4}$" },
          "first_pass_id": { "type": "string", "minLength": 1 },
          "review_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source_path": { "type": "string", "pattern": "^data/intake/" },
          "release_manifest_path": { "type": "string", "pattern": "^data/project/" },
          "release_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_records": { "type": "integer", "minimum": 1 },
          "residual_field": { "enum": ["next_acquisitions", "open_denominators"] },
          "residual_denominator_classes": { "type": "integer", "minimum": 1 },
          "terminal_state": { "const": "requires_additional_acquisition" },
          "retained_controls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "allowed_true_result_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "residual_denominator_atlas": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "gate_id", "count"],
        "properties": {
          "class_id": { "type": "string", "minLength": 1 },
          "gate_id": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_pass_lanes_completed",
        "first_pass_issues_closed_completed",
        "source_records",
        "terminal_requires_additional_acquisition",
        "residual_denominator_classes",
        "residual_evidence_obligations_closed",
        "reviewed_disposition_changes",
        "complete_compact_findings",
        "racial_order_findings",
        "prevalence_findings",
        "coordination_findings",
        "common_purpose_findings",
        "personal_hostility_findings",
        "graph_effects",
        "publication_effects"
      ],
      "properties": {
        "first_pass_lanes_completed": { "const": 6 },
        "first_pass_issues_closed_completed": { "const": 6 },
        "source_records": { "const": 25 },
        "terminal_requires_additional_acquisition": { "const": 6 },
        "residual_denominator_classes": { "const": 42 },
        "residual_evidence_obligations_closed": { "const": 0 },
        "reviewed_disposition_changes": { "const": 0 },
        "complete_compact_findings": { "const": 0 },
        "racial_order_findings": { "const": 0 },
        "prevalence_findings": { "const": 0 },
        "coordination_findings": { "const": 0 },
        "common_purpose_findings": { "const": 0 },
        "personal_hostility_findings": { "const": 0 },
        "graph_effects": { "const": 0 },
        "publication_effects": { "const": 0 }
      }
    },
    "current_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_state",
        "all_six_first_pass_receipts_present",
        "cross_lane_empirical_authority_shared",
        "reviewed_disposition_changed",
        "complete_compact_finding",
        "racial_order_finding",
        "prevalence_finding",
        "coordination_finding",
        "common_purpose_finding",
        "personal_hostility_finding",
        "graph_effect",
        "publication_effect"
      ],
      "properties": {
        "terminal_state": { "const": "six_first_pass_transactions_complete_residual_denominators_open" },
        "all_six_first_pass_receipts_present": { "const": true },
        "cross_lane_empirical_authority_shared": { "const": false },
        "reviewed_disposition_changed": { "const": false },
        "complete_compact_finding": { "const": false },
        "racial_order_finding": { "const": false },
        "prevalence_finding": { "const": false },
        "coordination_finding": { "const": false },
        "common_purpose_finding": { "const": false },
        "personal_hostility_finding": { "const": false },
        "graph_effect": { "const": "none" },
        "publication_effect": { "const": "none" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_pass_issue_completion_is_substantive_denominator_closure",
        "selected_roster_is_candidate_universe",
        "license_is_leverage_draw",
        "conditional_commitment_is_executed_loan",
        "executed_loan_is_disbursement_or_repayment",
        "representation_proves_neutrality_or_tokenism",
        "formal_appeal_proves_effective_counterpower",
        "competition_and_protest_prove_complete_option_set_fairness",
        "functional_convergence_proves_conscious_common_purpose",
        "graph_effect"
      ],
      "properties": {
        "first_pass_issue_completion_is_substantive_denominator_closure": { "const": false },
        "selected_roster_is_candidate_universe": { "const": false },
        "license_is_leverage_draw": { "const": false },
        "conditional_commitment_is_executed_loan": { "const": false },
        "executed_loan_is_disbursement_or_repayment": { "const": false },
        "representation_proves_neutrality_or_tokenism": { "const": false },
        "formal_appeal_proves_effective_counterpower": { "const": false },
        "competition_and_protest_prove_complete_option_set_fairness": { "const": false },
        "functional_convergence_proves_conscious_common_purpose": { "const": false },
        "graph_effect": { "const": "none" }
      }
    }
  }
}
