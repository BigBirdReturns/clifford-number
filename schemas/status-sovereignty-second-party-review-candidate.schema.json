{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-second-party-review-candidate.schema.json",
  "title": "SSC-W01 second-party reviewer candidate registry",
  "type": "object",
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "campaign_id",
    "as_of",
    "status",
    "records",
    "counts",
    "failure_denominator",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-second-party-review-candidates@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "wave_id": { "const": "SSC-W01" },
    "campaign_id": { "const": "SSC-W01-SPR01" },
    "as_of": { "type": "string", "format": "date" },
    "status": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "display_name",
          "affiliation",
          "public_contact_route",
          "nominated_at",
          "nomination_basis",
          "state",
          "eligible_packet_ids",
          "contact_history",
          "conflict_disclosure",
          "packet_eligibility",
          "boundaries"
        ],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^SSC-REVIEWER-[0-9]{4}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "affiliation": { "type": ["string", "null"] },
          "public_contact_route": { "type": "string", "minLength": 1 },
          "nominated_at": { "type": "string", "format": "date-time" },
          "nomination_basis": { "type": "string", "minLength": 1 },
          "state": {
            "enum": [
              "candidate_only",
              "invited",
              "nonresponse",
              "refused",
              "conflict_disclosed",
              "ineligible",
              "accepted",
              "withdrawn",
              "superseded"
            ]
          },
          "eligible_packet_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SSC-OBS-00(0[1-9]|1[0-4])$" }
          },
          "contact_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["event_id", "state", "occurred_at", "route", "receipt"],
              "properties": {
                "event_id": { "type": "string", "pattern": "^SSC-W01-SPR01-C[0-9]{4}$" },
                "state": {
                  "enum": [
                    "invited",
                    "nonresponse",
                    "refused",
                    "conflict_disclosed",
                    "accepted",
                    "withdrawn",
                    "superseded"
                  ]
                },
                "occurred_at": { "type": "string", "format": "date-time" },
                "route": { "type": "string", "minLength": 1 },
                "receipt": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "conflict_disclosure": {
            "type": "object",
            "required": [
              "state",
              "disclosed_interests",
              "automatic_ineligibility_reasons",
              "authenticity_receipt"
            ],
            "properties": {
              "state": { "enum": ["not_requested", "requested", "complete", "incomplete"] },
              "disclosed_interests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "automatic_ineligibility_reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "packet_author_or_material_editor",
                    "maintainer_or_maintainer_controlled_reviewer",
                    "named_target_or_represented_institution",
                    "source_custodian_for_packet",
                    "direct_material_beneficiary",
                    "material_financial_employment_litigation_procurement_political_or_close_personal_interest",
                    "prior_adjudicator_for_same_packet",
                    "identity_or_conflict_disclosure_insufficient"
                  ]
                }
              },
              "authenticity_receipt": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "packet_eligibility": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["packet_id", "state", "reasons", "decided_by", "decided_at"],
              "properties": {
                "packet_id": { "type": "string", "pattern": "^SSC-OBS-00(0[1-9]|1[0-4])$" },
                "state": { "enum": ["not_assessed", "eligible", "ineligible", "unresolved"] },
                "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "decided_by": { "type": ["string", "null"] },
                "decided_at": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": false
            }
          },
          "boundaries": {
            "type": "object",
            "required": [
              "candidate_status_proves_independence",
              "institutional_title_proves_independence",
              "contact_counts_as_review",
              "publication_effect",
              "graph_effect",
              "adoption_effect"
            ],
            "properties": {
              "candidate_status_proves_independence": { "const": false },
              "institutional_title_proves_independence": { "const": false },
              "contact_counts_as_review": { "const": false },
              "publication_effect": { "const": "none" },
              "graph_effect": { "const": "none" },
              "adoption_effect": { "const": "none" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "failure_denominator": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "state", "recorded_at", "receipt", "interpretation"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["nonresponse", "refused", "ineligible", "withdrawn", "superseded"] },
          "recorded_at": { "type": "string", "format": "date-time" },
          "receipt": { "type": "string", "minLength": 1 },
          "interpretation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "boundaries": { "type": "object" }
  },
  "additionalProperties": false
}
