{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-post-review-gap.schema.json",
  "title": "Counter-Selector post-review gap record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "packet_id",
    "candidate_id",
    "lane_type",
    "dimension_vector",
    "disposition",
    "field_test_eligible",
    "operator_finding",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-post-review-gap@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W05-GAP-01"
    },
    "packet_id": {
      "pattern": "^CS-BLIND-[0-9]{4}$"
    },
    "candidate_id": {
      "pattern": "^CS-C[0-9]{4}$"
    },
    "lane_type": {
      "enum": [
        "support_handoff_transfer_audit",
        "correction_finality_audit"
      ]
    },
    "dimension_vector": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8
    },
    "findings": {
      "type": "object"
    },
    "chronology": {
      "type": "array"
    },
    "supersession": {
      "type": "object"
    },
    "disposition": {
      "type": "string",
      "minLength": 1
    },
    "field_test_eligible": {
      "const": false
    },
    "operator_finding": {
      "const": false
    },
    "promotion_generated": {
      "const": false
    },
    "person_ranking_generated": {
      "const": false
    },
    "public_identity_release_authorized": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
