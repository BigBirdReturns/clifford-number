          "type": "integer",
          "minimum": 0
        },
        "matched_controls_retained": {
          "type": "integer",
          "minimum": 0
        },
        "new_person_supports": {
          "type": "integer",
          "minimum": 0
        },
        "new_cross_domain_transfer_supports": {
          "type": "integer",
          "minimum": 0
        },
        "new_custody_supports": {
          "type": "integer",
          "minimum": 0
        },
        "external_review_exports_updated": {
          "type": "integer",
          "minimum": 0
        },
        "external_review_requests_sent": {
          "type": "integer",
          "minimum": 0
        },
        "external_selector_reviews_executed": {
          "type": "integer",
          "minimum": 0
        },
        "complete_operator_findings": {
          "type": "integer",
          "minimum": 0
        },
        "field_test_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "contacts_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_collaborations_authorized": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "person_rankings": {
          "type": "integer",
          "minimum": 0
        },
        "public_identity_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "graph_effects": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
