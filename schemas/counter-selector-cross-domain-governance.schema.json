      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "subject",
          "source_class",
          "title",
          "url",
          "record_state",
          "supports",
          "limits"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^CS-W19-S[0-9]{3}$"
          },
          "subject": {
            "type": "string",
            "minLength": 3
          },
          "source_class": {
            "type": "string",
            "minLength": 5
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "record_state": {
            "type": "string",
            "minLength": 5
          },
          "supports": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
