  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "title",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_wave_id",
    "parent_release_sha256",
    "purpose",
    "counts",
    "supported_trace",
    "matched_controls",
    "sources",
    "external_review_export_update",
    "acquisition_lanes",
