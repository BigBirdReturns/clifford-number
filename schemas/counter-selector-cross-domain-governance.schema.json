        },
        "complete_operator_finding": {
          "const": false
        },
        "field_test_eligible": {
          "const": false
        },
        "contact_authorized": {
          "const": false
        },
        "public_identity_profile_authorized": {
          "const": false
        },
        "graph_effect": {
          "const": "none"
        }
