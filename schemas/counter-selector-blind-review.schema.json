{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/counter-selector-blind-review.schema.json",
  "title": "Counter-Selector blind review record",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "packet_id",
    "blind_token",
    "review_passes",
    "dimension_vector",
    "synthesis",
    "disposition",
    "field_test_eligible",
    "operator_finding",
    "graph_effect"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-blind-review@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W04-B01"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^CS-BLIND-[0-9]{4}$"
    },
    "blind_token": {
      "type": "string",
      "pattern": "^CS-BP[0-9]{4}$"
    },
    "review_passes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "dimension_vector": {
      "type": "object",
      "required": [
        "support_adjusted_surplus",
        "cross_domain_transfer",
        "exception_handling",
        "custody",
        "model_elasticity",
        "governed_capacity",
        "non_zero_sum_orientation",
        "epistemic_restraint"
      ],
      "additionalProperties": {
        "enum": [
          "bounded_support",
          "not_tested",
          "not_tested_support_ledger_missing",
          "insufficient_handoff_receipt",
          "not_attributable_from_system_packet"
        ]
      }
    },
    "synthesis": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "minLength": 1
    },
    "field_test_eligible": {
      "const": false
    },
    "operator_finding": {
      "const": false
    },
    "promotion_generated": {
      "const": false
    },
    "person_ranking_generated": {
      "const": false
    },
    "public_identity_release_authorized": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    }
  },
  "additionalProperties": true
}
