{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-support-adjusted-surplus.schema.json",
  "title": "Counter-Selector support-adjusted surplus matched-control audit",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "observed_at",
    "status",
    "candidate",
    "counts",
    "source_records",
    "comparator_lanes",
    "support_adjusted_surplus_adjudication",
    "independent_review",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-support-adjusted-surplus@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W25-SA-01"
    },
    "status": {
      "const": "matched_control_attack_completed_support_adjusted_surplus_unresolved"
    },
    "graph_effect": {
      "const": "none"
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "supported_dimensions",
        "unresolved_dimensions",
        "support_adjusted_surplus_state",
        "complete_operator_finding",
        "field_test_eligible",
        "graph_effect"
      ]
    },
    "counts": {
      "type": "object"
    },
    "source_records": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12
    },
    "comparator_lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "support_adjusted_surplus_adjudication": {
      "type": "object"
    },
    "independent_review": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
