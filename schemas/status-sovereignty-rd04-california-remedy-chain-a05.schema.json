{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status-sovereignty-rd04-california-remedy-chain-a05.schema.json",
  "title": "SSC RD-04 A05 California CalFresh remedy-chain acquisition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "lane_id",
    "execution_id",
    "issue",
    "as_of",
    "title",
    "status",
    "parent",
    "unit_contract",
    "source_ledger",
    "stages",
    "program_specific_aggregates",
    "cross_program_aggregates",
    "anti_join_law",
    "counts",
    "current_result",
    "next_handoff",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "ssc-rd04-a05-core@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "lane_id": { "const": "SSC-RD04" },
    "execution_id": { "const": "SSC-RD04-SNAP-A05" },
    "issue": { "const": 708 },
    "as_of": { "const": "2026-08-02" },
    "title": { "type": "string", "minLength": 20 },
    "status": { "const": "complete_bounded_procedural_chain_and_aggregate_throughput_case_level_join_absent" },
    "parent": {
      "type": "object",
      "required": ["execution_id", "core_path", "release_manifest_path", "release_sha256", "selected_state", "highest_coverage_set", "substantive_tiebreaker", "state_selection_reopened"]
    },
    "unit_contract": {
      "type": "object",
      "required": ["state", "program", "procedure_as_of", "aggregate_period", "unit", "one_linked_case_cohort", "joins_authorized", "outside_human_dependency"]
    },
    "source_ledger": { "type": "object" },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["stage_id", "title", "procedure_state", "aggregate_state", "case_level_state", "source_ids", "finding", "missing_join", "values", "boundaries"],
        "properties": {
          "stage_id": { "pattern": "^A05-S[1-7]$" },
          "procedure_state": { "enum": ["published_procedure", "not_observed"] },
          "aggregate_state": { "enum": ["program_specific_aggregate", "cross_program_aggregate", "not_observed"] },
          "case_level_state": { "const": "not_observed" }
        }
      }
    },
    "program_specific_aggregates": { "type": "object" },
    "cross_program_aggregates": { "type": "object" },
    "anti_join_law": { "type": "object" },
    "counts": { "type": "object" },
    "current_result": { "type": "object" },
    "next_handoff": { "type": "object" },
    "boundaries": { "type": "object" }
  }
}
