{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-targeted-receipts.schema.json",
  "title": "Counter-Selector targeted receipt acquisition",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "status",
    "counts",
    "candidate_updates",
    "sources",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-targeted-receipt-acquisition@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W16-TR-01"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "targeted_receipts_acquired_four_person_support_updates_no_field_test"
    },
    "publication_status": {
      "const": "staged_nonpublic_source_custody"
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "candidate_updates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
