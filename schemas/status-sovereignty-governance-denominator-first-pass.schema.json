{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-governance-denominator-first-pass.schema.json",
  "title": "Status-for-sovereignty governance denominator first pass",
  "type": "object",
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "selection_contract",
    "sources",
    "governance_denominator",
    "mechanism_test",
    "open_denominators",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "status-sovereignty-governance-denominator-first-pass@1"
    },
    "hypothesis_id": {
      "const": "SSC-H01"
    },
    "issue": {
      "const": 544
    },
    "observation_id": {
      "const": "SSC-OBS-0018"
    },
    "lane_id": {
      "const": "SSC-F04"
    },
    "authority": {
      "const": "source_acquisition_only_not_review_or_adjudication"
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SSC-F04-ACES-S00[1-4]$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "source_class": {"type": "string", "minLength": 1},
          "retrieved_facts": {
            "type": "array",
            "minItems": 3,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "open_denominators": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
