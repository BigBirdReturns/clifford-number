{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-batch02-acquisition.schema.json",
  "title": "Counter-Selector Batch 02 acquisition record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "blind_token",
    "denominator_class",
    "public_label",
    "source_record_id",
    "source_ids",
    "acquisition_state",
    "qualification",
    "packet_kind",
    "artifact_summary",
    "missing_receipts",
    "falsifier",
    "review_state",
    "blind_packet_ready"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^CS-C\\d{4}$"
    },
    "blind_token": {
      "type": "string",
      "pattern": "^CS-BP\\d{4}$"
    },
    "denominator_class": {
      "enum": [
        "positive_candidate_operators",
        "false_positive_outsider_genius_candidates",
        "ordinary_specialists",
        "high_status_selected_operators",
        "repair_capable_partnerships",
        "brittle_or_failed_partnerships"
      ]
    },
    "public_label": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^K0-W\\d{2}-R\\d{3}$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CS-W07-S\\d{3}$"
      }
    },
    "acquisition_state": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "enum": [
        "partial_not_blind_ready",
        "qualifying_for_blind_packet"
      ]
    },
    "packet_kind": {
      "enum": [
        "none",
        "operator_artifact_packet",
        "system_mechanism_packet",
        "system_failure_packet"
      ]
    },
    "artifact_summary": {
      "type": "string",
      "minLength": 1
    },
    "missing_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsifier": {
      "type": "string",
      "minLength": 1
    },
    "review_state": {
      "enum": [
        "partial_acquisition_retained",
        "blind_packet_ready_not_reviewed"
      ]
    },
    "blind_packet_ready": {
      "type": "boolean"
    }
  }
}
