{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.axm.tools/schemas/status-sovereignty-observation.schema.json",
  "title": "Status-for-sovereignty observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "lane_id",
    "jurisdiction",
    "time_window",
    "protected_center",
    "affected_population_or_institution",
    "status_order_claim",
    "patriotic_or_security_frame",
    "qualified_knower_or_evidence",
    "epistemic_reclassification",
    "counterpower_function",
    "counterpower_action",
    "selector",
    "option_universe",
    "public_conversion_instrument",
    "public_contribution",
    "private_capacity_or_right",
    "conditional_incorporation",
    "counterfactual_foreclosure",
    "material_consequence",
    "correction_substitution_exit",
    "observed_facts",
    "working_interpretation",
    "alternative_explanations",
    "counterevidence",
    "source_ids",
    "disposition",
    "review_state",
    "graph_effect"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^SSC-OBS-[0-9]{4,}$"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^SSC-F(0[1-9]|1[0-6])$"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "time_window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "protected_center": {
      "type": "string",
      "minLength": 1
    },
    "affected_population_or_institution": {
      "type": "string",
      "minLength": 1
    },
    "status_order_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "patriotic_or_security_frame": {
      "type": [
        "string",
        "null"
      ]
    },
    "qualified_knower_or_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "epistemic_reclassification": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterpower_function": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterpower_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "option_universe": {
      "type": "object"
    },
    "public_conversion_instrument": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_contribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "private_capacity_or_right": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditional_incorporation": {
      "type": [
        "string",
        "null"
      ]
    },
    "counterfactual_foreclosure": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_consequence": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_substitution_exit": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_interpretation": {
      "type": [
        "string",
        "null"
      ]
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "disposition": {
      "enum": [
        "supported_bounded_compact",
        "partial_functional_convergence",
        "heterogeneous_coalition_limited_overlap",
        "ordinary_patriotic_or_industrial_policy",
        "racial_hierarchy_unsupported",
        "capital_conversion_unsupported",
        "bounded_non_link",
        "falsified",
        "source_restricted",
        "source_unavailable",
        "requires_additional_acquisition"
      ]
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "maintainer_reviewed",
        "second_party_reviewed",
        "adjudicated"
      ]
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
