{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-model-update-handoff.schema.json",
  "title": "Counter-Selector model-update and handoff audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "observed_at",
    "title",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_wave_id",
    "parent_release_sha256",
    "purpose",
    "counts",
    "candidate_state",
    "source_records",
    "model_elasticity_adjudication",
    "handoff_adjudication",
    "support_adjusted_surplus_adjudication",
    "independent_review",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-model-update-handoff-audit@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W24-MH-01"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "type": "string",
      "minLength": 1
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_wave_id": {
      "const": "CS-W23-FR-01"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object"
    },
    "candidate_state": {
      "type": "object"
    },
    "source_records": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "model_elasticity_adjudication": {
      "type": "object"
    },
    "handoff_adjudication": {
      "type": "object"
    },
    "support_adjusted_surplus_adjudication": {
      "type": "object"
    },
    "independent_review": {
      "type": "object"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "object"
    }
  }
}
