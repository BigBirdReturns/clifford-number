{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/counter-selector-function-attribution-fanout.schema.json",
  "title": "Counter-Selector function-to-person attribution fan-out",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "title",
    "status",
    "publication_status",
    "parent_main_sha",
    "parent_release_sha256",
    "purpose",
    "counts",
    "function_packets",
    "person_traces",
    "identity_blocks",
    "external_review_packets",
    "acquisition_lanes",
    "sources",
    "next_action",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-function-attribution-fanout@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W17-FA-01"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "four_public_record_person_traces_attributed_six_external_review_packets_prepared_zero_external_reviews"
    },
    "publication_status": {
      "const": "staged_nonpublic_source_custody"
    },
    "parent_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "parent_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "function_packets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object"
      }
    },
    "person_traces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object"
      }
    },
    "identity_blocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "external_review_packets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object"
      }
    },
    "acquisition_lanes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "object"
    }
  }
}
