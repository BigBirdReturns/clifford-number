{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-observability-pivot.schema.json",
  "title": "Counter-Selector observability-first intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "wave_id",
    "as_of",
    "observed_at",
    "title",
    "status",
    "purpose",
    "pivot_trigger",
    "counts",
    "packets",
    "review_plan",
    "boundaries",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "counter-selector-observability-pivot@1"
    },
    "program_id": {
      "const": "counter-selector-v1"
    },
    "wave_id": {
      "const": "CS-W26-OP-01"
    },
    "as_of": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "const": "observability_pivot_seeded_four_graph_inert_packets_zero_findings"
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "pivot_trigger": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "packets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "packet_id",
          "public_label",
          "candidate_type",
          "source_identity",
          "identity_status",
          "domains",
          "source_records",
          "observable_gate_surfaces",
          "matched_countermodels",
          "required_next_receipts"
        ]
      }
    },
    "review_plan": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    },
    "next_action": {
      "type": "string"
    }
  }
}
