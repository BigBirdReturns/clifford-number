{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clifford-number.local/schemas/status-sovereignty-rd-wave03-rd02-leaf-replay.schema.json",
  "title": "SSC RD-02 Wave-03 admitted Stifel approval source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "class_id",
    "issue",
    "as_of",
    "source_id",
    "source_type",
    "source_title",
    "publication_date",
    "publisher",
    "requested_url",
    "unit_binding",
    "exact_custody",
    "admitted_observations",
    "class_field_effect",
    "unresolved_limits",
