      "properties": {
        "unit_ordinal": {
          "const": 15
        },
        "unit_id": {
          "const": "SBICCT-FIRST-COHORT-15"
        },
        "frozen_legal_vehicle": {
          "const": "Stifel North Atlantic AM-Forward, LP"
        },
        "public_fund_name_in_source": {
          "const": "Stifel North Atlantic AM-Forward Fund"
        },
        "exact_frozen_legal_vehicle_string_present": {
          "const": false
        },
        "identity_relation": {
          "type": "string"
        }
      }
    },
    "exact_custody": {
      "type": "object"
    },
    "admitted_observations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "class_field_effect": {
      "type": "object"
    },
    "unresolved_limits": {
      "type": "object"
    },
    "source_disposition": {
      "type": "object",
      "required": [
        "admitted_source",
        "admitted_observations",
        "lifecycle_events_for_rd02_c05_observed",
        "fields_terminally_closed",
        "row_terminally_closed",
        "class_closed"
