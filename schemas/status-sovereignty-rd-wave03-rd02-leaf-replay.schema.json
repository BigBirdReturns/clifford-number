      "properties": {
        "admitted_source": {
          "const": true
        },
        "admitted_observations": {
          "const": 7
        },
        "lifecycle_events_for_rd02_c05_observed": {
          "const": 0
        },
        "fields_terminally_closed": {
          "const": 0
        },
        "row_terminally_closed": {
          "const": false
        },
        "class_closed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "authority_boundaries": {
      "type": "object"
    }
