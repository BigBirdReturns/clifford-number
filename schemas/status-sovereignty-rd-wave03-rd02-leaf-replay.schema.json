    "issue": {
      "const": 1015
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_id": {
      "const": "STIFEL-AM-FORWARD-2024-FINAL-APPROVAL"
    },
    "source_type": {
      "const": "issuer_press_release_pdf"
    },
    "source_title": {
      "type": "string"
    },
    "publication_date": {
      "const": "2024-10-22"
    },
    "publisher": {
      "const": "Stifel Financial Corp."
    },
    "requested_url": {
      "const": "https://www.stifel.com/docs/pdf/pressreleases/2024/Stifel-SBA-Approval-for-10.22.24.pdf"
    },
    "unit_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_ordinal",
        "unit_id",
        "frozen_legal_vehicle",
        "public_fund_name_in_source",
        "exact_frozen_legal_vehicle_string_present",
        "identity_relation"
