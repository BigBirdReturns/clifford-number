{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/status-sovereignty-institutional-gate-first-pass.schema.json",
  "title": "SSC-F02 institutional-gate first pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "issue",
    "observation_id",
    "lane_id",
    "as_of",
    "title",
    "status",
    "authority",
    "selection_contract",
    "sources",
    "four_gate_first_pass",
    "open_denominators",
    "candidate_terminal_states",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "status-sovereignty-institutional-gate-first-pass@1" },
    "hypothesis_id": { "const": "SSC-H01" },
    "issue": { "const": 543 },
    "observation_id": { "const": "SSC-OBS-0016" },
    "lane_id": { "const": "SSC-F02" },
    "as_of": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "candidate_institutional_gate_selected_source_denominator_incomplete" },
    "authority": { "const": "source_acquisition_only_not_review_or_adjudication" },
    "selection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_universe", "selection_reason", "selected_because_expected_to_confirm_hypothesis"],
      "properties": {
        "declared_universe": { "type": "string", "minLength": 1 },
        "selection_reason": { "type": "string", "minLength": 1 },
        "selected_because_expected_to_confirm_hypothesis": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "source_class", "retrieved_facts"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SSC-F02-SNAP-S[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "source_class": { "type": "string", "minLength": 1 },
          "retrieved_facts": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "four_gate_first_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SSC-G1_status_and_deservingness",
        "SSC-G2_epistemic_admissibility",
        "SSC-G3_material_conversion",
        "SSC-G4_correction_monopoly"
      ],
      "properties": {
        "SSC-G1_status_and_deservingness": { "const": "supported_bounded_frame" },
        "SSC-G2_epistemic_admissibility": { "const": "candidate_selector_variation_observed" },
        "SSC-G3_material_conversion": { "const": "benefit_time_limit_and_disqualification_instrument_observed" },
        "SSC-G4_correction_monopoly": { "const": "formal_fair_hearing_observed_practical_effectiveness_unresolved" }
      }
    },
    "open_denominators": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
    "candidate_terminal_states": { "type": "array", "minItems": 9, "items": { "type": "string", "minLength": 1 } },
    "current_result": { "type": "object" },
    "boundaries": { "type": "object" }
  }
}
