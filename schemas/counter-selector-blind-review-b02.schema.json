{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counter-selector-blind-review-b02.schema.json",
  "title": "Counter-Selector Batch 02 blind review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "blind_token",
    "packet_kind",
    "review_authority",
    "historical_class",
    "review_passes",
    "dimension_vector",
    "synthesis",
    "disposition",
    "analysis_class_recommendation",
    "new_bounded_dimension_supports",
    "field_test_eligible",
    "operator_finding",
    "person_or_partnership_finding",
    "graph_effect"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^CS-BLIND-[0-9]{4}$"
    },
    "blind_token": {
      "type": "string",
      "pattern": "^CS-BP[0-9]{4}$"
    },
    "packet_kind": {
      "enum": [
        "operator_artifact_packet",
        "system_mechanism_packet",
        "system_failure_packet"
      ]
    },
    "review_authority": {
      "type": "string"
    },
    "historical_class": {
      "type": "string"
    },
    "review_passes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "reviewer_role",
          "fresh_context",
          "external_independence_claimed",
          "conclusion",
          "observations",
          "countermodels"
        ],
        "properties": {
          "review_id": {
            "type": "string"
          },
          "reviewer_role": {
            "enum": [
              "artifact_validity",
              "adversarial_countermodel"
            ]
          },
          "fresh_context": {
            "const": true
          },
          "external_independence_claimed": {
            "const": false
          },
          "conclusion": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "countermodels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dimension_vector": {
      "type": "object",
      "required": [
        "support_adjusted_surplus",
        "cross_domain_transfer",
        "exception_handling",
        "custody",
        "model_elasticity",
        "governed_capacity",
        "non_zero_sum_orientation",
        "epistemic_restraint"
      ],
      "additionalProperties": false,
      "properties": {
        "support_adjusted_surplus": {
          "type": "string"
        },
        "cross_domain_transfer": {
          "type": "string"
        },
        "exception_handling": {
          "type": "string"
        },
        "custody": {
          "type": "string"
        },
        "model_elasticity": {
          "type": "string"
        },
        "governed_capacity": {
          "type": "string"
        },
        "non_zero_sum_orientation": {
          "type": "string"
        },
        "epistemic_restraint": {
          "type": "string"
        }
      }
    },
    "mechanism_observations": {
      "type": [
        "object",
        "null"
      ]
    },
    "synthesis": {
      "type": "string"
    },
    "disposition": {
      "type": "string"
    },
    "analysis_class_recommendation": {
      "type": "object",
      "required": [
        "historical_class",
        "recommended_analysis_class",
        "rewrites_historical_class"
      ],
      "properties": {
        "historical_class": {
          "type": "string"
        },
        "recommended_analysis_class": {
          "type": "string"
        },
        "rewrites_historical_class": {
          "const": false
        }
      }
    },
    "new_bounded_dimension_supports": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "field_test_eligible": {
      "const": false
    },
    "operator_finding": {
      "const": false
    },
    "person_or_partnership_finding": {
      "const": false
    },
    "graph_effect": {
      "const": "none"
    }
  }
}
