{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence.axm.tools/schemas/status-sovereignty-targeted-acquisition.schema.json",
  "title": "Status-for-sovereignty targeted acquisition supplement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "wave_id",
    "acquisition_id",
    "parent_review_id",
    "as_of",
    "status",
    "title",
    "authority_contract",
    "selection_contract",
    "counts",
    "obligations",
    "current_result",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "status-sovereignty-targeted-acquisition@1"
    },
    "hypothesis_id": {
      "const": "SSC-H01"
    },
    "wave_id": {
      "const": "SSC-W01"
    },
    "acquisition_id": {
      "const": "SSC-W01-TA01"
    },
    "parent_review_id": {
      "const": "SSC-W01-MR01"
    },
    "as_of": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "authority_contract": {
      "type": "object"
    },
    "selection_contract": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "obligations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "lane_id",
          "prior_disposition",
          "maintainer_review_state",
          "status",
          "required_record",
          "recovered",
          "remaining_absences",
          "source_ids",
          "disposition_effect",
          "review_effect",
          "second_party_effect",
          "publication_effect",
          "graph_effect"
        ],
        "properties": {
          "observation_id": {
            "pattern": "^SSC-OBS-000[789]$"
          },
          "lane_id": {
            "enum": [
              "SSC-F09",
              "SSC-F10"
            ]
          },
          "prior_disposition": {
            "const": "requires_additional_acquisition"
          },
          "maintainer_review_state": {
            "const": "maintainer_reviewed"
          },
          "status": {
            "const": "partially_repaired_open"
          },
          "required_record": {
            "type": "string"
          },
          "recovered": {
            "type": "object"
          },
          "remaining_absences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "disposition_effect": {
            "const": "none"
          },
          "review_effect": {
            "const": "none"
          },
          "second_party_effect": {
            "const": "none"
          },
          "publication_effect": {
            "const": "none"
          },
          "graph_effect": {
            "const": "none"
          }
        },
        "additionalProperties": false
      }
    },
    "current_result": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    }
  }
}
