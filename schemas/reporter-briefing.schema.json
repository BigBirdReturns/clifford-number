{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/reporter-briefing.schema.json",
  "title": "Reporter briefing",
  "description": "A finite, non-narrative projection of a compiled case. The source specifies categorical orientation, a claim-derived decision sequence, an evidence matrix, counterweights, and a reporting queue. Factual content resolves to canonical claim or event references.",
  "type": "object",
  "required": [
    "schema_version",
    "briefing_id",
    "case_id",
    "title",
    "dek",
    "as_of",
    "published_at",
    "audience",
    "output_path",
    "case_href",
    "graph_effect",
    "conclusion_generated",
    "publication",
    "working_proposition",
    "boundary",
    "records_target",
    "orientation",
    "sequence",
    "matrix",
    "threads",
    "controls",
    "workplan"
  ],
  "properties": {
    "schema_version": { "const": "reporter-briefing@2" },
    "briefing_id": { "$ref": "#/$defs/stableId" },
    "case_id": { "$ref": "#/$defs/stableId" },
    "title": { "$ref": "#/$defs/nonempty" },
    "dek": { "$ref": "#/$defs/nonempty" },
    "as_of": { "type": "string", "format": "date" },
    "published_at": { "type": "string", "format": "date" },
    "audience": { "$ref": "#/$defs/nonempty" },
    "output_path": { "type": "string", "pattern": "^briefs/[a-z0-9][a-z0-9._/-]*\\.html$" },
    "case_href": { "type": "string", "pattern": "^\\.\\./#case/[a-z0-9][a-z0-9._-]*$" },
    "graph_effect": { "const": "none" },
    "conclusion_generated": { "const": false },
    "publication": { "$ref": "#/$defs/publication" },
    "working_proposition": { "$ref": "#/$defs/claimReference" },
    "boundary": { "$ref": "#/$defs/claimReference" },
    "records_target": { "$ref": "#/$defs/claimReference" },
    "orientation": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/dimension" },
        "y": { "$ref": "#/$defs/dimension" }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["lanes", "items"],
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/lane" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sequenceItem" }
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "object",
      "required": ["empty_state_label", "columns"],
      "properties": {
        "empty_state_label": { "$ref": "#/$defs/nonempty" },
        "columns": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/matrixColumn" }
        }
      },
      "additionalProperties": false
    },
    "threads": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/thread" }
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/control" }
    },
    "workplan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workItem" }
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "question"],
        "properties": {
          "term": { "$ref": "#/$defs/nonempty" },
          "question": { "$ref": "#/$defs/nonempty" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "claimIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "claimReference": {
      "type": "object",
      "required": ["claim_id"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["version", "status", "correction_route", "history"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "status": { "enum": ["review_required", "approved", "superseded", "withdrawn"] },
        "reviewer": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date" },
        "correction_route": { "type": "string", "format": "uri" },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["version", "published_at", "status", "change"],
            "properties": {
              "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
              "published_at": { "type": "string", "format": "date" },
              "status": { "enum": ["review_required", "approved", "superseded", "withdrawn"] },
              "change": { "$ref": "#/$defs/nonempty" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["id", "label", "levels"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "label": { "$ref": "#/$defs/nonempty" },
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/nonempty" },
              "label": { "$ref": "#/$defs/nonempty" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "label": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "sequenceItem": {
      "type": "object",
      "required": ["event_id", "lane"],
      "properties": {
        "event_id": { "$ref": "#/$defs/nonempty" },
        "lane": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "matrixColumn": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "label": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["x_level", "y_level"],
      "properties": {
        "x_level": { "$ref": "#/$defs/nonempty" },
        "y_level": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "claimCell": {
      "type": "object",
      "required": ["column_id", "claim_ids"],
      "properties": {
        "column_id": { "$ref": "#/$defs/nonempty" },
        "claim_ids": { "$ref": "#/$defs/claimIdList" }
      },
      "additionalProperties": false
    },
    "recordCell": {
      "type": "object",
      "required": ["column_id", "record_target"],
      "properties": {
        "column_id": { "$ref": "#/$defs/nonempty" },
        "record_target": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    },
    "notApplicableCell": {
      "type": "object",
      "required": ["column_id", "not_applicable"],
      "properties": {
        "column_id": { "$ref": "#/$defs/nonempty" },
        "not_applicable": { "const": true }
      },
      "additionalProperties": false
    },
    "thread": {
      "type": "object",
      "required": ["id", "title", "subtitle", "placement", "cells"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "number": { "$ref": "#/$defs/nonempty" },
        "title": { "$ref": "#/$defs/nonempty" },
        "subtitle": { "$ref": "#/$defs/nonempty" },
        "placement": { "$ref": "#/$defs/placement" },
        "cells": {
          "type": "array",
          "minItems": 4,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/claimCell" },
              { "$ref": "#/$defs/recordCell" },
              { "$ref": "#/$defs/notApplicableCell" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["id", "title", "claim_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/nonempty" },
        "claim_ids": { "$ref": "#/$defs/claimIdList" }
      },
      "additionalProperties": false
    },
    "workItem": {
      "type": "object",
      "required": ["id", "priority", "title", "thread_ids", "date_window", "custodians", "records", "routes", "decision_test"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "priority": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonempty" },
        "thread_ids": { "$ref": "#/$defs/stringList" },
        "date_window": { "$ref": "#/$defs/nonempty" },
        "custodians": { "$ref": "#/$defs/stringList" },
        "records": { "$ref": "#/$defs/stringList" },
        "routes": { "$ref": "#/$defs/stringList" },
        "decision_test": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
