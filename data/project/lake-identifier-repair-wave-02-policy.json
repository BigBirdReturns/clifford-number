{
  "schema_version": "lake-identifier-repair-wave-02-policy@1",
  "program_key": "CN-LAKE-ID-REPAIR-W02",
  "as_of": "2026-07-29",
  "purpose": "Repair the highest-priority projection-without-source identifier defects without treating an unqualified local id as a global join key, inventing evidence, or requiring an unspecified human to authorize a reversible source registration.",
  "input_paths": [
    "build/lake-index/id-gaps.jsonl",
    "build/lake-index/objects.jsonl",
    "build/lake-actions/identifier-repair-queue.json",
    "build/core-thesis/index.json",
    "build/estate-game-trails/manifest.json",
    "docs/clifford-number-master.md"
  ],
  "target_gap_class": "projection_id_without_source",
  "target_identifier_keys": [
    "claim_id",
    "event_id",
    "object_id",
    "trail_id"
  ],
  "local_only_identifier_keys": [
    "id"
  ],
  "source_registry_path": "data/project/lake-identifier-source-registry-wave-02.jsonl",
  "migration_receipt_path": "data/project/lake-identifier-repair-wave-02.json",
  "plan_path": "build/lake-actions/identifier-repair-wave-02.json",
  "reconciliation_path": "build/lake-actions/identifier-repair-wave-02-reconciliation.json",
  "report_path": "reports/lake-identifier-repair-wave-02.md",
  "reconciliation_report_path": "reports/lake-identifier-repair-wave-02-reconciliation.md",
  "registration_rules": [
    {
      "rule_key": "legacy-master-claim-projection",
      "identifier_keys": ["claim_id"],
      "path_equals": ["build/migrated-claims.jsonl"],
      "registration_status": "derived_identifier_with_declared_source_lineage",
      "lineage_status": "legacy_document_row_is_the_declared_source",
      "source_locators": [
        "docs/clifford-number-master.md",
        "tools/ingest-master.mjs",
        "build/migration-summary.json"
      ],
      "native_source_migration_required": false,
      "confidence": "high"
    },
    {
      "rule_key": "legacy-uk-ai-case-projection",
      "identifier_keys": ["claim_id", "event_id"],
      "path_equals": ["build/cases/uk-ai-policy.json"],
      "registration_status": "legacy_projection_identifier_registered",
      "lineage_status": "identifier_registered_but_native_case_ledger_migration_remains_required",
      "source_locators": [
        "docs/clifford-number-master.md",
        "build/migrated-claims.jsonl",
        "build/cases/uk-ai-policy.json"
      ],
      "native_source_migration_required": true,
      "confidence": "moderate"
    },
    {
      "rule_key": "core-thesis-derived-object",
      "identifier_keys": ["object_id"],
      "path_prefixes": ["build/core-thesis/", "reports/core-thesis/"],
      "registration_status": "generated_identifier_with_declared_builder_lineage",
      "lineage_status": "core_thesis_entrypoint_and_product_path_define_the_projection",
      "source_locators": [
        "build/core-thesis/index.json",
        "tools/build-core-thesis.mjs"
      ],
      "native_source_migration_required": false,
      "confidence": "high"
    },
    {
      "rule_key": "estate-game-trail-derived-identifier",
      "identifier_keys": ["trail_id"],
      "path_prefixes": ["build/estate-game-trails/"],
      "registration_status": "generated_identifier_with_declared_builder_lineage",
      "lineage_status": "game_trail_manifest_and_source_route_registry_define_the_projection",
      "source_locators": [
        "build/estate-game-trails/manifest.json",
        "data/estates/source-route-registry.json",
        "tools/build-estate-game-trails.mjs"
      ],
      "native_source_migration_required": false,
      "confidence": "high"
    }
  ],
  "fallback_registration": {
    "registration_status": "unresolved_projection_identifier_registered",
    "lineage_status": "projection_paths_are_known_but_native_source_lineage_is_not_yet_resolved",
    "native_source_migration_required": true,
    "confidence": "low"
  },
  "decision_law": {
    "review_required_to_decide": false,
    "missing_reviewer_blocks_registration": false,
    "unresolved_registration_may_be_called_source_truth": false,
    "bare_local_id_may_be_used_as_global_identity": false,
    "correction_mode": "append_preserving_supersession"
  },
  "boundaries": {
    "source_registration_proves_evidence_truth": false,
    "source_registration_resolves_identity": false,
    "same_identifier_string_proves_same_entity": false,
    "legacy_projection_registration_completes_native_case_migration": false,
    "generated_identifier_registration_is_independent_evidence": false,
    "graph_effect": "none"
  }
}
