    "workflow_start_time_qualifies_as_source_observation": false,
    "filesystem_mtime_qualifies_as_source_observation": false,
    "current_time_substitution_qualifies": false,
    "leap_second_state_unknown_qualifies": false
  },
  "clock_source_profile_rules": {
    "authenticated_nts_ntp_clock": {
      "required_fields": [
