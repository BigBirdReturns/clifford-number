      "computed_age_upper_bound_seconds",
      "result",
      "evaluated_at_utc",
      "evaluation_body_sha256",
      "evaluation_custody_locator"
    ],
    "allowed_results": [
      "pass",
      "fail",
      "indeterminate"
    ],
    "dns_must_be_definitely_unexpired_at_request": true,
    "certificate_validation_interval_must_be_definitely_inside_certificate_validity": true,
    "revocation_and_ct_evidence_must_meet_named_policy": true,
    "source_record_freshness_must_meet_named_policy_if_claimed_current": true,
    "indeterminate_freshness_qualifies": false,
    "expired_dns_answer_qualifies": false,
    "stale_revocation_or_ct_evidence_qualifies": false,
    "certificate_check_without_uncertainty_qualifies": false
  },
  "cross_object_rules": {
