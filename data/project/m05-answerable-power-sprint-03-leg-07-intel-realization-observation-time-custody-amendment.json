    "dual_independent_authenticated_clocks": {
      "required_fields": [
        "clock_a_receipt_sha256",
        "clock_b_receipt_sha256",
        "clock_a_authority_identifier",
        "clock_b_authority_identifier",
        "maximum_allowed_disagreement_seconds",
        "observed_disagreement_seconds"
      ],
      "clock_authorities_must_be_independent": true,
      "observed_disagreement_must_not_exceed_bound": true,
      "same_authority_twice_qualifies": false
    }
  },
  "monotonic_mapping_rules": {
    "mapping_required_fields": [
      "mapping_version",
      "monotonic_clock_identifier",
      "monotonic_sample_start",
      "monotonic_sample_end",
      "wall_clock_start_utc",
      "wall_clock_end_utc",
      "offset_seconds",
      "uncertainty_seconds",
      "mapping_body_sha256",
      "mapping_custody_locator"
    ],
    "monotonic_samples_must_be_non_decreasing": true,
    "wall_interval_must_cover_monotonic_interval": true,
    "clock_adjustment_events_inside_interval_must_be_preserved": true,
    "wall_clock_rollback_without_adjustment_receipt_qualifies": false,
    "monotonic_counter_reset_without_epoch_receipt_qualifies": false
  },
  "clock_adjustment_event_rules": {
    "required_fields": [
      "event_id",
      "event_type",
      "observed_at_utc",
      "magnitude_seconds",
      "pre_event_offset_seconds",
      "post_event_offset_seconds",
      "evidence_sha256",
      "evidence_custody_locator"
    ],
    "allowed_event_types": [
      "step_forward",
      "step_backward",
      "slew_started",
      "slew_completed",
      "leap_inserted",
      "leap_deleted",
      "smear_started",
      "smear_completed",
      "clock_source_changed",
      "holdover_started",
      "holdover_ended",
      "monotonic_epoch_reset"
    ],
    "every_step_slew_leap_smear_or_source_change_must_be_receipted": true,
    "unreceipted_backward_step_qualifies": false
  },
  "uncertainty_interval_rules": {
    "interval_definition": "[corrected_utc - uncertainty_seconds, corrected_utc + uncertainty_seconds]",
    "corrected_utc_definition": "declared_utc + clock_offset_seconds",
    "definitely_before_rule": "upper_bound_a < lower_bound_b",
    "definitely_after_rule": "lower_bound_a > upper_bound_b",
    "overlap_rule": "otherwise_intervals_overlap_or_order_is_indeterminate",
    "point_string_comparison_may_establish_order": false,
    "overlapping_intervals_may_be_promoted_to_ordered": false,
    "uncertainty_may_not_be_dropped_after_conversion": true
  },
  "temporal_reconciliation_rules": {
    "required_time_roles": [
      "source_origin_observation",
      "dns_observation",
      "dns_expiry",
      "connection_started",
      "connection_established",
      "tls_validation",
      "certificate_validity_check",
      "revocation_evidence_observation",
      "certificate_transparency_evidence_observation",
      "request_sent",
      "response_headers_received",
      "response_body_completed",
      "connection_closed",
      "freshness_evaluation"
    ],
    "each_time_role_requires_receipt_binding": true,
    "request_must_not_be_definitely_before_connection_established": true,
    "response_must_not_be_definitely_before_request": true,
    "body_completion_must_not_be_definitely_before_response_headers": true,
    "connection_close_must_not_be_definitely_before_body_completion": true,
    "tls_validation_time_must_reconcile_to_authenticated_tls_receipt": true,
    "source_native_timestamp_must_reconcile_to_exact_source_body": true,
    "ambiguous_or_overlapping_order_remains_indeterminate": true
  },
  "freshness_policy_rules": {
    "policy_required_fields": [
      "policy_id",
      "policy_version",
      "time_role",
      "maximum_age_seconds",
      "reference_time_role",
      "uncertainty_treatment",
      "failure_action",
      "policy_body_sha256",
      "policy_custody_locator"
    ],
    "evaluation_required_fields": [
