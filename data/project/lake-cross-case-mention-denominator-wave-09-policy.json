{
  "schema_version": "lake-cross-case-mention-denominator-wave-09-policy@1",
  "program_key": "CN-LAKE-CROSS-CASE-MENTION-W09",
  "as_of": "2026-07-29",
  "purpose": "Expand the zero-candidate structured-identity result into a complete exact source-bound mention denominator across every current native case, execute bounded graph-inert recurrence judgments from the evidence already present, and preserve ambiguous, under-custodied, and noncandidate states without waiting for an unspecified reviewer.",
  "case_scope": "all_case_directories_with_case_json",
  "baseline_receipt_path": "data/project/lake-cross-case-production-denominator-wave-08.json",
  "shared_identity_namespace": "clifford-number-public-entities-v1",
  "source_record_types": [
    "claims",
    "events",
    "relations",
    "beacons",
    "trails",
    "receipts"
  ],
  "text_scan": {
    "normalization": "unicode_nfc_ascii_lower_for_matching_only",
    "skip_machine_id_keys": true,
    "skip_url_and_hash_fields": true,
    "receipt_metadata_fields": ["label", "publisher", "title", "description", "notes", "snippet"],
    "minimum_case_insensitive_single_token_length": 5,
    "minimum_case_sensitive_acronym_length": 3,
    "multiword_labels_case_insensitive": true,
    "canonical_ids_exact_token_only": true,
    "fuzzy_matching_authorized": false,
    "generic_single_token_stoplist": [
      "agency",
      "army",
      "capital",
      "committee",
      "company",
      "council",
      "data",
      "defense",
      "department",
      "foundation",
      "government",
      "group",
      "institute",
      "lab",
      "labs",
      "ministry",
      "navy",
      "office",
      "security",
      "state",
      "systems",
      "university",
      "ventures"
    ]
  },
  "source_custody": {
    "public_locator_fields": ["url", "archive_url"],
    "minimum_distinct_source_families_for_independent_corroboration": 2,
    "judgment_or_open_evidence_is_recurrence_eligible": false,
    "receipt_metadata_with_public_locator_is_eligible": true
  },
  "lexicon_path": "build/cross-case-mention-lexicon-wave-09.json",
  "mention_registry_path": "data/project/lake-cross-case-mention-registry-wave-09.jsonl",
  "case_entity_registry_path": "data/project/lake-cross-case-mentioned-entity-registry-wave-09.jsonl",
  "pair_denominator_path": "data/project/lake-cross-case-mention-pair-denominator-wave-09.jsonl",
  "decision_registry_path": "data/project/lake-cross-case-mention-decision-registry-wave-09.jsonl",
  "decision_index_path": "build/cross-case-mention-decision-index-wave-09.json",
  "receipt_path": "data/project/lake-cross-case-mention-denominator-wave-09.json",
  "plan_path": "build/lake-actions/cross-case-mention-denominator-wave-09.json",
  "reconciliation_path": "build/lake-actions/cross-case-mention-denominator-wave-09-reconciliation.json",
  "report_path": "reports/lake-cross-case-mention-denominator-wave-09.md",
  "reconciliation_report_path": "reports/lake-cross-case-mention-denominator-wave-09-reconciliation.md",
  "expected": {
    "minimum_native_cases": 4,
    "minimum_case_pairs": 6,
    "minimum_text_leaves_scanned": 1,
    "minimum_exact_mentions": 1,
    "minimum_candidate_decisions": 0,
    "zero_candidates_is_valid": true,
    "active_projection_cross_case_join_authorized": false
  },
  "decision_law": {
    "review_required_to_decide": false,
    "missing_reviewer_blocks_bounded_judgment": false,
    "exact_unambiguous_canonical_or_alias_mention_required": true,
    "bilateral_public_custody_required_for_acceptance": true,
    "independent_source_families_raise_confidence_but_are_not_permission_to_decide": true,
    "same_text_without_canonical_resolution_authorizes_recurrence": false,
    "ambiguous_lexeme_authorizes_recurrence": false,
    "accepted_recurrence_merges_records": false,
    "accepted_recurrence_creates_relationship": false,
    "accepted_recurrence_creates_graph_edge": false,
    "accepted_recurrence_creates_hop": false,
    "correction_mode": "append_preserving_supersession"
  },
  "boundaries": {
    "exact_mention_proves_relationship": false,
    "repeated_mention_proves_coordination": false,
    "repeated_mention_proves_common_purpose": false,
    "receipt_metadata_mention_proves_subject_matter": false,
    "canonical_label_match_proves_evidence_truth": false,
    "zero_exact_mentions_proves_no_real_overlap": false,
    "accepted_recurrence_merges_records": false,
    "accepted_recurrence_creates_relationship": false,
    "accepted_recurrence_creates_graph_edge": false,
    "accepted_recurrence_creates_hop": false,
    "automatic_cross_case_join_authorized": false,
    "cross_case_graph_join_authorized": false,
    "cross_case_hop_creation_authorized": false,
    "active_projection_cross_case_join_authorized": false,
    "semantic_lake_complete": false,
    "evidence_truth_determined": false,
    "publication_cleared": false,
    "graph_effect": "none"
  }
}
