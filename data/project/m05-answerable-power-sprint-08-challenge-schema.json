{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/apc-a1-support-challenge-v1.json",
  "title": "APC A1 support challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "challenge_id",
    "submitted_at",
    "route",
    "category",
    "target_entry_id",
    "statement",
    "materiality",
    "requested_action",
    "evidence",
    "submitter",
    "declaration"
  ],
  "properties": {
    "schema_version": {
      "const": "apc-a1-support-challenge@1"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^A1C-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "route": {
      "enum": [
        "public",
        "protected"
      ]
    },
    "category": {
      "enum": [
        "identity_or_independence_failure",
        "undisclosed_material_conflict",
        "selection_capture_or_veto",
        "evidence_custody_break",
        "reproduction_or_output_failure",
        "material_reference_or_successor_change",
        "retaliation_or_chilling_effect",
        "challenge_suppression_or_docket_omission",
        "registry_or_signature_mismatch",
        "fraud_misrepresentation_or_omitted_failure"
      ]
    },
    "target_entry_id": {
      "type": "string",
      "pattern": "^A1E-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "statement": {
      "type": "string",
      "minLength": 20
    },
    "materiality": {
      "enum": [
        "nonmaterial",
        "material",
        "potentially_dispositive"
      ]
    },
    "requested_action": {
      "enum": [
        "notice",
        "challenge_state",
        "suspend",
        "revoke",
        "expire",
        "supersede",
        "reconsider"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "sha256"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 8
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "submitter": {
      "type": "object"
    },
    "declaration": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "route": {
            "const": "public"
          }
        }
      },
      "then": {
        "properties": {
          "submitter": {
            "required": [
              "name",
              "identity_uri",
              "signature_uri",
              "signature_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "const": "protected"
          }
        }
      },
      "then": {
        "properties": {
          "submitter": {
            "required": [
              "identity_digest_sha256",
              "identity_custodian_id",
              "custody_attestation_uri",
              "custody_attestation_sha256"
            ]
          }
        }
      }
    }
  ]
}
