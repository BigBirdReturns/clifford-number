{
  "schema_version": "m04g-source-ecology-v2-policy@1",
  "program_id": "M-04G",
  "sprint_id": "M05-SPRINT-03",
  "leg_id": "S03-L7",
  "as_of": "2026-07-26",
  "purpose": "Raise the frozen 96-route global circulation denominator to its health contract without deleting difficult sources, bypassing access controls, bulk-polling direct voice, or treating reachability as evidentiary sufficiency.",
  "denominator": {
    "expected_routes": 96,
    "expected_basins": 12,
    "expected_routes_per_basin": 8,
    "preserve_route_ids": true,
    "allow_route_deletion": false,
    "allow_direct_voice_bulk_polling": false
  },
  "health_contract": {
    "global_route_success_rate": 0.75,
    "global_content_success_rate": 0.65,
    "per_basin_route_success_rate": 0.5,
    "per_basin_content_success_rate": 0.5,
    "require_freshwater_content_per_basin": true,
    "require_discovery_or_archive_content_per_basin": true,
    "require_all_failures_classified": true,
    "required_healthy_basins": 12
  },
  "execution": {
    "global_concurrency": 6,
    "default_host_concurrency": 1,
    "default_host_interval_ms": 750,
    "default_timeout_ms": 20000,
    "slow_timeout_ms": 45000,
    "default_max_bytes": 524288,
    "large_document_max_bytes": 2097152,
    "attempts": 3,
    "retry_backoff_ms": [
      1500,
      5000,
      12000
    ],
    "respect_retry_after": true,
    "follow_safe_https_redirects": true,
    "refuse_https_downgrade": true,
    "metadata_fallback_counts_as_content": false
  },
  "global_tides": [
    {
      "tide_id": "GDELT-GLOBAL-SERIAL",
      "match": "gdelt",
      "mode": "globally_serialized",
      "expected_routes": 12,
      "expected_basins": 12,
      "max_concurrency": 1,
      "minimum_interval_ms": 6500,
      "timeout_ms": 30000,
      "heartbeat_minutes": 15,
      "publication_guard_minutes": 15,
      "heartbeat_offset_minutes": 1,
      "url_template": "https://storage.googleapis.com/data.gdeltproject.org/gdeltv5/weblegacy/ngrams/{timestamp}.toc.json.gz",
      "record_format": "jsonl_gzip",
      "minimum_locator_records": 1,
      "max_compressed_bytes": 16777216,
      "max_decompressed_bytes": 67108864,
      "deduplicate_identical_requests": true,
      "route_results_back_to_original_basins": true,
      "fallback_to_original_routes": false,
      "promotion_ceiling": "locator_only"
    }
  ],
  "host_policies": [
    {
      "match": "gdelt",
      "max_concurrency": 1,
      "minimum_interval_ms": 6500,
      "timeout_ms": 30000,
      "attempts": 4
