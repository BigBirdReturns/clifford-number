  "state_separation": {
    "execution_complete": "All expected jobs, route attempts, basin ledgers, and proof artifacts exist.",
    "route_healthy": "The route returned content or a bounded metadata fingerprint under the frozen policy.",
    "content_healthy": "The route returned bounded content; metadata-only results do not count.",
    "coverage_healthy": "Global and per-basin thresholds are satisfied with all failures classified.",
    "evidentiary_sufficiency": "Human adjudication determines whether the retrieved record closes a bounded proposition.",
    "answer_effectiveness": "Observed domain evidence determines whether APC-01 changes practical power."
