{
  "schema_version": "lake-canonical-subject-projection-wave-13-policy@1",
  "program_key": "CN-LAKE-CANONICAL-SUBJECT-W13",
  "as_of": "2026-07-29",
  "purpose": "Propagate accepted case-scoped local-to-canonical subject resolutions into compiled cases, the public catalog, browser search aliases, and reporter-briefing manifests while preserving every source subject ID and claim text and creating no relationship, participation, graph edge, hop, or automatic cross-case join.",
  "input_paths": [
    "build/briefings/index.json",
    "build/cases/index.json",
    "build/hop-graph.json",
    "build/public-catalog.json",
    "build/surface-graph.json",
    "data/canonical/actors.json",
    "data/canonical/aliases.json",
    "data/canonical/organizations.json",
    "data/ledger/participation.jsonl",
    "data/project/lake-local-canonical-resolution-registry-wave-12.jsonl",
    "data/project/lake-local-canonical-resolution-registry-wave-16.jsonl",
    "tools/build-hop-graph.mjs",
    "tools/build-public-catalog.mjs",
    "tools/compile-reporter-briefings.mjs",
    "tools/lib/case-ledger.mjs",
    "tools/lib/local-canonical-resolution.mjs",
    "tools/lib/report-waterline.mjs"
  ],
  "expected": {
    "current_resolution_rows": 29,
    "current_resolution_registry_files": 2,
    "minimum_compiled_cases": 4,
    "minimum_case_claim_subject_references": 1,
    "minimum_resolved_case_claim_subject_references": 272,
    "minimum_public_catalog_subjects": 1,
    "minimum_reporter_briefings": 2,
    "accepted_cross_case_identity_bridges": 0,
    "source_case_mutations": 0,
    "participation_delta": 0,
    "active_claim_delta": 0,
    "graph_edge_delta": 0,
    "hop_delta": 0
  },
  "projection_path": "build/canonical-subject-projection-wave-13.json",
  "plan_path": "build/lake-actions/canonical-subject-projection-wave-13.json",
  "reconciliation_path": "build/lake-actions/canonical-subject-projection-wave-13-reconciliation.json",
  "report_path": "reports/lake-canonical-subject-projection-wave-13.md",
  "reconciliation_report_path": "reports/lake-canonical-subject-projection-wave-13-reconciliation.md",
  "decision_law": {
    "review_required_to_decide": false,
    "missing_reviewer_blocks_projection": false,
    "resolution_scope_is_case_and_local_subject": true,
    "source_subject_id_must_be_preserved": true,
    "source_claim_text_must_be_preserved": true,
    "unresolved_subjects_must_remain_visible": true,
    "ambiguous_global_search_aliases_must_be_refused": true,
    "canonical_subject_metadata_may_be_added_to_generated_outputs": true,
    "object_identity_may_be_inferred": false,
    "projection_creates_relationship": false,
    "projection_creates_participation": false,
    "projection_creates_hop": false,
    "correction_mode": "append_preserving_supersession"
  },
  "boundaries": {
    "canonical_subject_proves_claim_truth": false,
    "canonical_subject_validates_every_case_claim": false,
    "local_resolution_merges_source_records": false,
    "search_alias_creates_identity_bridge": false,
    "briefing_subject_summary_creates_finding": false,
    "source_records_mutated": false,
    "source_records_merged": false,
    "relationship_created": false,
    "participation_created": false,
    "automatic_cross_case_join_authorized": false,
    "cross_case_graph_join_authorized": false,
    "cross_case_hop_creation_authorized": false,
    "evidence_truth_determined": false,
    "publication_cleared": false,
    "graph_effect": "none"
  }
}
