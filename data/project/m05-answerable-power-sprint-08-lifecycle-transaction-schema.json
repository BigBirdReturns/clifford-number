{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/apc-a1-support-lifecycle-transaction-v1.json",
  "title": "APC A1 support lifecycle transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "as_of",
    "entry",
    "transition",
    "basis",
    "decisions",
    "challenge_window",
    "registry_transaction",
    "declaration"
  ],
  "properties": {
    "schema_version": {
      "const": "apc-a1-support-lifecycle-transaction@1"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^A1L-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "entry": {
      "type": "object"
    },
    "transition": {
      "type": "object"
    },
    "basis": {
      "type": "object"
    },
    "decisions": {
      "type": "object"
    },
    "challenge_window": {
      "type": "object"
    },
    "registry_transaction": {
      "type": "object"
    },
    "declaration": {
      "type": "object"
    }
  }
}
