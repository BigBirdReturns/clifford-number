  "level_requirements": [
    {
      "level": "A0",
      "requirements": [
        "versioned reference package",
        "exact-byte release manifest",
        "deterministic build and validation",
        "public boundary statement"
      ]
    },
    {
      "level": "A1",
      "requirements": [
        "A0",
        "current non-self external attestor",
        "scope-bound independent reproduction receipt",
        "exact version and checksum receipt"
      ]
    },
    {
      "level": "A2",
      "requirements": [
        "A1",
        "current legal, privacy, ethics, and technical review",
        "scope-bound independent review observation",
        "binding affected-party approval",
        "formation, conflict, dissent, recall, and nonretaliation records"
      ]
    },
    {
      "level": "A3",
      "requirements": [
        "A2",
        "current approved real-person entry gate",
        "no-adverse shadow mode",
        "current independent binding stop authority",
        "frozen pilot preregistration",
        "scope-bound lawful shadow receipts"
      ]
    },
    {
      "level": "A4",
      "requirements": [
        "A3",
        "scope-bound prospective parallel-operation receipts",
        "complete comparator and failure denominator",
        "no live-decision influence"
      ]
    },
    {
      "level": "A5",
      "requirements": [
        "A4",
        "lawful rights-bearing live use",
        "scope-bound notice, access, pause, remedy, governance, exit, and value receipts as applicable",
        "open harm denominator"
      ]
    },
    {
      "level": "A6",
      "requirements": [
        "A5",
        "turnover survival receipts",
        "successor-system survival receipts",
        "operative inheritance instrument",
        "post-change reapproval and regression review"
      ]
    }
  ],
  "reconciliation_rules": [
    {
      "rule_id": "REG-01",
      "rule": "Compute the maximum eligible level from exact evidence and observations; never accept requested_level as authoritative."
    },
    {
      "rule_id": "REG-02",
      "rule": "A level requires every lower level and every requirement at that level."
    },
    {
      "rule_id": "REG-03",
      "rule": "A1+ requires a current non-self external attestor with conflict, relationship, expiry, and scope disclosure."
    },
    {
      "rule_id": "REG-04",
      "rule": "A2+ requires current external legal, privacy, ethics, technical, and affected-party authority."
    },
    {
      "rule_id": "REG-05",
      "rule": "A3 and A4 fail on any adverse-action authority, influence, recommendation, consultation, or use."
    },
    {
      "rule_id": "REG-06",
      "rule": "A3+ requires a pilot-specific preregistration frozen before results are visible."
    },
    {
      "rule_id": "REG-07",
      "rule": "Expired, future-dated, withdrawn, contradicted, stale, or scope-mismatched evidence cannot support a level."
    },
    {
      "rule_id": "REG-08",
      "rule": "Every open blocker caps the claim below its first_affected_level."
    },
    {
      "rule_id": "REG-09",
      "rule": "Material updates trigger re-review and reduce the computed level until scoped reapproval."
    },
    {
      "rule_id": "REG-10",
      "rule": "A6 requires observed turnover and successor survival plus operative inheritance; relabeling cannot preserve A6."
    },
    {
      "rule_id": "REG-11",
      "rule": "Truth, independence, capture, retaliation, remedy, exit, and value realization remain external investigation questions."
    },
    {
      "rule_id": "REG-12",
      "rule": "Every reconciliation appends rather than overwrites the prior level, exact fingerprint, reasons, blockers, and timestamp."
    }
  ],
