  "reconciliation_rules": [
    {
      "rule_id": "REG-01",
      "rule": "Compute the maximum eligible level from evidence and observations; never accept requested_level as authoritative."
    },
    {
      "rule_id": "REG-02",
      "rule": "A level requires every lower level and every requirement at that level."
    },
    {
      "rule_id": "REG-03",
      "rule": "A1+ requires a non-self external attestor with conflict and relationship disclosure."
    },
    {
      "rule_id": "REG-04",
      "rule": "A2+ requires current external legal, privacy, ethics, technical, and affected-party authority."
    },
    {
      "rule_id": "REG-05",
      "rule": "A3 and A4 fail on any adverse-action authority, influence, consultation, or use."
    },
    {
      "rule_id": "REG-06",
      "rule": "A3+ requires a pilot-specific preregistration frozen before results are visible."
    },
    {
      "rule_id": "REG-07",
      "rule": "Expired, withdrawn, contradicted, stale, or update-mismatched evidence cannot support a level."
    },
    {
      "rule_id": "REG-08",
      "rule": "Open critical blockers cap the claim below the first affected level."
    },
    {
      "rule_id": "REG-09",
      "rule": "Material updates trigger re-review and may reduce the computed level until reapproved."
    },
    {
      "rule_id": "REG-10",
      "rule": "A6 requires observed turnover and successor survival plus operative inheritance; relabeling cannot preserve A6 by itself."
    },
    {
      "rule_id": "REG-11",
      "rule": "Truth, independence, capture, retaliation, remedy, exit, and value realization remain external investigation questions."
    },
    {
      "rule_id": "REG-12",
      "rule": "Every reconciliation appends, rather than overwrites, the prior level, evidence fingerprint, reasons, blockers, and timestamp."
    }
  ],
