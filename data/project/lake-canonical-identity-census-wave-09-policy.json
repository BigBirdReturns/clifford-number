{
  "schema_version": "lake-canonical-identity-census-wave-09-policy@1",
  "program_key": "CN-LAKE-CANONICAL-IDENTITY-W09",
  "as_of": "2026-07-29",
  "purpose": "Classify every distinct production case-local identity value against the checked canonical actor, organization, and alias registries; preserve exact, controlled-stem, ambiguous, and uncovered classes separately; and generate graph-inert cross-case candidates without treating lexical normalization as identity.",
  "input_paths": [
    "build/lake-actions/production-cross-case-census-wave-08.json",
    "build/lake-actions/production-cross-case-census-wave-08-reconciliation.json",
    "data/canonical/actors.json",
    "data/canonical/organizations.json",
    "data/canonical/aliases.json",
    "build/axm-identity.json",
    "data/project/lake-axm-cross-case-acceptance-wave-07-policy.json",
    "BUILD-INSTRUCTIONS.md"
  ],
  "mention_registry_path": "data/project/lake-canonical-identity-mention-registry-wave-09.jsonl",
  "candidate_registry_path": "data/project/lake-canonical-cross-case-candidate-registry-wave-09.jsonl",
  "census_receipt_path": "data/project/lake-canonical-identity-census-wave-09.json",
  "candidate_projection_path": "build/axm-canonical-identity-candidate-index-wave-09.json",
  "plan_path": "build/lake-actions/canonical-identity-census-wave-09.json",
  "reconciliation_path": "build/lake-actions/canonical-identity-census-wave-09-reconciliation.json",
  "report_path": "reports/lake-canonical-identity-census-wave-09.md",
  "reconciliation_report_path": "reports/lake-canonical-identity-census-wave-09-reconciliation.md",
  "expected": {
    "native_cases": 4,
    "source_identity_occurrences": 336,
    "distinct_case_local_identity_values": 229,
    "accepted_production_identity_bridges": 0,
    "automatic_cross_case_join_authorized": false,
    "cross_case_graph_join_authorized": false,
    "cross_case_hop_creation_authorized": false,
    "active_projection_cross_case_join_authorized": false
  },
  "controlled_normalization": {
    "unicode_form": "NFKC",
    "lowercase": true,
    "punctuation_to_space": true,
    "collapse_whitespace": true,
    "edge_title_tokens": [
      "dr",
      "sir",
      "dame",
      "lord",
      "lady",
      "general",
      "gen",
      "admiral",
      "adm",
      "professor",
      "prof",
      "the"
    ],
    "edge_suffix_tokens": [
      "cbe",
      "cmg",
      "obe",
      "mbe",
      "mp",
      "kc",
      "qc",
      "inc",
      "incorporated",
      "ltd",
      "limited",
      "llc",
      "plc",
      "corporation",
      "corp",
      "company",
      "co",
      "technologies",
      "technology",
      "industries",
      "industry",
      "systems",
      "system",
      "group",
      "holdings",
      "holding"
    ],
    "minimum_stem_characters": 4
  },
  "decision_law": {
    "review_required_to_decide": false,
    "missing_reviewer_blocks_census": false,
    "exact_canonical_id_is_registry_coverage_not_identity_proof": true,
    "exact_label_or_alias_is_registry_candidate_not_identity_proof": true,
    "controlled_stem_match_is_candidate_only": true,
    "ambiguous_matches_must_be_rejected": true,
    "uncovered_mentions_must_be_preserved": true,
    "explicit_same_entity_assertion_required_for_bridge": true,
    "source_custody_required_for_bridge": true,
    "assertion_custody_required_for_bridge": true,
    "shared_identity_namespace_required_for_bridge": true,
    "unambiguous_axm_token_overlap_required_for_bridge": true,
    "correction_mode": "append_preserving_supersession"
  },
  "boundaries": {
    "canonical_registry_match_proves_real_world_identity": false,
    "exact_label_match_proves_same_entity": false,
    "alias_match_proves_same_entity": false,
    "controlled_stem_match_proves_same_entity": false,
    "canonical_candidate_creates_relationship": false,
    "canonical_candidate_creates_hop": false,
    "uncovered_name_proves_distinct_entity": false,
    "zero_cross_case_candidates_proves_disjointness": false,
    "automatic_cross_case_join_authorized": false,
