{
  "schema_version": "project-stable-ground-governor@1",
  "project_id": "clifford-number",
  "as_of": "2026-07-30",
  "purpose": "Govern append-preserving stable-ground checkpoints without requiring a historical checkpoint to equal later live corpus state.",
  "current_pointer_path": "data/project/project-stable-ground-current.json",
  "history_law": {
    "append_only": true,
    "checkpoint_ids_unique": true,
    "history_order_oldest_to_newest": true,
    "one_current_checkpoint": true,
    "superseded_checkpoint_status": "superseded_preserved",
    "current_checkpoint_status": "current",
    "historical_data_and_reports_rewritten": false,
    "historical_release_manifests_recomputed": false,
    "historical_checkpoint_may_be_deleted": false
  },
  "validation_modes": {
    "current": {
      "must_validate": [
        "checkpoint's frozen source and authority declarations",
        "current pointer identity and ordered history",
        "live canonical counts explicitly frozen by the checkpoint",
        "current release manifest exact bytes",
        "current report reconstruction",
        "graph, publication, field, and adoption boundaries"
      ]
    },
    "historical": {
      "must_validate": [
        "checkpoint's frozen source and authority declarations",
        "original release digest and report custody",
        "exact history-row path and merge receipt",
        "superseded_preserved status",
        "graph, publication, field, and adoption boundaries"
      ],
      "must_not_validate": [
        "historical counts against later live corpus state",
        "historical generated bytes by rebuilding them with successor code",
        "future story, query, adoption, or deployment state as if it existed at the historical checkpoint"
      ]
    }
  },
  "checkpoint_contract": {
    "required_fields": [
      "checkpoint_id",
      "as_of",
      "supersedes",
      "trigger",
      "canonical_main",
      "preserved_stable_propositions",
      "authority_change",
      "canonical_snapshot",
      "fanout_state",
      "change_control",
      "boundaries"
    ],
    "required_effect_dimensions": [
      "canonical_effect",
      "graph_effect",
      "publication_effect",
      "field_effect",
      "adoption_effect"
    ],
    "correction_mode": "append_preserving_supersession"
  },
  "authority_law": {
    "canonical_repository_state_is_empirical_truth": false,
    "internal_build_is_external_reproduction": false,
    "issue_or_pr_opening_is_execution": false,
    "projection_is_canonical_evidence": false,
    "publication_is_adoption": false,
    "same_mechanism_is_coordination": false
  },
  "trigger_classes": [
    "authority tier changes",
    "canonical K0 query count changes",
    "M-05 story or lane count changes",
    "DCA execution state changes",
    "POOF ecology or publication state changes",
    "publication-safety dependency changes",
    "evidence-lake shadow lands on main",
    "external adoption ceiling changes",
    "works-standard predicate changes",
    "status-for-sovereignty hypothesis, source-review, or field-execution state changes"
  ],
  "boundaries": {
    "governor_proves_source_truth": false,
    "governor_makes_history_current": false,
    "governor_authorizes_publication": false,
    "governor_advances_adoption": false,
    "graph_effect": "none",
    "project_complete": false
  }
}
