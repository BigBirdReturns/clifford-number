{
  "schema_version": "m05-answerable-power-sprint-08-lifecycle-constitution@1",
  "program_id": "M-05",
  "sprint_id": "M05-SPRINT-08",
  "as_of": "2026-07-29",
  "purpose": "Keep every A1 support claim contestable, time-bounded, and append-preserving after initial approval.",
  "roles": [
    {
      "role_id": "S08-R1",
      "name": "public_docket_custodian",
      "function": "Publish public challenges, notices, evidence locators, and lifecycle proposals without deciding their merits.",
      "substantive_override": false
    },
    {
      "role_id": "S08-R2",
      "name": "protected_identity_custodian",
      "function": "Verify and retain a protected challenger identity outside the public docket while publishing only a signed custody attestation and digest.",
      "substantive_override": false
    },
    {
      "role_id": "S08-R3",
      "name": "support_monitor",
      "function": "Record support incidents and automatic trigger evidence without deciding final disposition.",
      "substantive_override": false
    },
    {
      "role_id": "S08-R4",
      "name": "independence_adjudicator",
      "function": "Determine reviewer, reproducer, adopter, vendor, operator, and challenge-process independence for a proposed transition.",
      "substantive_override": true
    },
    {
      "role_id": "S08-R5",
      "name": "evidence_adjudicator",
      "function": "Determine whether the support, loss, correction, successor, and restoration evidence sustains the proposed transition.",
      "substantive_override": true
    },
    {
      "role_id": "S08-R6",
      "name": "registry_custodian",
      "function": "Append an externally approved lifecycle transaction exactly as adjudicated; never alter findings, blockers, dissent, or evidence.",
      "substantive_override": false
    }
  ],
  "lifecycle_states": [
    {
      "state_id": "active",
      "meaning": "An externally approved A1 entry remains within its support and validity envelope."
    },
    {
      "state_id": "challenged",
      "meaning": "A timely challenge is open; the prior status remains visible but cannot be represented as uncontested."
    },
    {
      "state_id": "suspended",
      "meaning": "Material support is absent, unreliable, or under mandatory pause; A1 may not be operationally claimed."
    },
    {
      "state_id": "revoked",
      "meaning": "External adjudication found the A1 support claim materially invalid or captured."
    },
    {
      "state_id": "expired",
      "meaning": "The approved validity period elapsed without a timely renewed transaction."
    },
    {
      "state_id": "restoration_pending",
      "meaning": "A previously unsupported entry has supplied a correction package but has not completed renewed external adjudication."
    },
    {
      "state_id": "restored",
      "meaning": "A renewed, separately adjudicated transaction restored support for a bounded validity period."
    },
    {
      "state_id": "superseded",
      "meaning": "A material reference or successor-system change ended the prior entry's governing scope."
    }
  ],
  "allowed_transitions": [
    {
      "from": "active",
      "to": "challenged",
      "basis": [
        "eligible_public_challenge",
        "eligible_protected_challenge"
      ]
    },
    {
      "from": "active",
      "to": "suspended",
      "basis": [
        "automatic_support_loss",
        "binding_interim_order"
      ]
    },
    {
      "from": "challenged",
      "to": "suspended",
      "basis": [
        "automatic_support_loss",
        "material_challenge_pending"
      ]
    },
    {
      "from": "active",
      "to": "revoked",
      "basis": [
        "final_external_adjudication"
      ]
    },
    {
      "from": "challenged",
      "to": "revoked",
      "basis": [
        "final_external_adjudication"
      ]
    },
    {
      "from": "suspended",
      "to": "revoked",
      "basis": [
        "final_external_adjudication"
      ]
    },
    {
      "from": "active",
      "to": "expired",
      "basis": [
        "validity_elapsed"
      ]
    },
    {
      "from": "challenged",
      "to": "expired",
      "basis": [
        "validity_elapsed"
      ]
    },
    {
      "from": "suspended",
      "to": "restoration_pending",
      "basis": [
        "correction_package_complete"
      ]
    },
    {
      "from": "revoked",
      "to": "restoration_pending",
      "basis": [
        "correction_package_complete"
      ]
    },
    {
      "from": "expired",
      "to": "restoration_pending",
      "basis": [
        "renewal_package_complete"
      ]
    },
    {
      "from": "restoration_pending",
      "to": "restored",
      "basis": [
        "renewed_external_adjudication"
      ]
    },
    {
      "from": "active",
      "to": "superseded",
      "basis": [
        "material_successor_change"
      ]
    },
    {
      "from": "challenged",
      "to": "superseded",
      "basis": [
        "material_successor_change"
      ]
    },
    {
      "from": "suspended",
      "to": "superseded",
      "basis": [
        "material_successor_change"
      ]
    },
    {
      "from": "restored",
      "to": "challenged",
      "basis": [
        "eligible_public_challenge",
        "eligible_protected_challenge"
      ]
    },
    {
      "from": "restored",
      "to": "suspended",
      "basis": [
        "automatic_support_loss",
        "binding_interim_order"
      ]
    },
    {
      "from": "restored",
      "to": "expired",
      "basis": [
        "validity_elapsed"
      ]
    },
    {
      "from": "restored",
      "to": "superseded",
      "basis": [
        "material_successor_change"
      ]
    }
  ],
  "challenge_categories": [
    "identity_or_independence_failure",
    "undisclosed_material_conflict",
    "selection_capture_or_veto",
    "evidence_custody_break",
    "reproduction_or_output_failure",
    "material_reference_or_successor_change",
    "retaliation_or_chilling_effect",
    "challenge_suppression_or_docket_omission",
    "registry_or_signature_mismatch",
    "fraud_misrepresentation_or_omitted_failure"
  ],
  "automatic_support_loss_triggers": [
    "reference_byte_mismatch",
    "receipt_or_evidence_unavailable",
    "signature_or_digest_invalid",
    "substantive_adjudicator_disqualified",
    "adjudication_or_entry_expired",
    "unresolved_material_challenge",
    "registry_history_not_append_preserving",
    "material_update_without_successor_review",
    "newly_disclosed_material_conflict",
    "retaliation_or_challenge_suppression",
    "binding_court_or_regulator_order",
    "required_exit_or_substitution_route_unavailable"
  ],
  "challenge_routes": {
    "public": {
      "identity_public": true,
      "evidence_public_by_default": true,
      "minimum_acknowledgement_hours": 72
    },
    "protected": {
      "identity_public": false,
      "identity_custodian_required": true,
      "public_identity_digest_required": true,
      "custody_signature_required": true,
      "minimum_acknowledgement_hours": 72
    },
    "private_unreceipted_route_permitted": false,
    "anonymous_unverifiable_material_challenge_may_directly_revoke": false
  },
  "interim_action_law": {
    "automatic_trigger_requires_public_incident": true,
    "automatic_trigger_requires_suspension_or_revocation_proposal": true,
    "unresolved_material_challenge_requires_challenged_or_suspended_state": true,
    "registry_custodian_may_ignore_trigger": false,
    "project_may_self_clear_trigger": false
  },
  "restoration_law": {
    "correction_package_required": true,
    "support_restored_evidence_required": true,
    "renewed_independence_decision_required": true,
    "renewed_evidence_decision_required": true,
    "separate_people_and_legal_entities_required": true,
    "minimum_public_challenge_window_days": 14,
    "unresolved_material_challenge_blocks_restoration": true,
    "successor_compatibility_required": true,
    "new_expiry_required": true,
    "automatic_restoration_permitted": false,
    "project_self_restoration_permitted": false
  },
  "registry_law": {
    "prior_registry_blob_sha": "5555d18654c2fb7bc908efe7c0ffbc25487b8fac",
    "append_preserving": true,
    "prior_entry_retained": true,
    "challenges_retained": true,
    "incidents_retained": true,
    "dissent_retained": true,
    "silent_deletion_permitted": false,
    "backdating_permitted": false,
    "substantive_custodian_override_permitted": false,
    "automatic_cli_registry_mutation_permitted": false
  },
  "expiry_law": {
    "maximum_entry_validity_days": 366,
    "expiry_is_automatic_support_loss": true,
    "renewal_requires_new_transaction": true,
    "expired_entry_may_be_described_as_active": false
  },
  "boundaries": {
    "constitution_proves_a1_entry_exists": false,
    "challenge_schema_proves_challenge_truth": false,
    "automatic_trigger_label_proves_trigger_truth": false,
    "structural_transition_proves_external_decision": false,
    "protected_route_proves_identity_without_custodian_attestation": false,
    "restoration_schema_restores_a1": false,
    "registry_cli_mutates_registry": false,
    "real_person_pilot_authorized": false
  }
}
