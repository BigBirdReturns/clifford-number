{
  "schema_version": "m05-answerable-power-real-person-entry-gate@1",
  "program_id": "M-05",
  "sprint_id": "M05-SPRINT-05",
  "leg_id": "S05-L3",
  "as_of": "2026-07-27",
  "title": "Real-person entry gate",
  "status": "protocol_complete_no_authorization_issued",
  "gate_sections": [
    {
      "section_id": "ENTRY-01",
      "name": "jurisdiction_specific_legal_authority",
      "required_evidence": [
        "named jurisdiction and decision authority",
        "lawful basis for each purpose and consequence",
        "procurement, administrative, labor, equality, sectoral, and constitutional authority as applicable",
        "external legal approval and expiry"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-02",
      "name": "research_operations_and_ethics_classification",
      "required_evidence": [
        "research-versus-operations determination",
        "human-subjects or equivalent classification",
        "ethics review authority",
        "protocol deviations and incident escalation"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-03",
      "name": "privacy_and_data_protection_review",
      "required_evidence": [
        "data inventory and lawful basis",
        "data-protection impact assessment or jurisdictional equivalent",
        "rights and access routes",
        "cross-border and subprocessor treatment"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-04",
      "name": "data_minimization_retention_and_deletion",
      "required_evidence": [
        "minimum fields and purpose binding",
        "retention schedule",
        "deletion and downstream-propagation proof",
        "litigation and appeal holds"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-05",
      "name": "security_and_incident_response",
      "required_evidence": [
        "threat model",
        "access controls and logs",
        "breach and safety incident plan",
        "notification, containment, recovery, and independent review"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-06",
      "name": "accessibility_language_and_support",
      "required_evidence": [
        "accessible notice and interfaces",
        "language access",
        "human assistance",
        "accommodation and offline route"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-07",
      "name": "notice_lawful_basis_and_nonretaliation",
      "required_evidence": [
        "timely person notice",
        "lawful basis and named authority",
        "contest and assistance route",
        "binding nonretaliation protection"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-08",
      "name": "affected_party_governance",
      "required_evidence": [
        "independent formation",
        "affected-party voting majority",
        "compensation, recall, minority review, conflicts, and dissent",
        "material-update reapproval"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-09",
      "name": "independent_stop_and_remedy_authority",
      "required_evidence": [
        "independence from operator and vendor",
        "complete evidence access",
        "power to bind, pause, reverse, restore, delete, compensate, or prohibit",
        "timely availability and enforcement"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-10",
      "name": "vendor_and_subprocessor_controls",
      "required_evidence": [
        "named vendors and subprocessors",
        "version, purpose, update, security, audit, and evidence obligations",
        "no exclusive custody",
        "termination, transition, deletion, and successor duties"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-11",
      "name": "evidence_preservation_and_public_accountability",
      "required_evidence": [
        "action and telemetry schema",
        "tamper-evident retention",
        "public aggregate reporting",
        "independent access, dissent, and incident publication"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-12",
      "name": "strict_no_adverse_action_mode_boundary",
      "required_evidence": [
        "technical and policy prohibition on adverse authority",
        "no recommendation, trigger, ranking, prioritization, or informal consultation",
        "staff instruction and monitoring",
        "automatic suspension on breach"
      ],
      "approval_must_be_external_where_applicable": true
    },
    {
      "section_id": "ENTRY-13",
      "name": "suspension_exit_and_successor_rules",
      "required_evidence": [
        "stop thresholds",
        "continuity and fallback",
        "exit and deletion",
        "successor inheritance and re-review"
      ],
      "approval_must_be_external_where_applicable": true
    }
  ],
  "issuance_rule": "The repository may report only whether required objects are present, current, and internally consistent. It cannot issue legal, ethics, privacy, human-subjects, security, affected-party, or institutional approval.",
  "entry_decision": {
    "protocol_complete": true,
    "real_person_pilot_authorized": false,
    "external_legal_approval_observed": false,
    "ethics_approval_observed": false,
    "privacy_approval_observed": false,
    "affected_party_approval_observed": false,
    "independent_stop_authority_observed": false,
    "eligible_real_person_pilots": 0,
    "decision": "blocked_at_a0"
  },
  "automatic_blockers": [
    "missing or stale jurisdiction-specific authority",
    "unresolved research or human-subjects classification",
    "missing privacy or data-protection approval",
    "real-person data beyond the minimized approved inventory",
    "adverse-action authority in shadow or parallel mode",
    "institution-selected affected-party majority",
    "operator- or vendor-controlled stop authority",
    "exclusive vendor evidence custody",
    "unbounded emergency exception",
    "missing preregistration, denominator, or stop thresholds",
    "missing suspension, exit, deletion, or successor-system rules"
  ],
  "boundaries": {
    "promotes_to": "candidate_only",
    "graph_effect": "none",
    "protocol_complete_proves_pilot_authorized": false,
    "repository_check_proves_legal_approval": false,
    "repository_check_proves_ethics_approval": false,
    "repository_check_proves_privacy_approval": false,
    "repository_check_proves_affected_party_approval": false,
    "entry_package_proves_institutional_practice": false
  }
}
