{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/apc-a1-support-incident-v1.json",
  "title": "APC A1 support incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "observed_at",
    "target_entry_id",
    "trigger",
    "severity",
    "evidence",
    "reporter",
    "automatic_action",
    "declaration"
  ],
  "properties": {
    "schema_version": {
      "const": "apc-a1-support-incident@1"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^A1I-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_entry_id": {
      "type": "string",
      "pattern": "^A1E-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "trigger": {
      "enum": [
        "reference_byte_mismatch",
        "receipt_or_evidence_unavailable",
        "signature_or_digest_invalid",
        "substantive_adjudicator_disqualified",
        "adjudication_or_entry_expired",
        "unresolved_material_challenge",
        "registry_history_not_append_preserving",
        "material_update_without_successor_review",
        "newly_disclosed_material_conflict",
        "retaliation_or_challenge_suppression",
        "binding_court_or_regulator_order",
        "required_exit_or_substitution_route_unavailable"
      ]
    },
    "severity": {
      "enum": [
        "monitor",
        "material",
        "critical"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "reporter": {
      "type": "object"
    },
    "automatic_action": {
      "enum": [
        "challenge_state",
        "suspend",
        "revoke",
        "expire",
        "supersede"
      ]
    },
    "declaration": {
      "type": "object"
    }
  }
}
