  "title": "Counter-Selector Wave 04: procedurally separated blind review",
  "status": "protocol_frozen_execution_by_deterministic_builder",
  "purpose": "Review the two identity-minimized Wave 03 packets through separate artifact-validity and adversarial-countermodel passes, preserve disagreement without averaging, and refuse to claim external independence, operator selection, or field-test eligibility.",
  "review_unit": "one public identity-minimized packet; private candidate mapping is unavailable until post-review custody synthesis",
  "review_input_fields": [
    "packet_id",
    "blind_token",
    "review_authority",
    "task",
    "requirements",
    "bounded_chronology",
    "observable_transition",
    "counterevidence",
    "falsifier"
  ],
  "review_prohibitions": [
    "candidate or person identity",
    "denominator class",
    "public label",
    "title or employer",
    "jurisdiction",
    "source route or source identifier",
    "matched-control identity",
    "political affiliation or status metadata"
  ],
  "review_passes": [
    {
      "pass_id": "CS-RP-A",
      "reviewer_role": "artifact_validity",
      "separation": "fresh_context_public_packet_only",
      "questions": [
        "Is the task bounded and are requirements explicit?",
        "Does the chronology expose an observable state transition?",
        "Are counterevidence and a recoverable falsifier present?",
        "Which dimensions, if any, receive only bounded support from the artifact?"
      ]
    },
    {
      "pass_id": "CS-RP-B",
      "reviewer_role": "adversarial_countermodel",
      "separation": "fresh_context_public_packet_only",
      "questions": [
        "Can ordinary institutional support or role authority explain the result?",
        "Is the packet an original work object or a later reconstruction?",
        "Are causality, final merits, custody, and durable repair actually observed?",
        "Is the unit an operator, a partnership, or only a correction mechanism?"
      ]
    }
  ],
  "reviewer_independence": {
    "procedural_separation_claimed": true,
    "fresh_context_claimed": true,
    "external_human_independence_claimed": false,
    "different_model_or_institution_claimed": false,
    "same_system_limitation_preserved": true
  },
  "dimension_states": [
    "bounded_support",
    "not_tested",
    "not_tested_support_ledger_missing",
    "insufficient_handoff_receipt",
    "not_attributable_from_system_packet"
  ],
  "packet_review_plans": [
