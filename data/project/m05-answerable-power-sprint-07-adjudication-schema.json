{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/apc-a1-adjudication-transaction-v1.json",
  "title": "APC-01 A1 Adjudication Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "as_of",
    "expires_at",
    "receipt",
    "docket",
    "adjudicators",
    "decisions",
    "challenge",
    "registry_transaction",
    "declaration"
  ],
  "properties": {
    "schema_version": {
      "const": "apc-a1-adjudication-transaction@1"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^A1T-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_uri",
        "receipt_sha256",
        "structural_validation_uri",
        "structural_validation_sha256",
        "structurally_valid",
        "target_commit",
        "target_bundle_sha256"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^A1R-[A-Z0-9][A-Z0-9-]{7,63}$"
        },
        "receipt_uri": {
          "type": "string",
          "minLength": 8
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "structural_validation_uri": {
          "type": "string",
          "minLength": 8
        },
        "structural_validation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "structurally_valid": {
          "const": true
        },
        "target_commit": {
          "const": "ce8f4194019cf75cc2b66436efbeebdfd43f9951"
        },
        "target_bundle_sha256": {
          "const": "9084e2fe8e4a951fd667c71b9be58475a1b8fc463ab25c885fd98891d39747ad"
        }
      }
    },
    "docket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docket_uri",
        "opened_at",
        "public_notice_uri",
        "challenge_deadline",
        "pool_snapshot_uri",
        "pool_snapshot_sha256",
        "selection_method",
        "selection_seed_sha256",
        "pool_size",
        "reproducer_controlled",
        "project_unilateral_selection"
      ],
      "properties": {
        "docket_uri": {
          "type": "string",
          "minLength": 8
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_notice_uri": {
          "type": "string",
          "minLength": 8
        },
        "challenge_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "pool_snapshot_uri": {
          "type": "string",
          "minLength": 8
        },
        "pool_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection_method": {
          "const": "public_pool_recorded_selection"
        },
        "selection_seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pool_size": {
          "type": "integer",
          "minimum": 4
        },
        "reproducer_controlled": {
          "const": false
        },
        "project_unilateral_selection": {
          "const": false
        }
      }
    },
    "adjudicators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/adjudicator"
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence",
        "evidence"
      ],
      "properties": {
        "independence": {
          "$ref": "#/$defs/decision"
        },
        "evidence": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_notice_uri",
        "opened_at",
        "deadline",
        "window_days",
        "submissions_count",
        "unresolved_challenges",
        "dissent",
        "reconsideration_required"
      ],
      "properties": {
        "public_notice_uri": {
          "type": "string",
          "minLength": 8
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "window_days": {
          "type": "integer",
          "minimum": 14
        },
        "submissions_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_challenges": {
          "type": "array"
        },
        "dissent": {
          "type": "array"
        },
        "reconsideration_required": {
          "const": false
        }
      }
    },
    "registry_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_registry_blob_sha",
        "proposed_status",
        "proposed_entry_uri",
        "proposed_entry_sha256",
        "open_blockers",
        "prepared_by",
        "prepared_at",
        "custodian_id",
        "custodian_is_substantive_adjudicator",
        "custodian_substantive_override",
        "entry_matches_decisions",
        "append_preserving"
      ],
      "properties": {
        "prior_registry_blob_sha": {
          "const": "5555d18654c2fb7bc908efe7c0ffbc25487b8fac"
        },
        "proposed_status": {
          "const": "approved_for_a1"
        },
        "proposed_entry_uri": {
          "type": "string",
          "minLength": 8
        },
        "proposed_entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "open_blockers": {
          "type": "array",
          "maxItems": 0
        },
        "prepared_by": {
          "type": "string",
          "minLength": 2
        },
        "prepared_at": {
          "type": "string",
          "format": "date-time"
        },
        "custodian_id": {
          "type": "string",
          "minLength": 2
        },
        "custodian_is_substantive_adjudicator": {
          "const": false
        },
        "custodian_substantive_override": {
          "const": false
        },
        "entry_matches_decisions": {
          "const": true
        },
        "append_preserving": {
          "const": true
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_self_award",
        "no_unilateral_project_award",
        "separate_reviewers",
        "no_open_blockers",
        "no_unresolved_challenge",
        "registry_not_mutated_by_cli"
      ],
      "properties": {
        "no_self_award": {
          "const": true
        },
        "no_unilateral_project_award": {
          "const": true
        },
        "separate_reviewers": {
          "const": true
        },
        "no_open_blockers": {
          "const": true
        },
        "no_unresolved_challenge": {
          "const": true
        },
        "registry_not_mutated_by_cli": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator_id",
        "name",
        "legal_entity",
        "role",
        "identity_uri",
        "eligibility_uri",
        "eligibility_sha256",
        "selected_from_public_pool",
        "selected_by_reproducer",
        "selected_by_project_unilaterally",
        "repo_admin_or_maintainer",
        "reference_contributor",
        "receipt_preparer_or_reproducer",
        "vendor_operator_customer_or_adopter",
        "same_legal_entity_as_disqualified",
        "project_bot_or_ci",
        "contingent_compensation",
        "evidence_host_or_preparer",
        "conflicts_disclosed",
        "conflict_disclosures",
        "signed_at",
        "expires_at",
        "signature_uri",
        "signature_sha256"
      ],
      "properties": {
        "adjudicator_id": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "legal_entity": {
          "type": "string",
          "minLength": 2
        },
        "role": {
          "enum": [
            "independence",
            "evidence"
          ]
        },
        "identity_uri": {
          "type": "string",
          "minLength": 8
        },
        "eligibility_uri": {
          "type": "string",
          "minLength": 8
        },
        "eligibility_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_from_public_pool": {
          "const": true
        },
        "selected_by_reproducer": {
          "const": false
        },
        "selected_by_project_unilaterally": {
          "const": false
        },
        "repo_admin_or_maintainer": {
          "const": false
        },
        "reference_contributor": {
          "const": false
        },
        "receipt_preparer_or_reproducer": {
          "const": false
        },
        "vendor_operator_customer_or_adopter": {
          "const": false
        },
        "same_legal_entity_as_disqualified": {
          "const": false
        },
        "project_bot_or_ci": {
          "const": false
        },
        "contingent_compensation": {
          "const": false
        },
        "evidence_host_or_preparer": {
          "const": false
        },
        "conflicts_disclosed": {
          "const": true
        },
        "conflict_disclosures": {
          "type": "array"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature_uri": {
          "type": "string",
          "minLength": 8
        },
        "signature_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator_id",
        "disposition",
        "receipt_sha256",
        "issued_at",
        "expires_at",
        "evidence_uris",
        "findings",
        "blockers",
        "dissent",
        "signature_uri",
        "signature_sha256"
      ],
      "properties": {
        "adjudicator_id": {
          "type": "string",
          "minLength": 3
        },
        "disposition": {
          "enum": [
            "approve",
            "reject",
            "pause"
          ]
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_uris": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array"
        },
        "dissent": {
          "type": "array"
        },
        "signature_uri": {
          "type": "string",
          "minLength": 8
        },
        "signature_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
