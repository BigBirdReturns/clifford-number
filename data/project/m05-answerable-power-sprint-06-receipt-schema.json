{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/clifford-number/schemas/apc-independent-reproduction-receipt-v1.json",
  "title": "APC-01 Independent Reproduction Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at",
    "expires_at",
    "reference",
    "reproducer",
    "environment",
    "procedure",
    "results",
    "custody",
    "signature",
    "declaration"
  ],
  "properties": {
    "schema_version": {
      "const": "apc-independent-reproduction-receipt@1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^A1R-[A-Z0-9][A-Z0-9-]{7,63}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "commit_sha",
        "release_manifest_path",
        "combined_sha256",
        "public_bundle_uri"
      ],
      "properties": {
        "repository_full_name": {
          "const": "BigBirdReturns/clifford-number"
        },
        "commit_sha": {
          "const": "ce8f4194019cf75cc2b66436efbeebdfd43f9951"
        },
        "release_manifest_path": {
          "const": "data/project/m05-answerable-power-sprint-05-release-manifest.json"
        },
        "combined_sha256": {
          "const": "9084e2fe8e4a951fd667c71b9be58475a1b8fc463ab25c885fd98891d39747ad"
        },
        "public_bundle_uri": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "reproducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identity_type",
        "identity_evidence_uri",
        "contact_uri",
        "relationship_to_project",
        "relationship_to_vendor",
        "relationship_to_operator",
        "relationship_to_adopter",
        "funding_disclosure",
        "conflicts_disclosed",
        "conflict_disclosures",
        "repo_admin_or_maintainer",
        "reference_contributor",
        "vendor_or_operator",
        "customer_or_adopter",
        "same_legal_entity",
        "bot_or_automated_agent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "identity_type": {
          "enum": [
            "person",
            "organization"
          ]
        },
        "identity_evidence_uri": {
          "type": "string",
          "minLength": 8
        },
        "contact_uri": {
          "type": "string",
          "minLength": 5
        },
        "relationship_to_project": {
          "type": "string",
          "minLength": 1
        },
        "relationship_to_vendor": {
          "type": "string",
          "minLength": 1
        },
        "relationship_to_operator": {
          "type": "string",
          "minLength": 1
        },
        "relationship_to_adopter": {
          "type": "string",
          "minLength": 1
        },
        "funding_disclosure": {
          "type": "string",
          "minLength": 1
        },
        "conflicts_disclosed": {
          "const": true
        },
        "conflict_disclosures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repo_admin_or_maintainer": {
          "const": false
        },
        "reference_contributor": {
          "const": false
        },
        "vendor_or_operator": {
          "const": false
        },
        "customer_or_adopter": {
          "const": false
        },
        "same_legal_entity": {
          "const": false
        },
        "bot_or_automated_agent": {
          "const": false
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "node_version",
        "npm_version",
        "git_version",
        "dependency_lock_sha256",
        "workspace_origin",
        "network_sources"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "node_version": {
          "type": "string",
          "minLength": 1
        },
        "npm_version": {
          "type": "string",
          "minLength": 1
        },
        "git_version": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workspace_origin": {
          "const": "independently_provisioned"
        },
        "network_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "started_at",
        "completed_at",
        "clean_room",
        "fresh_checkout",
        "prior_build_artifacts_reused",
        "project_supplied_workspace",
        "executed_by_project_ci",
        "commands",
        "deviations"
      ],
      "properties": {
        "protocol_version": {
          "const": "M05-S06-PROTOCOL-1"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "clean_room": {
          "const": true
        },
        "fresh_checkout": {
          "const": true
        },
        "prior_build_artifacts_reused": {
          "const": false
        },
        "project_supplied_workspace": {
          "const": false
        },
        "executed_by_project_ci": {
          "const": false
        },
        "commands": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "command",
              "exit_code",
              "started_at",
              "completed_at",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "const": 0
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "stdout_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "stderr_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "deviations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkout_commit_sha",
        "release_combined_sha256",
        "full_release_gate_exit_code",
        "focused_checks_exit_code",
        "deterministic_rebuild_clean",
        "output_fingerprints"
      ],
      "properties": {
        "checkout_commit_sha": {
          "const": "ce8f4194019cf75cc2b66436efbeebdfd43f9951"
        },
        "release_combined_sha256": {
          "const": "9084e2fe8e4a951fd667c71b9be58475a1b8fc463ab25c885fd98891d39747ad"
        },
        "full_release_gate_exit_code": {
          "const": 0
        },
        "focused_checks_exit_code": {
          "const": 0
        },
        "deterministic_rebuild_clean": {
          "const": true
        },
        "output_fingerprints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_uri",
        "evidence_sha256",
        "public_access",
        "immutable_or_versioned",
        "retained_until",
        "raw_logs_included",
        "complete_failure_denominator"
      ],
      "properties": {
        "evidence_uri": {
          "type": "string",
          "minLength": 8
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_access": {
          "const": true
        },
        "immutable_or_versioned": {
          "const": true
        },
        "retained_until": {
          "type": "string",
          "format": "date-time"
        },
        "raw_logs_included": {
          "const": true
        },
        "complete_failure_denominator": {
          "const": true
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatory_name",
        "signature_type",
        "signed_at",
        "signed_statement_uri",
        "signed_statement_sha256"
      ],
      "properties": {
        "signatory_name": {
          "type": "string",
          "minLength": 2
        },
        "signature_type": {
          "enum": [
            "digital_signature",
            "notarized_statement",
            "organizational_attestation"
          ]
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "signed_statement_uri": {
          "type": "string",
          "minLength": 8
        },
        "signed_statement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual_accuracy",
        "no_self_attestation",
        "no_undisclosed_conflict",
        "no_project_control",
        "no_private_artifact_dependency"
      ],
      "properties": {
        "factual_accuracy": {
          "const": true
        },
        "no_self_attestation": {
          "const": true
        },
        "no_undisclosed_conflict": {
          "const": true
        },
        "no_project_control": {
          "const": true
        },
        "no_private_artifact_dependency": {
          "const": true
        }
      }
    }
  }
}
