{
  "schema_version": "m04e-constitutional-awareness-methodology@1",
  "methodology_id": "M04E-CAM-001",
  "as_of": "2026-07-24",
  "title": "Constitutional position, awareness, orientation, and counterpower",
  "purpose": "Classify how purpose-setting, translation, architecture, action rights, representation, benefit, dissent, and compulsory revision are distributed without inferring hidden mental states from role or silence.",
  "research_question": "Within a bounded system and time window, who may define the objective, translate it, model reality, act through the model, absorb the consequences, exploit the arrangement, resist it, or compel it to change?",
  "unit_of_analysis": "actor_or_institution @ bounded_system @ time_window @ objective_or_decision",
  "axes": {
    "constitutional_position": [
      {
        "position_id": "S4-sovereign-center",
        "meaning": "May define or preserve the objective function or reserved purpose."
      },
      {
        "position_id": "O3-operator-integrator",
        "meaning": "Translates purpose into institutions, products, contracts, teams, and executable workflows."
      },
      {
        "position_id": "G2-gatekeeper-architect",
        "meaning": "Defines or administers eligibility, ontology, interfaces, access, standards, or decision gates."
      },
      {
        "position_id": "H2-host-resource-provider",
        "meaning": "Supplies capital, authority, legitimacy, data, distribution, or infrastructure and may retain or surrender control rights."
      },
      {
        "position_id": "U1-user-functionary",
        "meaning": "Uses the system or performs a bounded procedure under existing rules."
      },
      {
        "position_id": "R0-represented-subject",
        "meaning": "Is represented, classified, prioritized, or acted upon by the system."
      },
      {
        "position_id": "K4-counter-sovereign",
        "meaning": "Can compel disclosure, reversal, rule change, removal, substitution, or termination."
      },
      {
        "position_id": "W1-worker-contributor",
        "meaning": "Supplies labor, expertise, craft, or implementation capacity without demonstrated final-purpose rights."
      },
      {
        "position_id": "X1-external-challenger",
        "meaning": "Investigates, advocates, contests, or reports from outside the operating compact without inherent compulsory authority."
      }
    ],
    "awareness_level": [
      {
        "awareness_id": "A0-no-demonstrated-systemic-awareness",
        "meaning": "The current public record establishes no systemic awareness; this is not a finding of ignorance."
      },
      {
        "awareness_id": "A1-local-awareness",
        "meaning": "Understands the immediate task, rule, transaction, or consequence."
      },
      {
        "awareness_id": "A2-tacit-constitutional-awareness",
        "meaning": "Behavior suggests knowledge of unwritten red lines, actual decision centers, or non-negotiable constraints; inference requires repeated source-bounded conduct."
      },
      {
        "awareness_id": "A3-explicit-architectural-awareness",
        "meaning": "Publicly describes modules, interfaces, incentives, dependencies, or operating responsibilities."
      },
      {
        "awareness_id": "A4-explicit-constitutional-awareness",
        "meaning": "Publicly describes who should define purpose, hold final authority, or be insulated from ordinary correction."
      },
      {
        "awareness_id": "A5-reflexive-feedback-awareness",
        "meaning": "Explicitly recognizes how criticism, safeguards, resistance, or failure can be absorbed as feedback without changing purpose."
      }
    ],
    "orientation": [
      {
        "orientation_id": "committed",
        "meaning": "Affirms the bounded objective or constitutional arrangement."
      },
      {
        "orientation_id": "accommodative",
        "meaning": "Recognizes or accepts the arrangement without demonstrated authorship."
      },
      {
        "orientation_id": "opportunistic",
        "meaning": "Pursues advantage through an identified institutional opening; no wrongdoing is implied."
      },
      {
        "orientation_id": "loyal-dissent",
        "meaning": "Challenges means or implementation while remaining aligned with the governing objective."
      },
      {
        "orientation_id": "adversarial",
        "meaning": "Challenges the objective, category, authority, or consequence."
      },
      {
        "orientation_id": "independent",
        "meaning": "Exercises a formally separate review or adjudicative role."
      },
      {
        "orientation_id": "unknown",
        "meaning": "The public record does not support orientation."
      }
    ],
    "action_rights": [
      "define_objective",
      "revise_objective",
      "define_ontology",
      "revise_ontology",
      "set_eligibility",
      "set_access",
      "execute_action",
      "approve_or_override",
      "veto",
      "compel_disclosure",
      "compel_rule_change",
      "reverse_consequence",
      "remove_decision_maker",
      "terminate_system",
      "exit_system",
      "receive_notice",
      "seek_correction",
      "appeal",
      "criticize_or_petition",
      "investigate_or_audit",
      "publish_or_disclose_analysis",
      "collective_withdraw_labor",
      "shape_policy_or_principles"
    ],
    "effective_power_level": [
      {
        "power_id": "P0-no-observed-institutional-power",
        "meaning": "No observed authority beyond being represented or affected."
      },
      {
        "power_id": "P1-voice-feedback-or-petition",
        "meaning": "Can supply criticism, information, consultation, complaint, or petition but no observed binding change right."
      },
      {
        "power_id": "P2-local-operational-discretion",
        "meaning": "Can execute, approve, configure, manage, or alter bounded implementation."
      },
      {
        "power_id": "P3-gate-veto-or-collective-leverage",
        "meaning": "Can control a gate, exercise a reserved veto, or use demonstrated collective leverage capable of changing a decision."
      },
      {
        "power_id": "P4-compulsory-revision-reversal-or-termination",
        "meaning": "Can compel disclosure, rule change, reversal, removal, substitution, or termination in the bounded system."
      }
    ],
    "material_relation": [
      {
        "material_id": "M1-purpose-or-governance-rights",
        "meaning": "Retains reserved purpose, authorship, voting, board, veto, or governance rights."
      },
      {
        "material_id": "M2-operating-or-action-authority",
        "meaning": "Receives authority to configure, approve, direct, query, classify, or act through the system."
      },
      {
        "material_id": "M3-capital-or-public-resource-provider",
        "meaning": "Supplies capital, public money, data infrastructure, facilities, or other scale resources."
      },
      {
        "material_id": "M4-labor-or-expertise-provider",
        "meaning": "Supplies labor, craft, technical knowledge, analysis, management, or implementation."
      },
      {
        "material_id": "M5-data-or-legibility-provider",
        "meaning": "Supplies data or becomes legible through institutional representation."
      },
      {
        "material_id": "M6-revenue-equity-ip-or-reputational-beneficiary",
        "meaning": "Receives revenue, equity, intellectual property, control, authorship credit, prestige, or strategic market benefit."
      },
      {
        "material_id": "M7-error-risk-or-consequence-bearer",
        "meaning": "Bears classification error, surveillance, denial, discipline, coercive consequence, or the cost of correction."
      },
      {
        "material_id": "M8-counterpower-or-remedy-provider",
        "meaning": "Supplies audit, advocacy, adjudication, bargaining, reversal, substitution, or remedy capacity."
      },
      {
        "material_id": "M9-legitimacy-or-translation-provider",
        "meaning": "Supplies civic, professional, doctrinal, customer, or institutional legitimacy and translation."
      },
      {
        "material_id": "M10-public-authority-provider",
        "meaning": "Supplies law, procurement, accreditation, sovereign authority, or public mission."
      },
      {
        "material_id": "M11-transition-or-exit-provider",
        "meaning": "Supplies migration, substitution, fallback, portability, or exit implementation."
      }
    ]
  },
