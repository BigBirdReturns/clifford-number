{
  "schema_version": "research-track-harness@1",
  "track_id": "tif-district-value-capture",
  "axis": "place-formation",
  "label": "Tax-increment-financing district value capture",
  "question": "Within a TIF district, whose parcels captured the increment-funded uplift, and were they positioned before the district was drawn?",
  "derived_from": [
    "arcadia-field-autopsy"
  ],
  "scan": {
    "kind": "place-signature",
    "params": {
      "program": "TIF district ordinance",
      "infra": "streetscape",
      "asset": "TIF district",
      "activation": "district adoption"
    },
    "spine": [
      {
        "stage_id": "tif-adoption",
        "label": "TIF district adoption",
        "search_templates": [
          "{place} tax increment financing district ordinance boundary date",
          "{place} TIF redevelopment plan projects list"
        ],
        "target_domain": "municipal_agenda_records"
      },
      {
        "stage_id": "public-commitment",
        "label": "Public de-risking commitment",
        "search_templates": [
          "{place} {program} adopted date public investment",
          "{place} capital improvement program {infra} scope"
        ],
        "target_domain": "municipal_and_transit_records"
      },
      {
        "stage_id": "entitlement-expansion",
        "label": "Entitlement / density / eligibility expansion",
        "search_templates": [
          "{place} zoning code amendment {asset} height density",
          "{place} general plan update {asset} mixed use"
        ],
        "target_domain": "municipal_planning_records"
      },
      {
        "stage_id": "intermediary-governance",
        "label": "Assessment or intermediary governance vehicle",
        "search_templates": [
          "{place} business improvement district formation assessment",
          "{place} development authority bylaws city agreement"
        ],
        "target_domain": "municipal_and_state_records"
      },
      {
        "stage_id": "patient-ownership",
        "label": "Patient ownership positioned before activation",
        "search_templates": [
          "{place} {asset} parcels acquired before {activation}",
          "{place} property acquisition entitlement application date"
        ],
        "target_domain": "county_recorder_and_agenda_records"
      },
      {
        "stage_id": "parcel-assembly",
        "label": "Parcel assembly including public land",
        "search_templates": [
          "{place} public land disposition development agreement",
          "{place} exclusive negotiation agreement {asset} parcel"
        ],
        "target_domain": "municipal_agenda_records"
      },
      {
        "stage_id": "value-uplift",
        "label": "Concentrated value uplift and capture",
        "search_templates": [
          "{place} {asset} value increase study",
          "{place} assessed value change who pays who benefits"
        ],
        "target_domain": "assessor_and_academic_records"
      }
    ]
  },
  "denominator": {
    "definition": "Adopted TIF districts in the jurisdiction slice.",
    "source": "Municipal TIF ordinances + state TIF registries",
    "discipline": "All districts enumerated."
  },
  "source_adapters": [
    {
      "adapter_id": "municipal-tif-ordinance",
      "surface": "Municipal TIF ordinance / redevelopment agenda",
      "mode": "photonic",
      "status": "new",
      "intake_layer": "screenghost",
      "note": ""
    },
    {
      "adapter_id": "county-assessor-roll",
      "surface": "County assessor increment / assessed-value roll",
      "mode": "structured",
      "status": "new",
      "intake_layer": "ghostbox",
      "note": "Some assessors publish rolls; others need ScreenGhost."
    },
    {
      "adapter_id": "county-recorder-deeds",
      "surface": "Deed chronology inside district boundary",
      "mode": "photonic",
      "status": "new",
      "intake_layer": "screenghost",
      "note": ""
    },
    {
      "adapter_id": "official-crawl",
      "surface": "Official-record crawler for district terms",
      "mode": "structured",
      "status": "reuse",
      "intake_layer": "direct",
      "note": "",
      "reuses": "tools/crawl-official.mjs"
    }
  ],
  "coverage_seed": [
    {
      "topic": "district-boundary list",
      "state": "not_searched"
    },
    {
      "topic": "increment allocation per district",
      "state": "not_searched"
    },
    {
      "topic": "pre-adoption ownership inside boundary",
      "state": "not_searched"
    },
    {
      "topic": "developer entitlement dates",
      "state": "not_searched"
    }
  ],
  "epistemic_contract": {
    "graph_effect": "none",
    "promotes_to": "candidate_only",
    "forbidden_inference": "A signature or crossing match never establishes coordination, influence, wrongdoing, or intent. Structural convergence on shared incentives is the null hypothesis; only document-level receipts can upgrade any candidate, and only a human reviewer can admit it.",
    "coverage_honesty": "not_searched is the honest default and may not cite executed searches. unavailable_after_search requires search provenance. A partial surface is never labeled complete; absence of evidence is a coverage result, not proof of absence.",
    "denominator_discipline": "Every score is over a declared, bounded universe. The denominator and its source are named; below-threshold members are retained, not dropped."
  },
  "custody": {
    "seals_into": "axm-genesis",
    "layer": "instrument (watershed layer 2)",
    "shard_profile": "place-formation-shard@1",
    "publication_layer": "field-autopsy",
    "status": "declared_not_wired",
    "note": "District-level formation cases seal with the TIF ordinance as anchor receipt.",
    "acceptance": "A track corpus is custody-ready when every admitted candidate's receipts compile into a genesis shard that passes `axm-verify` DETACHED (bytes + out-of-band key only). Until then receipts remain receipt-v2 provenance, honestly labeled."
  },
  "status": "scaffold"
}
