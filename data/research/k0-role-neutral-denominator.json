  "inclusion_rules": [
    "A dated governing claim and bounded domain are source-addressable.",
    "A person or body has a stated qualification basis in that bounded domain.",
    "A contradictory finding, warning, result, or professional judgment is documented as reaching the decision surface.",
    "A traceable gate action or attempted gate action follows.",
    "Alternative explanations and counterevidence are retained."
  ],
  "exclusion_rules": [
    "Fame, party, ideology, wealth, nationality, or anticipated news value selects the event.",
    "A bad outcome substitutes for a documented contradiction and gate action.",
    "Expert status substitutes for evidence that the expert was correct.",
    "Ordinary disagreement with independent merits review is treated as capture.",
    "A legitimate emergency or safety action with bounded expiry, evidence preservation, and independent stay is treated as capture.",
    "Unrelated performance or misconduct evidence is ignored because the person also dissented."
  ],
