  "interpretation_contract": {
    "contract_id": "preference-population-coverage-turnover-assurance@1",
    "what_this_is": "A synthetic eight-world control separating one complete-looking population-coverage publication from hard-to-enumerate, missingness, boundary, turnover, snapshot, lineage, correction, and authority state.",
    "what_this_is_not": "A real population census, missingness estimate, coverage finding, exclusion finding, discrimination finding, named-actor allegation, public-authority verdict, or effect estimate.",
    "copy_ready_caveat": "PC-36 shows that one population_coverage_verified publication can coexist with complete assurance, hard-to-enumerate undercoverage, missingness laundering, boundary truncation, entrant or exit propagation failure, structural turnover and snapshot failure, or stale lineage. It creates no real-world finding."
  },
