  "prohibited_inferences": [
    "Do not treat the fixture as evidence that any named service, provider, market, policy, workflow, or institution has complete or failed service-denominator assurance.",
    "Do not infer the operationally eligible population from the declared eligible denominator.",
    "Do not infer absence of service need from absence of a recorded request.",
    "Do not infer absence of an attempt when intake, channel, identity, duplicate, or logging failure remains possible.",
    "Do not infer zero queue or a complete wait distribution from one queue snapshot or a published median.",
    "Do not infer absence of rationing, priority overrides, displacement, or capacity denial from a zero published rationing count.",
    "Do not infer a true non-denial disposition from referral, deferral, ineligibility, no-response, withdrawal, or pending labels without a complete crosswalk.",
    "Do not infer zero true denial from a zero published denial rate.",
    "Do not infer complete unserved-population coverage from a zero published unserved count.",
    "Do not infer unique substantive durable completion from a service record or completion label.",
    "Do not treat starts, partials, duplicates, rework, recurrence, or survivor-only observations as durable completion.",
    "Do not infer current assurance from historical evidence after eligibility, intake, queue, rationing, denial, service, workflow, population, or policy succession.",
    "Do not infer coercion, manipulation, discrimination, breach, misconduct, coordination, common purpose, or intent from service-denominator failure.",
    "Do not infer public authorization from denominator, queue, denial, completion, monitoring, correction, or lineage completeness.",
    "Do not treat synthetic counts as real-world prevalence or effect estimates.",
    "Do not treat the thirty-one-control floor as exhaustive of every legal, economic, constitutional, security, social, or performative failure mode."
  ],
  "interpretation_contract": {
    "contract_id": "preference-service-denominator-assurance@1",
    "what_this_is": "A synthetic eight-world control that holds one complete-looking service-denominator publication fixed while changing operational eligibility, requests, attempts, queues, waits, rationing, priorities, denial labels, unserved coverage, completion reconciliation, lineage, correction, and authority.",
    "what_this_is_not": "A real service audit, access determination, denial finding, quality finding, discrimination finding, public-authority verdict, or inference of intent.",
    "copy_ready_caveat": "A public service-denominator-verified status, one hundred published records, a one-hundred-percent completion rate, zero queue, rationing, denial, or unserved counts, and a five-day median wait do not identify complete operational eligibility, request, queue, rationing, denial, unserved, completion, lineage, correction, or authority custody."
  },
