  "interpretation_contract": {
    "contract_id": "preference-hard-to-enumerate-missingness-assurance@1",
    "what_this_is": "A synthetic eight-world control separating one complete-looking hard-to-enumerate and missingness publication from subgroup enumeration, response and source missingness, proxy validation, external-frame, imputation, lineage, correction, and authority state.",
