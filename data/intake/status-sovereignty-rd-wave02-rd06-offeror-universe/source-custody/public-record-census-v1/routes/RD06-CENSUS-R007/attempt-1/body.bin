                        <span class="image-caption">
              <span class="caption-text">
                
                <span class="caption-author"> (Photo Credit: U.S. Army)</span>
              </span>
              <a href="https://api.army.mil/e2/c/images/2018/08/15/527109/original.jpg" title="View original" target="_blank" rel="noopener">VIEW ORIGINAL</a>
            </span>
          </figcaption>
