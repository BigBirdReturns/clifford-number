                <div id="article-top" class="row">
                    <div class="span12">
                        <h1>U.S. Army releases DCGS-A Increment 2 'request for proposals'</h1>
                        <p class="small">By U.S. Army Public Affairs<span>December 23, 2015</span></p>
                        <section class="alt-social-bar">
  <ul>
        <li class="social-button-sm twitter-button">
            <a rel="noopener noreferrer" target="_blank" href="https://twitter.com/share?url=https%3A%2F%2Fwww.army.mil%2Farticle%2F160385%2Fu_s_army_releases_dcgs_a_increment_2_request_for_proposals&amp;text=U.S.%20Army%20releases%20DCGS-A%20Increment%202%20%27request%20for%20proposals%27"><span role="img">Share on Twitter</span></a>
        </li>
        <li class="social-button-sm facebook-button">
            <a rel="noopener noreferrer" target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fwww.army.mil%2Farticle%2F160385%2Fu_s_army_releases_dcgs_a_increment_2_request_for_proposals"><span role="img">Share on Facebook</span></a>
