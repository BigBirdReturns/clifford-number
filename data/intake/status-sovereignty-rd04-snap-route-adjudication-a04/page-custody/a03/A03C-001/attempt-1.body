        <div class="block full AgenciesEmbedBlock_DynamicProxy">
    <div id="agenciesEmbedWrap_b877e26b514244438e978eee39b754e0" class="agencies-embed">
        <iframe
            id="agenciesIframe_29ebfea6dcf84135b6aed387809df1a2"
            src="https://notice.nv.gov/home/subtodaymeetings?parentOrigin=https%3A%2F%2Fwww.nv.gov"
            title="subtodaymeetings"
            scrolling="no"
            loading="eager">
        </iframe>
    </div>
    <style>
        .agencies-embed {
            width: 100%;
            max-width: 100%;
            overflow: hidden !important;
            position: relative;
            margin: 0;
            padding: 0;
        }

        .agencies-embed iframe {
            display: block;
            width: 100%;
            height: 420px;
            min-height: 420px;
            border: 0;
            overflow: hidden !important;
            margin: 0;
            padding: 0;
        }

        @media (max-width: 767px) {
            .agencies-embed iframe {
                height: 520px;
                min-height: 520px;
            }
        }

        @media (orientation: landscape) and (max-width: 1024px) {
            .agencies-embed iframe {
                height: 360px;
                min-height: 360px;
            }
        }
    </style>
    <script>
    (function () {
        var iframe = document.getElementById('agenciesIframe_29ebfea6dcf84135b6aed387809df1a2');
        var wrapper = document.getElementById('agenciesEmbedWrap_b877e26b514244438e978eee39b754e0');
        var childOrigin = 'https://notice.nv.gov';
        var hasMeasured = false;

        if (!iframe || !wrapper) return;

        function requestHeight() {
            if (!iframe.contentWindow) return;

            iframe.contentWindow.postMessage(
                { type: 'nvgov-agencies-request-height' },
                childOrigin
            );
        }

        function applyHeight(contentHeight) {
            var parsedHeight = parseInt(contentHeight, 10);
            if (isNaN(parsedHeight) || parsedHeight <= 0) return;

            var finalHeight = parsedHeight + 12;
            hasMeasured = true;

            wrapper.style.height = finalHeight + 'px';
            wrapper.style.minHeight = '0';
            iframe.style.height = finalHeight + 'px';
            iframe.style.minHeight = '0';
        }

        window.addEventListener('message', function (event) {
            if (event.origin !== childOrigin) return;
            if (!event.data) return;

            if (event.data.type === 'nvgov-agencies-height') {
                applyHeight(event.data.height);
            }

            if (event.data.type === 'nvgov-agencies-scrollTo') {
                var top = parseInt(event.data.top, 10);
                if (!isNaN(top)) {
                    var iframeTop = wrapper.getBoundingClientRect().top + window.pageYOffset;

                    window.scrollTo({
                        top: Math.max(iframeTop + top - 16, 0),
                        behavior: 'smooth'
                    });
                }
            }
        });

        iframe.addEventListener('load', function () {
            requestHeight();
            window.setTimeout(requestHeight, 100);
            window.setTimeout(requestHeight, 300);
            window.setTimeout(requestHeight, 700);
            window.setTimeout(requestHeight, 1200);
        });

        window.addEventListener('resize', function () {
            if (hasMeasured) {
                requestHeight();
            }
        });

        window.addEventListener('orientationchange', function () {
            window.setTimeout(requestHeight, 100);
            window.setTimeout(requestHeight, 400);
        });
    })();
    </script>
</div>
    
