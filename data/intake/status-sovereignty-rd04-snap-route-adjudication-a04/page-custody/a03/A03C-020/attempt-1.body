6 col-md-2 mt-0"><a href="/page/social-media/"><span class="fad fa-hashtag fa-fw" role="img" aria-hidden="true"></span><span>Social Media</span></a></li><li class="col-6 col-md-2 mt-0"><a href="/page/photos/"><span class="fad fa-images fa-fw" role="img" aria-hidden="true"></span><span>Photos</span></a></li><li class="col-6 col-md-2 mt-0"><a href="#" onclick="window.hiChat.open()" id="hiChatButton" aria-label="open help chat" aria-haspopup="dialog"><span class="fad fa-user-headset fa-fw" role="img" aria-hidden="true"></span><span>Help Chat</span></a></li></ul><hr></div></div><div class="row copyright"><div class="col"><span>&copy; 2026 State of Hawai&#699;i. All Rights Reserved. An Equal Opportunity Employer.</span> <a href="/page/accessibility/">Accessibility</a><div style="display: inline-block;">&nbsp;|&nbsp;</div><a href="/page/privacy-policy/">Privacy Policy</a><div style="display: inline-block;">&nbsp;|&nbsp;</div><a href="/page/terms-of-use/">Terms of Use</a></div></div><button id="scrollTop" aria-label="Back to top"><span class="fad fa-arrow-alt-to-top" role="img" aria-hidden="true"></span> <span class="sr-only">scroll to top</span></button></div><div class="clip"></div><div class="sectionBg"></div></footer></div><div id="contentSearchContainer" style="display: none;" role="search"><div class="container"><div class="row"><div class="col-md-6 offset-md-3 text-center sliverSearchContainer"><form action="/page/search/" method="get"><label for="q-sliver" class="sr-only sliverSearchLabel">Search hawaii.gov</label><div class="input-group"><input type="text" class="form-control form-control-lg" name="q" id="q-sliver" placeholder='search hawaii.gov, e.g. "jobs"' aria-label="Search"> <input type="hidden" name="page" value="1"><div class="input-group-append"><button class="btn btn-primary" type="submit"><span class="fas fa-search" aria-hidden="true"></span> <span class="sr-only">Search</span></button></div></div><a href id="closeSearch" role="button"><span class="fas fa-times" aria-hidden="true"></span> Close</a></form></div></div></div></div><script src="/assets/scripts/scripts.min.js"></script><script type="text/javascript">// type effect on search box
			// BEGIN ======================================================================
			//https://codepen.io/mikedevelops/pen/vOavQB
			// your custom placeholder goes here!
			var ph = "search hawaii.gov, e.g. \"jobs\"",
				searchBar = $('#q'),
				// placeholder loop counter
				phCount = 0;
			
			// function to return random number between
			// with min/max range
			function randDelay(min, max) {
				return Math.floor(Math.random() * (max-min+1)+min);
			}
			
			// function to print placeholder text in a 
			// 'typing' effect
			function printLetter(string, el) {
				// split string into character seperated array
				var arr = string.split(''),
					input = el,
					// store full placeholder
					origString = string,
					// get current placeholder value
					curPlace = $(input).attr("placeholder"),
					// append next letter to current placeholder
					placeholder = curPlace + arr[phCount];
					
				setTimeout(function(){
					// print placeholder text
					$(input).attr("placeholder", placeholder);
					// increase loop count
					phCount++;
					// run loop until placeholder is fully printed
					if (phCount < arr.length) {
						printLetter(origString, input);
					}
				// use random speed to simulate
				// 'human' typing
				}, randDelay(50, 90));
			}  
			
			// function to init animation
			function placeholder() {
				$(searchBar).attr("placeholder", "");
				printLetter(ph, searchBar);
			}
			
			placeholder();
			
			function checkSearchText(value) {
				if(value.length > 0) {
					$('.titleSearchLabel').removeClass('sr-only');
				}
				else {
					$('.titleSearchLabel').addClass('sr-only');
				}
			}
			
			checkSearchText($('#q').val());
			
			$(window).on('pageshow', function(event) {
				checkSearchText($('#q').val());
			})
			
			$('#q').on('input', function() {
				checkSearchText($(this).val());
			});
			
			$('.submit').click(function(e){
				phCount = 0;
				e.preventDefault();
				placeholder();
			});
			
			$('.countup').each(function() {
				var value = $(this).data('count');
				
				$(this).countup(value);
			});
			
			function titleCaseWithAcronymsAndPunctuation(str, acronyms = []) {
				if (typeof str !== 'string' || str.length === 0) {
					return '';
				}
			
				// Use a Set for fast, case-insensitive acronym lookup
				const acronymSet = new Set(acronyms.map(a => a.toUpperCase()));
			
				// 1. Convert the entire string to lowercase for normalization
				let result = str.toLowerCase();
			
				// 2. Define the capitalization regex
				// This regex matches a character that immediately follows:
				// (?:^|[\.!?()'"\/\s]) - A non-capturing group for the boundary:
				//    ^                  - Start of the string (for the first word)
				//    |                  - OR
				//    [\.!?()'"\/\s]     - Any sentence-ending punctuation, parenthesis, quote, or whitespace
				// ([a-z]) - The character to be capitalized (captured in group 1)
				const capitalizationRegex = /(?:^|[\.!?()'"\/\s])([a-z])/g;
			
				// 3. Apply standard capitalization first
				result = result.replace(capitalizationRegex, (match, char) => {
					// 'match' is the boundary + the letter (e.g., ' a', '.t', '"h')
					// 'char' is just the letter (e.g., 'a', 't', 'h')
					return match.toUpperCase();
				});
			
				// 4. Handle Acronyms (must be done AFTER standard capitalization)
				// Split by whitespace and iterate to check for acronyms
				return result
					.split(/\s+/)
					.map(word => {
						if (word.length === 0) {
							return '';
						}
			
						// Remove leading/trailing non-word characters for a clean lookup
						const cleanWord = word.replace(/^\W+|\W+$/g, '').toUpperCase();
						
						// If the word (cleaned) is in the acronym set
						if (acronymSet.has(cleanWord)) {
							// Return the original word in ALL CAPS (preserving any punctuation)
							return word.toUpperCase();
						}
						
						// Otherwise, return the word as it was title-cased in step 3
						return word;
					})
					.join(' ');
			}
			
			const acronymList = [
				
					
						'DLIR',
					
				
					
						'DOH',
					
				
					
						'HDOT',
					
				
					
						'DHHL',
					
				
					
						'HNL',
					
				
					
						'DBEDT',
					
				
					
