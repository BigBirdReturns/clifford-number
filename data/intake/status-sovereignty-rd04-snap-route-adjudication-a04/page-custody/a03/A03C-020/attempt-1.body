						'OIP',
					
				
					
						'DLNR',
					
				
					
						'DOT',
					
				
					
						'TAX',
					
				
					
						'DOTAX',
					
				
					
						'LTGOV',
					
				
					
						'CSC',
					
				
					
						'DLE',
					
				
					
						'UH',
					
				
					
						'ERS',
					
				
					
						'EUTF',
					
				
					
						'AHC',
					
				
					
						'SFCA',
					
				
					
						'SPO',
					
				
					
						'HCJDC',
					
				
					
						'CSEA',
					
				
					
						'FTZ',
					
				
					
						'FTZ9',
					
				
					
						'HSEO',
					
				
					
						'HCDA',
					
				
					
						'HTA',
					
				
					
						'HTDC',
					
				
					
						'BREG',
					
				
					
						'PUC',
					
				
					
						'PVL',
					
				
					
						'RICO',
					
				
					
						'HPA',
					
				
					
						'HIEMA',
					
				
					
						'EOEL',
					
				
					
						'HTSB',
					
				
					
						'BOE',
					
				
					
						'DOFAW',
					
				
					
						'DOBOR',
					
				
					
						'DOCARE',
					
				
					
						'OHS',
					
				
					
						'LRB',
					
				
					
						'DAR',
					
				
					
						'USDA',
					
				
					
						'EPA',
					
				
					
						'DOJ',
					
				
					
						'DEA',
					
				
					
						'CIA',
					
				
					
						'FBI',
					
				
					
						'FOIA',
					
				
					
						'IRS',
					
				
					
						'USA',
					
				
					
						'AFTA',
					
				
					
						'BLNR',
					
				
					
						'WCF',
					
				
					
						'HIARNG',
					
				
					
						'HIANG',
					
				
					
						'PAR',
					
				
					
						'OVS',
					
				
					
						'DAB',
					
				
					
						'CRB',
					
				
					
						'U.S.',
					
				
					
						'USA',
					
				
					
						'WIC',
					
				
					
						'RFP',
					
				
					
						'H-3',
					
				
					
						'H-2',
					
				
					
						'H-1',
					
				
					
						'FAQS',
					
				
					
						'ATG',
					
				
					
						'EOEL',
					
				
					
						'FY',
					
				
					
						'UIPA',
					
				
					
						'SNAP',
					
				
					
						'PSA',
					
				
					
						'CWS',
					
				
					
						'WCHA',
					
				
					
						'AAP',
					
				
					
						'FEMA'
					
				
			]
			
			$('#home-latestNews').find('.newsTitle').each(function() {
				let newstitle = $(this).data('title');
				
				$(this).text(titleCaseWithAcronymsAndPunctuation(newstitle, acronymList))
			})
			
			// END ======================================================================</script><script type="text/javascript">!function(){var e=document.createElement("script");e.type="text/javascript",e.async=!0,e.src="//siteimproveanalytics.com/js/siteanalyze_6126231.js";var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t)}()</script><script>!function(e,a,t,g,n,c,r){e.GoogleAnalyticsObject=n,e.ga=e.ga||function(){(e.ga.q=e.ga.q||[]).push(arguments)},e.ga.l=1*new Date,c=a.createElement(t),r=a.getElementsByTagName(t)[0],c.async=1,c.src="//www.google-analytics.com/analytics.js",r.parentNode.insertBefore(c,r)}(window,document,"script",0,"ga"),ga("create","UA-939376-1","auto"),ga("create","UA-48754002-1","auto",{name:"tracker2"}),ga("create","UA-172740467-1","auto",{name:"tracker3"}),ga("send","pageview"),ga("tracker2.send","pageview"),ga("tracker3.send","pageview")</script></body><!-- 2026-08-01 14:01:59 -1000 --></html>