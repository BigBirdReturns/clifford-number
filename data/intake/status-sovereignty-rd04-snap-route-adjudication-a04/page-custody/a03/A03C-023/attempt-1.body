<!-- Accessibility button movement Stuff -->
<script>

window.addEventListener("load", function () {
    // Combine normal and adopted stylesheets
    const styleSheets = [
        ...document.styleSheets,
        ...(document.adoptedStyleSheets || [])
    ];

    styleSheets.forEach(sheet => {
        let rules;
        try {
            rules = sheet.cssRules;
        } catch (e) {
            // Skip CORS-protected or unreadable stylesheets
            return;
        }
        if (!rules) return;

        // Loop through all CSS rules inside the stylesheet
        for (let i = 0; i < rules.length; i++) {
            const rule = rules[i];

            // Only look at style rules
            if (rule.style && rule.style.getPropertyValue("--offset-top") !== "") {
                rule.style.setProperty("--offset-top", "100px");
            }
        }
    });
});

</script>
<!-- Accessibility button movement Stuff End -->
<style>

    #slideshow-container {
        margin-top: 0px;
    }
    
