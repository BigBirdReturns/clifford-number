<script>
	require([
		'jquery',
		'plugins_nav_custom_nav_desktop_grid',
		'plugins_nav_custom_nav_mobile_grid',
	], function($, navDesktop, navMobile) {
		var root = $('[data-guid="77bee1bb-40c2-45c5-abec-d8fd556e324f"]');
		var navTreeDepth = 1;

		navDesktop.init(root, '[data-primary-nav-desktop]', navTreeDepth, true);
		navMobile.init(root, '[data-primary-nav-mobile]', '[data-main-nav-cont]', navTreeDepth, true);

		root.find('[data-action="toggle-menu"]').on('click', function() {
			$(this).toggleClass('active');
			$(this).attr('aria-expanded', $(this).hasClass('active'));

			toggleNav();
			$('#primary-site-menu').toggleClass('active');

			// use this to prevent the body from scrolling when the mobile menu is open
			// $('body').toggleClass('mobile-menu-active');
		});

		// calculate the scrollbar width in each browser. for use in styling the full-width nav.
		const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
		document.documentElement.style.setProperty('--scrollbar-width', `${scrollbarWidth}px`);


		// move the regions maps into their nav containers
		const regionsMapDesktop = $('.regions-map')[0];
		if (regionsMapDesktop !== undefined) {
			const regionsDestDesktop = $('.navigation.navigation-grid.desktop').find('[data-regions-destination]');
			regionsDestDesktop.append( $(regionsMapDesktop) );
		}

		const regionsMapMobile = $('.regions-map')[1];
		if (regionsMapMobile !== undefined) {
			const regionsDestMobile = $('#primary-site-menu.mobile-nav-container').find('[data-regions-destination]');
			regionsDestMobile.append( $(regionsMapMobile) );
		}

		function toggleNav(el) {
			const mobileNav = el ? $(el) : $('#primary-site-menu .mobile-nav');

			if ($('#primary-site-menu').hasClass('active')) {
				const mobileNav = $('#primary-site-menu .mobile-nav');
				mobileNav.css('width', 0);
			} else {
				if ($(window).width() < 390) {
					mobileNav.css('width', '100%');
				} else {
					mobileNav.css('width', '390px');
				}
			}
		}

		$('body').addClass('desktop-nav-loaded');

	});
</script>

</div>
			</div>
		</div>
	</div>

	<div id="primary-site-menu" class="mobile-nav-container" data-mobile-nav>
		<div class="mobile-nav">
			
			<div class="mobile-main-nav" data-main-nav-cont></div>
			<div class="mobile-secondary-nav" data-secondary-nav-cont></div>
