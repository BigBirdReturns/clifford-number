			<div class="header-widgets-container"><div data-civid="67c611b36236e066017046d3" class="contentRender contentRender_2 contentRender_type_panel contentRender_name_plugins_common_header_widgets_container" data-sv-time="2" data-sv-index="2" data-gtm-vars='{ "tCore" : { "contentNum" : "1" } }'><div class="panel-header-widgets" style="opacity: 0;" data-guid="db723533-8733-4b5b-847b-f7c30f367b25">
	<div class="header-widgets-wrapper">
		<div class="header-widget search-link">
			<div data-civid="67c611bc6236e066017046d6" class="contentRender contentRender_3 contentRender_type_widget contentRender_name_plugins_search_headerbox" data-sv-time="139" data-sv-index="3" data-gtm-vars='{ "tCore" : { "contentNum" : "1" } }'>



<div class="search-cont" data-guid="6f102d7a-b3a8-4d08-a591-9b8a0526a278">
	<form
		class="headerbox-search-form"
		data-sv-searchForm action="/search/"
		method="GET"
	>
		<input
			data-sv-search-input
			name="q"
			type="search"
			class="searchInput"
			autocomplete="off"
			autocorrect="off"
			autocapitalize="off"
			placeholder="Search this site..."
			value=""
		/>
		<button type="submit" data-sv-search-button>
			<span class="header-icon search-icon" aria-hidden="true"></span>
		</button>
	</form>
	<button
		class="search-button"
		data-toggle-search
		aria-expanded="false"
		aria-label="toggle search dropdown"
		aria-controls="headerbox-search-form"
	>
		<span class="search-icon" aria-hidden="true"></span>
		<i class="fas fa-times close" aria-hidden="true"></i>
		<div class="button-label">Search</div>
	</button>
</div>

<script>
require(['domReady!'], function() {
	const root = document.querySelector('[data-guid="6f102d7a-b3a8-4d08-a591-9b8a0526a278"]');
	const searchCont = document.querySelector('[data-search-cont]');
	const hideSearchActiveEls = document.querySelectorAll('[data-hide-search-active]');

	const handleSearch = function(toggle) {
		if (toggle !== null && toggle.getAttribute('data-has-handler') === null) {
			toggle.setAttribute('data-has-handler',true);

			toggle.addEventListener('click', function() {
				let searchCont = this.parentNode;
				searchCont.classList.toggle('active');
				this.classList.toggle('active');
				// toggle class for all top row header items
				hideSearchActiveEls.forEach(el => el.classList.toggle('search-active'));
				let isActive = searchCont.classList.contains('active');
				this.getAttribute('aria-expanded', isActive);

				if (isActive) {
					document.body.classList.add('search-active');
					searchCont.querySelector('[data-sv-search-input]').focus();
				} else {
					document.body.classList.remove('search-active');
				}
			});
		}

		document.querySelectorAll('[data-sv-searchForm]').forEach(form => {
			let input = form.querySelector('[data-sv-search-input]');

			if (input !== null && input.getAttribute('data-has-handler') === null) {
				input.setAttribute('data-has-handler',true);

				form.addEventListener('submit', function(e) {
					if (input.value.length === 0) {
						e.preventDefault();
						this.querySelector('[data-sv-search-input]').focus();
					}
				});
			}
		});
	}

	if (searchCont !== null) {
		// clone to mobile nav - used by original navigation
		searchCont.replaceWith(root.cloneNode(true));
	}

	const desktopSearch = document.querySelector('.panel-header .nav-content-container .top-content .top-content-right [data-toggle-search]');
	const mobileSearch = document.querySelector('.panel-header .mobile-nav-container [data-toggle-search]');
	handleSearch(mobileSearch);
	handleSearch(desktopSearch);
});
</script>
</div>
