	<button
		class="menu-toggle"
		type="button"
		aria-label="toggle menu"
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="primary-site-menu"
		data-action="toggle-menu"
	>
		<div class="mobile-nav-icon">
			<img src="/includes/public/assets/shared/menu-search.svg" aria-hidden="true">
			<span class="text" aria-hidden="true">Menu</span>
		</div>
		<div class="mobile-nav-icon open">
			<img src="/includes/public/assets/shared/menu-close.svg" aria-hidden="true">
			<span class="text" aria-hidden="true">Close</span>
		</div>
	</button>

	
		<nav class="navigation navigation-grid primary desktop" data-primary-nav-desktop>
			<script type="text/template" data-nav-item-template>{{+nav_items}}
	{{+nav_items_helper}} {{!-- This nested partial is necessary to make this partial recursive because helpers.partial 
		only outputs the inner text of the partial, not the partial name. Please do not remove! --}}
		{{#shownchildren}}
			{{~exec(function() {
				if (!data.isLazyLoaded) {
					helpers.var.depth = 1;
					helpers.var.topLevel = true;
				} else {
					helpers.var.depth = data.depth;
				}
			})}}
			<div
				class="nav-item level-{{~var.depth}} {{data.section}}{{:shownchildren}} has-children{{/}}"
				data-id="{{data.id}}"
				data-nav-item
			>
				<div class="nav-item-control level-{{~var.depth}}">
					{{:~var.topLevel}}
						<div class="level-1-wrapper">
					{{/}}
					<a
						class="nav-link"
						href="{{href}}"
						target="{{target}}"
					>
						{{:~equal(helpers.var.depth > 1 && data.data.sources !== undefined, true)}}
							<picture>
								<source
									srcset="{{data.sources.desktop}}"
									media="(min-width: 64em)"
								/>
								<img
									src="{{data.sources.mobile}}"
									alt="{{data.title}}"
								>
							</picture>
						{{/}}
						<div class="item-title">
							{{data.title}}
						</div>
					</a>
					{{:shownchildren}}
						<button
							id="{{data.id}}"
							class="dropdown-toggle"
							aria-label="open submenu"
							aria-haspopup="true"
							aria-expanded="false"
							data-dropdown-toggle
						>
							{{:~var.topLevel}}
								<div class="menu-label">Menu</div>
							{{/}}
							<i class="icon-toggle fas fa-chevron-right" aria-hidden="true"></i>
						</button>
					{{/}}
					{{:~equal(data.data.folder === 'regions', true)}}
						<button
							id="regions-toggle"
							class="dropdown-toggle"
							aria-label="open submenu"
							aria-haspopup="true"
							aria-expanded="false"
							data-regions-toggle
						>
							<div class="menu-label">Menu</div>
							<i class="icon-toggle fas fa-chevron-right" aria-hidden="true"></i>
						</button>
					{{/}}
					{{:~var.topLevel}}
						</div>
						<a
							class="extra-link"
							href="{{href}}"
							target="{{target}}"
						>
							{{data.title}}
						</a>
					{{/}}
				</div>
				{{:shownchildren}}
					<div
						class="dropdown-menu level-{{~var.depth}}{{:isLazyLoaded}}{{:shownChildren.0}} rendered{{/}}{{/}}"
						aria-labelledby="{{data.id}}"
						data-parent-id="{{data.id}}"
						data-start="{{data.folderHref}}"
						data-section="{{data.section}}"
						data-dropdown-menu
						style="display: none"
					>
						{{:isLazyLoaded}}
							{{>nav_items_helper}}
						{{/}}
					</div>
				{{/}}
				{{:~equal(data.data.folder === 'regions', true)}}
					<div class="regions-destination" data-regions-destination></div>
				{{/}}
			</div>
		{{/}}
	{{/}}
	{{>nav_items_helper}}
{{/}}

{{>nav_items}}</script>
			


	
	 
		
			
