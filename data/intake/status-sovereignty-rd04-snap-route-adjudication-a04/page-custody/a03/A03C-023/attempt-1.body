			<a href="{{link.url}}" target="{{link.target}}">
				<div class="image-container">
					<img src="{{asset.resource.getThumbnailUrl({ width: 150, fetch_format: 'jpg' })}}" alt="{{%asset.alt_text}}" loading="lazy" fetchpriority="low" />
				</div>
