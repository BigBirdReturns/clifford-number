		<h3>Explore Indiana's Regions</h3>

		<a data-link="northwest" class="north" href="/regions/northwest/" id="btn-northwest" role="button">Northwest</a>
		<a data-link="northcentral" class="north" href="/regions/north-central/" id="btn-northcentral" role="button">North Central</a>
		<a data-link="northeast" class="north" href="/regions/northeast/" id="btn-northeast" role="button">Northeast</a>
		<a data-link="wabash" class="north" href="/regions/wabash-valley/" id="btn-wabash" role="button">Wabash Valley</a>

		<a data-link="westcentral" class="central" href="/regions/west-central/" id="btn-westcentral" role="button">West-Central</a>
		<a data-link="centralcentral" class="central" href="/regions/central/" id="btn-centralcentral" role="button">Central</a>
		<a data-link="eastcentral" class="central" href="/regions/east-central/" id="btn-eastcentral" role="button">East Central</a>

		<a data-link="uplands" class="south" href="/regions/southcentral/" id="btn-uplands" role="button">South Central</a>
		<a data-link="southwest" class="south" href="/regions/southwest/" id="btn-southwest" role="button">Southwest</a>
		<a data-link="southeast" class="south" href="/regions/southeast/" id="btn-southeast" role="button">Southeast</a>
		<a data-link="southcentral" class="south" href="/regions/south/" id="btn-southcentral" role="button">South</a>
	</div>
</div>

<script>
	require(['domReady!'], function() {
		// List of data-link values to target
		const targetDataLinks = [
			'northwest',
			'northcentral',
			'northeast',
			'wabash',
			'westcentral',
			'centralcentral',
			'eastcentral',
			'uplands',
			'southwest',
			'southeast',
			'southcentral'
		];

		// Function to target specific IDs based on data-link values
		const targetSpecificId = (dataLinkValue, action) => {
			let targetId;
			if (['northwest', 'northcentral', 'northeast', 'wabash'].includes(dataLinkValue)) {
				targetId = 'north-lower';
			} else if (['westcentral', 'centralcentral', 'eastcentral'].includes(dataLinkValue)) {
				targetId = 'central-lower';
			} else if (['uplands', 'southwest', 'southeast', 'southcentral'].includes(dataLinkValue)) {
				targetId = 'south-lower';
			}

			if (targetId) {
				const targetElement = document.getElementById(targetId);
				if (action === 'add') {
					targetElement.classList.add('hovered');
				} else {
					targetElement.classList.remove('hovered');
				}
			}
		};

		// Function to add or remove 'active' class to all elements with the same data-link value
		const updateActiveClass = (dataLinkValue, action) => {
			const elements = document.querySelectorAll(`[data-link="${dataLinkValue}"]`);
			elements.forEach(element => {
				if (action === 'add') {
					element.classList.add('active');
					targetSpecificId(dataLinkValue, 'add');
				} else {
					element.classList.remove('active');
					targetSpecificId(dataLinkValue, 'remove');
				}
			});
		};

		// Function to add event listeners
		const addEventListeners = (dataLinkValue) => {
			const elements = document.querySelectorAll(`[data-link="${dataLinkValue}"]`);
			elements.forEach(element => {
				element.addEventListener('mouseover', () => updateActiveClass(dataLinkValue, 'add'));
				element.addEventListener('mouseout', () => updateActiveClass(dataLinkValue, 'remove'));
			});
		};

		// Apply event listeners to each data-link value
		targetDataLinks.forEach(dataLinkValue => addEventListeners(dataLinkValue));
	});
</script>
</div>
	</div>
