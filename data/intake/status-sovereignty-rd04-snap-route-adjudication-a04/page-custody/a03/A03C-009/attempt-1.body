				<div class="elementor-element elementor-element-5d880b2 elementor-widget-mobile__width-initial elementor-widget__width-initial elementor-widget elementor-widget-html" data-id="5d880b2" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<script>
(function(){
  const BP = 1023;

  // remove existing handler if present (idempotent)
  if (document._minimalSubHandler) {
    document.removeEventListener('click', document._minimalSubHandler, true);
    document._minimalSubHandler = null;
  }

  // helpers
  function findSub(a){
    if(!a) return null;
    let n = a.nextElementSibling;
    if(n && n.classList && n.classList.contains('sub-menu')) return n;
    const li = a.closest('li');
    if(li) return li.querySelector(':scope > .sub-menu');
    return null;
  }

  function findContainerForUl(ul){
    if(!ul) return null;
    // look up for an ancestor that Elementor uses as dropdown container
    return ul.closest('.elementor-nav-menu--dropdown, .elementor-nav-menu__container') || ul.parentElement || null;
  }

  // Save/restore inline style on container to avoid permanent changes
  function saveInline(container){
    if(!container) return;
    if(!container.dataset._origStyle) container.dataset._origStyle = container.getAttribute('style') || '';
  }
  function clearProblemInline(container){
    if(!container) return;
    // remove only the inline properties that usually cause the huge layout
    try {
      container.style.removeProperty('--menu-height');
      container.style.removeProperty('width');
      container.style.removeProperty('left');
      container.style.removeProperty('right');
      container.style.removeProperty('top');
      container.style.removeProperty('height');
      container.style.removeProperty('transform');
      container.style.removeProperty('max-width');
      container.style.removeProperty('max-height');
    } catch(e){}
  }
  function restoreInline(container){
    if(!container) return;
    if(container.dataset._origStyle !== undefined){
      container.setAttribute('style', container.dataset._origStyle);
      delete container.dataset._origStyle;
    }
  }

  function openAnchor(a){
    if(!a) return;
    const ul = findSub(a);
    const container = findContainerForUl(ul);

    saveInline(container);
    clearProblemInline(container);

    a.setAttribute('aria-expanded','true');
    a.setAttribute('data-open-by-js','1');
    if (ul) {
      ul.setAttribute('aria-expanded','true');
      ul.setAttribute('data-open-by-js','1');
      // ensure shown (Elementor may hide/show; we make it visible)
      ul.style.display = 'block';
    }
  }

  function closeAnchor(a){
    if(!a) return;
    const ul = findSub(a);
    const container = findContainerForUl(ul);

    a.setAttribute('aria-expanded','false');
    a.removeAttribute('data-open-by-js');
    a.removeAttribute('data-open-once');

    if(ul){
      ul.setAttribute('aria-expanded','false');
      ul.removeAttribute('data-open-by-js');
      ul.style.display = 'none';
    }

    // restore original inline style to the dropdown container
    restoreInline(container);
  }

  function closeAllExcept(except){
    const anchors = document.querySelectorAll('a.has-submenu, a.elementor-item.has-submenu');
    anchors.forEach(a=>{
      if(a === except) return;
      closeAnchor(a);
    });
  }

  // main click handler
  function handler(e){
    if(window.innerWidth > BP) return;

    const clicked = e.target.closest('a.has-submenu, a.elementor-item.has-submenu');
    if(clicked){
      const ul = findSub(clicked);
      const isOpen = (clicked.getAttribute('aria-expanded') === 'true') || clicked.hasAttribute('data-open-by-js');

      if(!isOpen){
        // first tap: open and prevent navigation
        e.preventDefault();
        closeAllExcept(clicked);
        openAnchor(clicked);
        // mark first-open so second tap navigates
        clicked.setAttribute('data-open-once','1');
        return;
      }

      // already open
      if(clicked.hasAttribute('data-open-once')){
        // allow default (navigation) on second tap
        clicked.removeAttribute('data-open-once');
        return;
      }

      // otherwise toggle close
      e.preventDefault();
      closeAnchor(clicked);
      return;
    }

    // click outside -> close all and restore inline on their containers
    if(!e.target.closest('.elementor-nav-menu') && !e.target.closest('.elementor-nav-menu__container')){
      closeAllExcept(null);
    }
  }

  // attach
  document.addEventListener('click', handler, true);
  document._minimalSubHandler = handler;

  // on resize > BP, close and restore
  window.addEventListener('resize', function(){
    if(window.innerWidth > BP){
      const anchors = document.querySelectorAll('a.has-submenu, a.elementor-item.has-submenu');
      anchors.forEach(a => closeAnchor(a));
    }
  });

})();
</script>
