				<div class="elementor-element elementor-element-cdafe67 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor" data-id="cdafe67" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<p><span class="TextRun SCXW195186897 BCX8" lang="EN-US" xml:lang="EN-US" data-contrast="none"><span class="NormalTextRun SCXW195186897 BCX8">In December of 1936,&nbsp;</span><span class="NormalTextRun SCXW195186897 BCX8"><a href="https://www.sunvalley.com/" target="_blank" rel="noopener">Sun Valley Ski Resort</a>&nbsp;</span><span class="NormalTextRun SCXW195186897 BCX8">became </span><span class="NormalTextRun SCXW195186897 BCX8">the first destination ski resort in the U.S. and home to the world&rsquo;s first chairlift.</span></span></p>								</div>
				</div>
				</div>
					</div>
				</div>
