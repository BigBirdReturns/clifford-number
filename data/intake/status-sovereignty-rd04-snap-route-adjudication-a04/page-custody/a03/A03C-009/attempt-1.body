        <!-- Collapsed chatbot button -->
        <div id="copilot-collapsed" role="button" tabindex="0" aria-label="Ask Ida a question">
            <img src="https://idaho.gov/wp-content/plugins/ida-chatbot-plugin/assets/maximise.svg" alt="Maximize" class="copilot-maximize-icon">
            <img src="https://idaho.gov/wp-content/plugins/ida-chatbot-plugin/assets/Ida.png" alt="IDA" class="copilot-collapsed-avatar">
            <span class="copilot-collapsed-text">Ask Ida</span>
            
        </div>

        <!-- Expanded chatbot wrapper -->
        <div id="copilot-wrapper" style="display: none;">
            <button id="copilot-minimize" class="copilot-minimize-btn" aria-label="Minimize chatbot">
                <img src="https://idaho.gov/wp-content/plugins/ida-chatbot-plugin/assets/minimise.svg" alt="Minimize">
            </button>
            <div id="copilot-webchat" role="main"></div>
        </div>
                <script>
        document.addEventListener('DOMContentLoaded', function() {
            const headerIcon = document.getElementById('ida-header-icon');
            const collapsedButton = document.getElementById('copilot-collapsed');
            const chatWrapper = document.getElementById('copilot-wrapper');
            
            if (headerIcon && collapsedButton && chatWrapper) {
                headerIcon.addEventListener('click', function() {
                    // Check current state of chatbot
                    const isCollapsed = chatWrapper.style.display === 'none' || !chatWrapper.style.display;
                    
                    if (isCollapsed) {
                        // Trigger expand - simulate click on collapsed button
                        collapsedButton.click();
                    } else {
                        // Trigger collapse - simulate click on minimize button
                        const minimizeButton = document.getElementById('copilot-minimize');
                        if (minimizeButton) {
                            minimizeButton.click();
                        }
                    }
                });
            }
        });
        </script>
