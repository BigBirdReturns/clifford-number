            #copilot-webchat .webchat__activity-status span {
                color: #EAE7F3 !important;
                font-family: "Schibsted Grotesk", sans-serif !important;
                font-size: 12px !important;
                font-style: normal !important;
                font-weight: 400 !important;
                line-height: 24px !important;
                letter-spacing: 0.24px !important;
            }

            /* Bot avatar styling */
            #copilot-webchat .webchat__bubble--from-bot .webchat__avatar__image {
                width: 100% !important;
                height: 100% !important;
                object-fit: cover !important;
                border-radius: 50% !important;
                box-shadow: 7px 10px 14px 0 rgba(0, 0, 0, 0.35) !important;
            }

            #copilot-webchat .webchat__bubble--from-bot .webchat__avatar {
                background-color: transparent !important;
                background: transparent !important;
                border: none !important;
            }

            #copilot-webchat .webchat__bubble--from-bot .webchat__avatar__initials {
                display: none !important;
            }

            #copilot-webchat .webchat__bubble--from-bot .webchat__avatar svg {
                display: none !important;
