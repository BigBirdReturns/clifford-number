element.elementor-element-a274ea5 .elementor-heading-title{font-size:12px;}}@media(min-width:768px){.elementor-271 .elementor-element.elementor-element-cf7b543{--width:23.02%;}.elementor-271 .elementor-element.elementor-element-2137af9{--width:32.51%;}.elementor-271 .elementor-element.elementor-element-88d4341{--width:23.19%;}.elementor-271 .elementor-element.elementor-element-13306d5{--width:270px;}}@media(max-width:1024px) and (min-width:768px){.elementor-271 .elementor-element.elementor-element-2137af9{--width:42%;}}/* Start custom CSS for container, class: .elementor-element-cf7b543 */.elementor-271 .elementor-element.elementor-element-cf7b543{
