				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="1024" height="621" src="https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-1024x621.jpeg" class="attachment-large size-large wp-image-3688" alt="The Hells Canyon river gorge featuring steep cliffs and the Snake River." srcset="https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-1024x621.jpeg 1024w, https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-300x182.jpeg 300w, https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-768x466.jpeg 768w, https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-1536x932.jpeg 1536w, https://idaho.gov/wp-content/uploads/2025/09/Hells-Canyon-2048x1242.jpeg 2048w" sizes="(max-width: 1024px) 100vw, 1024px">															</div>
				</div>
				<div class="elementor-element elementor-element-dd8f8e8 elementor-widget__width-initial elementor-absolute elementor-hidden-mobile elementor-widget elementor-widget-image" data-id="dd8f8e8" data-element_type="widget" data-e-type="widget" data-settings='{"_position":"absolute"}' data-widget_type="image.default">
				<div class="elementor-widget-container">
																<a href="#elementor-action%3Aaction%3Dlightbox%26settings%3DeyJ1cmwiOiJodHRwOlwvXC9pZGFoby5nb3ZcL3dwLWNvbnRlbnRcL3VwbG9hZHNcLzIwMjVcLzA5XC9IZWxscy1DYW55b24tc2NhbGVkLmpwZWciLCJ0eXBlIjoiaW1hZ2UiLCJ0aXRsZSI6IlRoZSBIZWxscyBDYW55b24gcml2ZXIgZ29yZ2UgZmVhdHVyaW5nIHN0ZWVwIGNsaWZmcyBhbmQgdGhlIFNuYWtlIFJpdmVyLiJ9">
							<img decoding="async" width="1" height="1" src="https://idaho.gov/wp-content/uploads/2025/09/Image-Detail.svg" class="attachment-large size-large wp-image-351" alt="Open image preview and view image description">								</a>
															</div>
				</div>
				</div>
				<div class="elementor-element elementor-element-20a5910 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor" data-id="20a5910" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<p><span class="TextRun SCXW190542963 BCX8" lang="EN-US" xml:lang="EN-US" data-contrast="none"><span class="NormalTextRun SCXW190542963 BCX8"><a style="letter-spacing: 0.48px;" href="https://www.fs.usda.gov/r06/wallowa-whitman/recreation/hells-canyon-national-recreation-area" target="_blank" rel="noopener">Hells Canyon</a>&nbsp;is </span><span class="NormalTextRun SCXW190542963 BCX8">the deepest river gorge in North America, </span><span class="NormalTextRun SCXW190542963 BCX8">deeper than the Grand Canyon. Hells Canyon reaches a depth of </span><span class="NormalTextRun SCXW190542963 BCX8">7,993</span><span class="NormalTextRun SCXW190542963 BCX8"> feet</span><span class="NormalTextRun SCXW190542963 BCX8">, while the Grand Canyon is </span><span class="NormalTextRun SCXW190542963 BCX8">6,093 feet</span><span class="NormalTextRun SCXW190542963 BCX8"> deep.</span></span></p>								</div>
				</div>
				</div>
					</div>
				</div>
								</div>
