				<div class="elementor-element elementor-element-01ddd15 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor" data-id="01ddd15" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<p><span class="NormalTextRun SCXW175776201 BCX8">Idaho is home to the largest stand of western white pines in North</span><span class="NormalTextRun SCXW175776201 BCX8"> America</span><span class="NormalTextRun SCXW175776201 BCX8">.</span></p>								</div>
				</div>
