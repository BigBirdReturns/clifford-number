}/* End custom CSS */
/* Start custom CSS for nav-menu, class: .elementor-element-8059ea0 */.elementor-element-2137af9 .elementor-nav-menu--main .elementor-nav-menu {
    display: grid !important;
    grid-auto-flow: column;
    grid-template-rows: repeat(6, auto); /* 6 items per column */
    grid-template-columns: 1fr 1fr; /* vertical spacing */
}

/* Push second column to the right */
.elementor-element-2137af9 
.elementor-nav-menu--main 
.elementor-nav-menu > li:nth-child(n+7) {
    justify-self: end;
    width:145px !important;
}

/* Force link text to be left aligned */
.elementor-element-2137af9 .elementor-nav-menu > li > a {
    display: block;
    text-align: left !important;
}

@media (max-width: 350px) {
    .elementor-element-2137af9 .elementor-nav-menu--main .elementor-nav-menu {
        display: block !important;
    }
    
    .elementor-element-2137af9 
.elementor-nav-menu--main 
.elementor-nav-menu > li:nth-child(n+7) {
    justify-self: start;
}
}/* End custom CSS */
/* Start custom CSS for container, class: .elementor-element-2137af9 */.elementor-271 .elementor-element.elementor-element-2137af9 {
    min-width: 116px
}

.elementor-271 .elementor-element.elementor-element-2137af9 a {
      white-space: nowrap !important;
}

@media (min-width: 940px) and (max-width: 1024px) {
  .elementor-271 .elementor-element.elementor-element-2137af9 {
    width: 32.51% !important;
  }
}/* End custom CSS */
/* Start custom CSS for container, class: .elementor-element-13306d5 */@media(max-width: 767px){
    .elementor-271 .elementor-element.elementor-element-13306d5{
    aspect-ratio: 322/198;
}
}/* End custom CSS */
/* Start custom CSS for container, class: .elementor-element-88d4341 */.elementor-271 .elementor-element.elementor-element-88d4341 {
    min-width: 282px
}/* End custom CSS */
