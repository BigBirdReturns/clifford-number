<script>
document.addEventListener('click', function (event) {
    const icon = event.target.closest('.header-search-icon');
    const searchContainer = document.querySelector('.header-search');
    if (!searchContainer) return;
    
    // If clicking the icon, toggle the search
    if (icon) {
        searchContainer.classList.toggle('active');
        console.log('Toggled .header-search. Current classes:', searchContainer.className);
        return;
    }
    
    // If clicking outside both the icon and search container, close it
    const clickedInsideSearch = event.target.closest('.header-search');
    if (!clickedInsideSearch && searchContainer.classList.contains('active')) {
        searchContainer.classList.remove('active');
        console.log('Closed .header-search. Current classes:', searchContainer.className);
    }
});
</script>

<script> 

  (function () { 

    function initCommonSearchDropdown() { 

      var dropdown = document.getElementById('common-search-terms'); 

      if (!dropdown) return; 

  

      // Try to find the Google CSE input and search button 

      var input = document.getElementById('gsc-i-id2'); 

      var form = input ? input.closest('form') : null; 

      var button = form ? form.querySelector('button.gsc-search-button') : null; 

  

      // If CSE has not finished rendering yet, try again shortly 

      if (!input || !button) { 

        setTimeout(initCommonSearchDropdown, 300); 

        return; 

      } 

  

      dropdown.addEventListener('change', function () { 

        var term = this.value; 

        if (!term) return; 

  

        // Set the value in the Google search box 

        input.value = term; 

  

        // Optional: focus the field so user sees it update 

        input.focus(); 

  

        // Trigger the search by clicking the Google search button 

        button.click(); 

      }); 

    } 

  

    // Wait until page load so CSE has a chance to render 

    window.addEventListener('load', initCommonSearchDropdown); 

  })(); 

</script> 





<script>
  // Works even if the close icon is inside a link or SVG
  document.addEventListener('click', function (e) {
    const close = e.target.closest('.close-promo');
    if (!close) return;

    e.preventDefault();
    e.stopPropagation();

    const promo = document.getElementsByClassName('promo')[0];
    if (promo) promo.style.display = 'none';
  });
</script>

<script>
// Run after Google CSE loads
window.addEventListener('load', function() {
    const inputs = document.querySelectorAll('.gsc-input');
    
    inputs.forEach(function(input) {
        if (!input.hasAttribute('placeholder')) {
            input.setAttribute('placeholder', ' '); // single space
        }
    });
});
</script>

<script>
(function() {
    function initSearchToggle() {
        const searchBtn = document.querySelector('.header-search-icon a.elementor-icon');

        if (!searchBtn || searchBtn.hasAttribute('data-a11y-added')) return;

        searchBtn.setAttribute('data-a11y-added', 'true');
        searchBtn.setAttribute('role', 'button');
        searchBtn.setAttribute('aria-expanded', 'false');
        searchBtn.setAttribute('aria-label', 'Open search');

        searchBtn.addEventListener('click', function(e) {
            e.preventDefault();

            const expanded = searchBtn.getAttribute('aria-expanded') === 'true';
            searchBtn.setAttribute('aria-expanded', String(!expanded));
            searchBtn.setAttribute('aria-label', expanded ? 'Open search' : 'Close search');
        });

        searchBtn.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                searchBtn.click();
            }
        });
    }

    // Run initially
    initSearchToggle();

    // Watch for Elementor replacing nodes
    const observer = new MutationObserver(() => {
        initSearchToggle();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();


</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const triggers = document.querySelectorAll(
        ".elementor-nav-menu .menu-item-has-children > a"
    );

    triggers.forEach(trigger => {
        trigger.addEventListener("click", function (e) {
            // Allow SmartMenu to open visually
            setTimeout(() => fixSubmenuAccessibility(trigger), 50);
        });

        trigger.addEventListener("keydown", function (e) {
            if (e.key === " " || e.key === "Enter") {
                e.preventDefault();
                trigger.click();
            }
        });
    });

    function fixSubmenuAccessibility(trigger) {
        const menu = document.getElementById(trigger.getAttribute("aria-controls"));
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        if (isExpanded) {
            menu.setAttribute("aria-hidden", "false");
            menu.querySelectorAll("a").forEach(a => a.setAttribute("tabindex", "0"));
        } else {
            menu.setAttribute("aria-hidden", "true");
            menu.querySelectorAll("a").forEach(a => a.setAttribute("tabindex", "-1"));
        }
    }
});
</script>
<script>
jQuery(document).ready(function($) {
    console.log("Master Accessibility Fix: Loaded");

    let lastTrigger = null;

    // ======================================================
    // PART 1: THE FOCUS FIX (New Logic)
    // ======================================================

    // 1. Intelligent Capture (Ignores clicks if Lightbox is already open)
    function captureTrigger(e) {
        if ($('#elementor-lightbox').is(':visible')) return;

        // Try to grab the link/button, otherwise grab the generic element
        let target = $(e.target).closest('a, button, .e-gallery-item');
        if (target.length) {
            lastTrigger = target[0];
        } else {
            lastTrigger = e.target;
        }
    }

    // Listen globally
    document.addEventListener('click', captureTrigger, true);
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') captureTrigger(e);
    }, true);

    // 2. Restore Focus Function
    function restoreFocus() {
        console.log("Master Fix: Restoring focus...");
        
        // Unhide site immediately
        $('body > *:not(#elementor-lightbox)').removeAttr('aria-hidden').removeAttr('inert');

        // Wait 400ms for Lightbox to fade out completely
        setTimeout(function() {
            if (lastTrigger && document.body.contains(lastTrigger)) {
                
                // Ensure target is focusable
                if (!lastTrigger.getAttribute('tabindex')) {
                    lastTrigger.setAttribute('tabindex', '0');
                }
                lastTrigger.focus();
                
            } else {
                console.warn("Master Fix: Original element is gone/invalid.");
            }
        }, 400); 
    }

    // ======================================================
    // PART 2: EXISTING ACCESSIBILITY FEATURES (Preserved)
    // ======================================================

    // Helper: Correct ARIA Labels for Screen Readers
    function fixModalAria(lightbox) {
        lightbox.setAttribute('role', 'dialog');
        lightbox.setAttribute('aria-modal', 'true');
        const title = lightbox.querySelector('.elementor-slideshow__title');
        
        if (title && title.textContent.trim() !== '') {
            title.id = 'lightbox-title';
            lightbox.setAttribute('aria-labelledby', 'lightbox-title');
        } else {
            lightbox.setAttribute('aria-label', 'Image preview dialog');
        }
    }

    // Helper: Focus Trap (Keeps user from tabbing outside)
    function trapFocus(lightbox) {
        const focusable = 'a[href], button, input, textarea, select, details, [tabindex]:not([tabindex="-1"])';
        
        lightbox.addEventListener('keydown', e => {
            if (e.key === 'Tab') {
                const items = Array.from(lightbox.querySelectorAll(focusable))
                                   .filter(el => !el.closest('.elementor-hidden')); 

                if (items.length === 0) return;

                const first = items[0];
                const last = items[items.length - 1];

                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault(); 
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault(); 
                    first.focus();
                }
            }
        });
    }

    // Feature: Zoom/Fullscreen Toggle Focus Preservation
    $(document).on('keydown click', '.elementor-slideshow__header [role="switch"]', function (e) {
        const $el = $(this);
        if (e.type === 'keydown' && !(e.key === 'Enter' || e.key === ' ')) return;
        
        // Allow default click, but handle aria updates manually if needed
        const label = $el.attr('aria-label'); 
        
        // Refocus the correct toggle icon after Elementor swaps the DOM
        setTimeout(() => {
            const $active = $(`.elementor-slideshow__header [role="switch"][aria-label="${label}"]:not(.elementor-hidden)`);
            if ($active.length) $active.focus();
        }, 50);
    });

    // ======================================================
    // PART 3: LIGHTBOX OBSERVER (Merged Logic)
    // ======================================================
    
    const observer = new MutationObserver(function(mutations) {
        const lightbox = document.getElementById('elementor-lightbox');
        
        // Run only once when lightbox appears
        if (lightbox && !lightbox.hasAttribute('data-master-fixed')) {
            lightbox.setAttribute('data-master-fixed', 'true');
            console.log("Master Fix: Lightbox detected & enhanced.");

            // 1. Apply Accessibility Features
            fixModalAria(lightbox);
            trapFocus(lightbox);

            // 2. Hide Background (Inert)
            $('body > *:not(#elementor-lightbox)').attr('aria-hidden', 'true').attr('inert', 'true');

            // 3. Attach Close Listeners (For Focus Restore)
            $(lightbox).on('click', '.dialog-close-button, .elementor-slideshow__close', restoreFocus);
            
            // Close on overlay click
            $(lightbox).on('click', '.dialog-widget-content', function(e) {
                if (e.target === this) restoreFocus();
            });
            
            // Close on Enter key
            $(lightbox).on('keydown', '.dialog-close-button', function(e) {
                if (e.key === 'Enter' || e.key === ' ') restoreFocus();
            });
        }
    });

    observer.observe(document.body, { childList: true, subtree: false });

    // Global Escape Key Listener
    $(document).on('keydown', function(e) {
        if (e.key === 'Escape' && $('#elementor-lightbox').is(':visible')) {
            restoreFocus();
        }
    });

});
</script>

</body>
</html>
