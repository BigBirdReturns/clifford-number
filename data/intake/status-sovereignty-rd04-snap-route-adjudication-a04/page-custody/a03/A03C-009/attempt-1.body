<link rel="https://api.w.org/" href="https://idaho.gov/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://idaho.gov/wp-json/wp/v2/pages/296" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://idaho.gov/xmlrpc.php?rsd" />
<meta name="generator" content="WordPress 6.9.5" />
<link rel='shortlink' href='https://idaho.gov/' />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
        <style>
            /* Collapsed chatbot button */
            #copilot-collapsed {
                position: fixed;
                bottom: 20px;
                right: 20px;
                width: 157px;
                height: 87px;
                border-radius: 18px;
                background: linear-gradient(138deg, #545B50 0%, #22271F 100.06%);
                box-shadow: 0 10px 4px 0 rgba(0, 0, 0, 0.25);
                z-index: 9999;
                display: flex;
                align-items: center;
                padding: 15px 20px;
                gap: 12px;
                cursor: pointer;
                opacity: 1;
                transform: scale(1) translateY(0);
                transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                           transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                           box-shadow 0.3s ease;
                transform-origin: bottom right;
            }

            #copilot-collapsed.hiding {
                opacity: 0;
                transform: scale(0.92) translateY(10px);
                pointer-events: none;
            }

            #copilot-collapsed:hover {
                box-shadow: 0 12px 6px 0 rgba(0, 0, 0, 0.3);
                transform: translateY(-2px);
            }

            .copilot-maximize-icon {
                position: absolute;
                top: 8px;
                right: 8px;
                width: 20px;
                height: 20px;
                opacity: 0.85;
                filter: brightness(0) invert(1);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            #copilot-collapsed:hover .copilot-maximize-icon {
                opacity: 1;
                transform: scale(1.1);
            }

            .copilot-collapsed-avatar {
                width: 39px;
                height: 39px;
                border-radius: 50%;
                box-shadow: 7px 10px 14px 0 rgba(0, 0, 0, 0.35);
                flex-shrink: 0;
            }

            .copilot-collapsed-text {
                flex: 1;
                color: #FFF;
                font-family: "Schibsted Grotesk", sans-serif;
                font-size: 16px;
                font-style: normal;
                font-weight: 600;
                line-height: 24px;
                letter-spacing: 0.32px;
            }

            .copilot-collapsed-icon {
                flex-shrink: 0;
                width: 24px;
                height: 24px;
            }
			@media (max-width: 768px){
				.copilot-maximize-icon{
					display:none
				}
				#copilot-collapsed{
					padding: 8px 10px;
					width: 140px;
    				height: 65px;
				}
			}

            /* Expanded chatbot wrapper */
            #copilot-wrapper {
                position: fixed;
                bottom: 20px;
                right: 20px;
                width: 400px;
                height: 600px;
                z-index: 9999;
                opacity: 0;
                transform: scale(0.9) translateY(20px);
                transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                           transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
                           box-shadow 0.3s ease;
                transform-origin: bottom right;
                pointer-events: none;
            }

            #copilot-wrapper.showing {
                opacity: 1;
                transform: scale(1) translateY(0);
                pointer-events: auto;
            }

            /* Main chatbot container */
            #copilot-webchat {
                width: 100%;
                height: 100%;
                border-radius: 18px;
                background: linear-gradient(138deg, #545B50 0%, #22271F 100.06%);
                box-shadow: 0 10px 4px 0 rgba(0, 0, 0, 0.25);
                overflow: hidden;
            }

            /* Minimize button */
            .copilot-minimize-btn {
                position: absolute;
                top: 15px;
                right: 15px;
                width: 35px;
                height: 35px;
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
                z-index: 10000;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .copilot-minimize-btn:hover {
                transform: scale(1.1);
				background: transparent;
            }

            .copilot-minimize-btn img {
                width: 100%;
                height: 100%;
                display: block;
                filter: brightness(0) invert(1);
                opacity: 1;
            }

            .copilot-minimize-btn:hover img {
                opacity: 1;
            }
			#copilot-webchat .webchat__icon-button:hover .webchat__icon-button__shade{
				background: none !important;
			}

            /* WebChat specific styling */
            #copilot-webchat .webchat__basic-transcript {
                background-color: transparent !important;
                margin-bottom: 18px !important;
            }

            /* Ensure WebChat fills the container properly */
            #copilot-webchat > div {
                width: 100% !important;
                height: 100% !important;
            }

            /* Apply padding to the inner div */
            #copilot-webchat > div > div {
                padding: 30px 20px !important;
                box-sizing: border-box !important;
                height: 100% !important;
            }

            /* Apply padding to transcript area for message spacing */
            #copilot-webchat .webchat__basic-transcript__transcript {
                padding: 0 !important;
            }

            /* Adjust send box padding */
            #copilot-webchat .webchat__send-box {
                padding: 0 !important;
                margin: 0 !important;
            }

            #copilot-webchat .webchat__bubble__content {
                background-color: #f5f5f5 !important;
                color: #00526A !important;
                border-radius: 12px !important;
                font-family: "Schibsted Grotesk", sans-serif !important;
                font-size: 16px !important;
                font-style: normal !important;
                font-weight: 700 !important;
                line-height: 24px !important;
                letter-spacing: 0.32px !important;
                text-overflow: ellipsis !important;
            }

            #copilot-webchat .webchat__bubble--from-user .webchat__bubble__content {
                background-color: #ffffff !important;
            }

            #copilot-webchat .webchat__send-box {
                background-color: transparent !important;
                border-top: none !important;
            }

            #copilot-webchat .webchat__send-box__main {
                padding-top: 18px !important;
            }

            #copilot-webchat .webchat__send-box-text-box__input {
                background-color: transparent !important;
                color: #FFF !important;
                font-family: "Schibsted Grotesk", sans-serif !important;
                font-size: 16px !important;
                font-style: normal !important;
                font-weight: 600 !important;
                line-height: 24px !important;
                letter-spacing: 0.32px !important;
                text-overflow: ellipsis !important;
            }

            #copilot-webchat .webchat__send-box-text-box__input::placeholder {
                color: #FFF !important;
                font-family: "Schibsted Grotesk", sans-serif !important;
                font-size: 16px !important;
                font-style: normal !important;
                font-weight: 600 !important;
                line-height: 24px !important;
                letter-spacing: 0.32px !important;
                text-overflow: ellipsis !important;
            }

            #copilot-webchat .webchat__icon-button {
                color: #ffffff !important;
