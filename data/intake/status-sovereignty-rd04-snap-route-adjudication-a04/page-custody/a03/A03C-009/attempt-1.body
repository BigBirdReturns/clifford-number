				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="1024" height="683" src="https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-1024x683.jpeg" class="attachment-large size-large wp-image-3679" alt="Shoshone Falls flowing into the Snake River canyon." srcset="https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-1024x683.jpeg 1024w, https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-300x200.jpeg 300w, https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-768x512.jpeg 768w, https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-1536x1024.jpeg 1536w, https://idaho.gov/wp-content/uploads/2025/09/Shoshone-Falls-2048x1365.jpeg 2048w" sizes="(max-width: 1024px) 100vw, 1024px">															</div>
				</div>
