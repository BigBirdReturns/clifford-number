<script>
jQuery(document).ready(function () {
	//Fix links on featured boxes near top of homepage
	jQuery('#lets-explore .ova_feature_box').each(function () {
    
    // Remove link around image (keep the img)
    jQuery(this).find('.ova-image a').each(function () {
      jQuery(this).replaceWith(jQuery(this).html());
    });

    // Remove link around title (keep the text)
    jQuery(this).find('.title a').each(function () {
      jQuery(this).replaceWith(jQuery(this).html());
    });

  });
	
	//Fix links on elected officials on homepage
	jQuery('#elected-officials .elementor-cta').each(function () {
    var $cta = jQuery(this);
    
    // Get link attributes
    var href = $cta.attr('href');
    var target = $cta.attr('target');
    var rel = $cta.attr('rel');

    // Find the title element
    var $title = $cta.find('.elementor-cta__title');

    // Wrap title text with new link
    var $newLink = jQuery('<a></a>')
      .attr('href', href)
      .attr('target', target)
      .attr('rel', rel)
      .html($title.html());

    $title.html($newLink);

    // Remove the original anchor but keep its contents
    $cta.replaceWith($cta.contents());
  });
	
	
  //remove alt text from anchor links and replace with aria-labels
  jQuery('a[alt]').each(function () {
    var altText = jQuery(this).attr('alt');
    if (altText) {
      jQuery(this).attr('aria-label', altText);
      jQuery(this).removeAttr('alt');
    }
  });
  
  //remove links from icons on service pages
  jQuery('div.items div.icon').each(function () {
  if (jQuery(this).parent().is('a')) {
    jQuery(this).unwrap();
  }
});
	
	//change H3 to H2 in services sidebar
	jQuery('.ova-list-sev h3').each(function () {
        var $h3 = jQuery(this);
        var $h2 = jQuery('<h2>', {
            class: $h3.attr('class'),
            html: $h3.html()
        });
        $h3.replaceWith($h2);
    });
	
	//Make 'Share Article' near bottom of page into a <h2> heading
	jQuery('.share_social .ova_label').each(function () {
        var $el = jQuery(this);
        $el.replaceWith('<h2 class="' + $el.attr('class') + '">' + $el.html() + '</h2>');
    });
  
});
</script>
