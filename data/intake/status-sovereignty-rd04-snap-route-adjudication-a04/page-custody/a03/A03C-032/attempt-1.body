<style id="wp-custom-css">
div.ova-search-page img.img-responsive.wp-post-image {
    height: 197px;
    object-fit: cover;
}
.ova-search-page:nth-of-type(3) {
    display: none;
}
a.skip-link
{
position:absolute !important;
left:-10000px !important;
top:auto !important;
width:1px !important;
height:1px !important;
overflow:hidden !important;
}
 
/*scroll to top arrow has accessibility issues, so hide it*/
#scrollUp {
	display:none !important;
}

/*hide "read more" links on main services page*/
.ova_sev_wrap .wp-items .content-sub a.readmore {
    display: none;
}

/*fix current link contrast in footer*/
#menu-menu-footer-2service-request li.current-menu-item a, #menu-menu4news-updates li.current-menu-item a {
	color:white !important;
}

/*fix contrast on green buttons*/
a.btn-success {
	background-color:#218739 !important;
}

a.skip-link:focus
{
position:static !important;
width:auto !important;
height:auto !important;
color:#fff !important;
}
.grecaptcha-badge { visibility: hidden; }

.elementor-widget-ova_menu .ova_nav ul.menu > li > a:hover { color:#D43900 !important; }

li.current_page_item a { color:#BD3200 !important;  }

/*accessibility fix for current page in footer menu*/
div#footer-menu li.current-menu-item a {
	color:#FFFFFF !important;
	text-decoration:underline;
}

.ova-search-page .post-media img.img-responsive.wp-post-image {
    max-height: 300px;
    width: auto;
}

#moreNewsButton {
	display:none;
}

.ova-search-page article .post-media {
    display: none;
}

.ova-search-page .page-title {
	margin-top:0;
}

.elementor-widget-ova_language {
    display: none;
}

body.search-results .bg_feature_img {
    background-image: url(https://staging-portal.kansas.gov/wp-content/uploads/2021/06/faqheader1.jpg) !important;
}

::marker {
    color: #D43900;
}
.info-graphic1{background-color: #07183b !important;}

/*make current link in menu accessible*/
#main_menu_col #main_menu li.menu-item.active a {
     font-weight: bold !important;
     font-size: 110% !important;
}

/*target services menu link on services page*/
body.post-type-archive-ova_sev #menu-item-5391 a {
	font-weight: bold !important;
     font-size: 110% !important;
     color: #D43900 !important;
}

.visually-hidden {
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  height: 1px;
  overflow: hidden;
  position: absolute;
  white-space: nowrap;
  width: 1px;
}
