.elementor-131 .elementor-element.elementor-element-5c9d8ba .elementor-button, .elementor-80 .elementor-element.elementor-element-6e91fcb .elementor-button {
	fill: #D43900 !important;
  color: #D43900 !important;
	border-color: #D43900 !important;
}
.elementor-131 .elementor-element.elementor-element-5c9d8ba .elementor-button:hover, .elementor-131 .elementor-element.elementor-element-5c9d8ba .elementor-button:focus, .elementor-80 .elementor-element.elementor-element-6e91fcb .elementor-button:hover, .elementor-80 .elementor-element.elementor-element-6e91fcb .elementor-button:focus {
	background-color: #D43900 !important;
    border-color: #D43900 !important;
	color:white !important;
}

a:focus {
     outline: 2px dotted #212121 !important;

}

/*get rid of underline on icons before links*/
.elementor a:hover::before {
	text-decoration:none !important;
}
#top_header a:focus, #top_footer a:focus, #bottom_footer a:focus, #middle_footer a:focus {
	outline: 2px dotted #FFF !important;
}

.elementor-68 .elementor-element.elementor-element-f6c831c:not(.elementor-motion-effects-element-type-background), .elementor-68 .elementor-element.elementor-element-f6c831c > .elementor-motion-effects-container > .elementor-motion-effects-layer, .elementor-68 .elementor-element.elementor-element-3102046:not(.elementor-motion-effects-element-type-background), .elementor-68 .elementor-element.elementor-element-3102046 > .elementor-motion-effects-container > .elementor-motion-effects-layer {
    background-color: #D43900;
}

/*fix animation on services and agencies section*/
.ova_feature_box.version_1 .ova-content .readmore {
    height: auto;
    opacity: 1;
    transition: none;
}

/*show focus on buttons in top hero area*/
a.rev-btn:focus {
    outline: 2px dotted #fff !important;
}
 /*Override color change of active page in footer menu*/
#top_footer .ova_menu_page .menu li.active a {
    color: white !important;
}

/*force the "cards" on the services page to be open by default */

body.post-type-archive-ova_sev .ova_sev_wrap .wp-items {
	height:200px;
	overflow:visible;
}
body.post-type-archive-ova_sev .ova_sev_wrap .wp-items .icon {
	display:none;
}
body.post-type-archive-ova_sev .ova_sev_wrap .wp-items .title {
	position:static;
}
body.post-type-archive-ova_sev .ova_sev_wrap .wp-items .content-sub {
	opacity:1;
	position:static;
	padding:0;
}

body.post-type-archive-ova_sev .ova_sev_wrap .wp-items .icon-hide {
	display:none;
}


/*add background color to hero area*/
.wrap_ova_header.bg_feature_img {
	background-color:#000 !important;
}

/*Make current page in menu appear same as other pages */
.elementor-131 .elementor-element.elementor-element-4b28b1d .ova_nav ul.menu > li.active>a, .elementor-widget-ova_menu .ova_nav ul.menu > li.active > a {
    /*color: #06163A !important;*/
	  font-weight: 400 !important;
}

/*remove underlines from links on government page*/
.elementor-10641 .elementor-element.elementor-element-7fd4bdd0, .elementor-10641 .elementor-element.elementor-element-a450582, .elementor-10641 .elementor-element.elementor-element-754d536e {
    text-decoration: none !important;
}

.elementor-element-1b6bb65 .ova_list_link {
    background: white !important;
}

body.single-ova_sev > .elementor {
    display: none;
}

a {
color: #0067DA;
}
a:hover {
	text-decoration:underline;
}
.breadcrumb a:focus {
	outline:2px dotted white !important;
}
.elementor-cta__button.elementor-button:hover {
    text-decoration: underline !important;
}
</style>
</head>

