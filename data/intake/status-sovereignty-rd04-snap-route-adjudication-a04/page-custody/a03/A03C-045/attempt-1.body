<section class="graphs">
	<div class="stats-main" id="counter">
    <div class="container-lg">
<div class="row" style="display: flex; justify-content: center;">
			<div id="stat1" class="col-xs-6 col-sm-3 stats-container">
				<div class="stats">
                    <div class="stats-circle"></div>
					<div class="stats-center">
                        <div class="counter-value" data-count="3.0" data-super="%">3.0</div>
						<p class="stats-main-text">6th <strong>lowest</strong> unemployment rate in the nation</p>
					</div>
				</div>
				<p class="stats-source small text-center">Source: <a href="https://www.bls.gov/web/laus/laumstrk.htm" target="_blank">USDOL, Bureau of Labor Statistics, January, 2026</a></p>

			</div>
		<div class="hidden-xs col-sm-6" style="width: 20%;">
			</div>
			<div id="stat2" class="col-xs-6 col-sm-3">
				<div class="stats">
                    <div class="stats-circle"></div>
					<div class="stats-center">
                        <div class="counter-value" data-count="10" data-super="th">20</div>
						<p class="stats-main-text">Overall<br>health ranking</p>
					</div>
				</div>
				<p class="stats-source small text-center">Source: <a href="https://assets.americashealthrankings.org/ahr_2025annual_comprehensivereport_final-web.pdf#page=36" target="_blank">2025 America's Health Rankings</a></p>
			</div>
		</div>
	</div>
</div>
</section>


