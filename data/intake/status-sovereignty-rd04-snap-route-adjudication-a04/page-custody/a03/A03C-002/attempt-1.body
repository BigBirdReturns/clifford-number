  <style>
    .offline-banner {
      position: fixed;
      bottom: 0px;
      left: 0;
      width: 100%;
      background: #000;
      z-index: 999;
      opacity: .7;
      display: none
    }

    .offline-banner p {
      color: #fff;
      text-align: center
    }

    .offline-banner p img {
      margin-bottom: -15px;
      margin-top: -8px
    }

    .offline-banner p span.status {
      height: 10px;
      width: 10px;
      background: red;
      border-radius: 50%;
      display: inline-block;
      margin-right: 10px
    }
  </style>

