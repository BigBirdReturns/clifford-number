<body>
<noscript>Your browser does not support JavaScript!</noscript>
<app-root>
  <div id="Welcome">
    <picture style="height:180px; width:180px; position:absolute; top:0; left:0; right:0; bottom:0; margin:auto;">
      <source srcset="./assets/images/dwss.webp" type="image/webp">
      <img src="./assets/images/dwss.png" alt="Access Nevada">
    </picture>


  </div>
</app-root>
<app-redirect></app-redirect>
<div class="offline-banner">

  <p>
    <img src="./assets/images/loader.svg" alt>
    <span class="status"></span> You are currently offline</p>
</div>
<script>
  function preventBack() {
    window.history.forward();
  }

  setTimeout("preventBack()", 0);
  window.onunload = function () {
    null
  };
</script>
