        <span class="flex h-8 w-8 -rotate-90 bg-nevada-yellow-400 rounded-full p-1 group-hover:bg-nevada-gold-500">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 25" fill="none">
  <path fill-rule="evenodd" clip-rule="evenodd" d="M12.9697 4.71967C13.2626 4.42678 13.7374 4.42678 14.0303 4.71967L21.5303 12.2197C21.671 12.3603 21.75 12.5511 21.75 12.75C21.75 12.9489 21.671 13.1397 21.5303 13.2803L14.0303 20.7803C13.7374 21.0732 13.2626 21.0732 12.9697 20.7803C12.6768 20.4874 12.6768 20.0126 12.9697 19.7197L19.1893 13.5H3C2.58579 13.5 2.25 13.1642 2.25 12.75C2.25 12.3358 2.58579 12 3 12H19.1893L12.9697 5.78033C12.6768 5.48744 12.6768 5.01256 12.9697 4.71967Z" fill="currentColor"/>
</svg>
        </span>
    </button>
</div>

<script>
(function () {
    var button = document.querySelector('[data-scroll-to-top-button]');

    if (!button) return;

    function getFocusTarget() {
        return document.querySelector('main h1, [role="main"] h1, h1, main, [role="main"]');
    }

    function ensureFocusable(element) {
        if (!element) return null;

        var tagName = (element.tagName || '').toLowerCase();
        var nativelyFocusable = /^(a|button|input|select|textarea)$/.test(tagName) || element.hasAttribute('contenteditable');

        if (!nativelyFocusable && !element.hasAttribute('tabindex')) {
            element.setAttribute('tabindex', '-1');
        }

        return element;
    }

    function focusTopTarget() {
        var target = ensureFocusable(getFocusTarget());

        if (!target) return;

        try {
            target.focus({ preventScroll: true });
        } catch (error) {
            target.focus();
        }
    }

    function focusAfterScrollToTop() {
        var maxChecks = 60;
        var checks = 0;

        function checkPosition() {
            checks++;

            if (window.pageYOffset <= 2 || checks >= maxChecks) {
                focusTopTarget();
                return;
            }

            window.requestAnimationFrame(checkPosition);
        }

        window.requestAnimationFrame(checkPosition);
    }

    button.addEventListener('click', function () {
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });

        focusAfterScrollToTop();
    });
})();
</script>

