<script>
function toggleLeftNav(btn) {
  const nav = document.querySelector(".left-nav.nav-links");
  if (!nav) return;

  nav.classList.toggle("show");

  // Optional accessibility: keep aria-expanded accurate
  if (btn) {
    btn.setAttribute("aria-expanded", nav.classList.contains("show") ? "true" : "false");
  }
}
</script>
