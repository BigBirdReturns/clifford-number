<div class="col-12 col-md-9">
<section class="card-section" aria-labelledby="overview-section">
  <div class="row gy-3">
    <div class="col-12">
        <div class="card mb-3">
          <div class="card-body">
  			<h2 class="card-title cardPad" id="overview-section">Overview</h2>
			<p class="card-text cardPad">Request a public assistance hearing on any action taken by the Florida Department of Children and Families (DCF) on your claim for Supplemental Nutrition Assistance Program (SNAP), Temporary Cash Assistance (TCA), and/or Medicaid benefits.</p>
			<p class="card-text cardPad">You may send the request in writing by sending regular mail or emailing us at the contact information below <strong>or </strong>you may call in the request at the phone number below <strong>or </strong>use the online form.</p>
          </div>
        </div>
      </div>
  </div>
</section>
<section class="card-section" aria-labelledby="contacts-section">
  <div class="row gy-3">
	<div class="col-12 col-md-6">
		<div class="card mb-3">
			<div class="card-body">
	 			<h3 class="card-title cardPad" id="contacts-section">Mail to</h3>
				  <p class="card-text cardPad">Appeal Hearings Section<br>
					2415 North Monroe Street, Suite 400-I<br>
					Tallahassee, Florida 32303-4190</p>
			</div>
        </div>
	</div>
	<div class="col-12 col-md-6">
        <div class="card mb-3">
          <div class="card-body">
	 		<h3 class="card-title cardPad">Email</h3>
				<ul>
				  <li>
					<a href="mailto:appeal.hearings@myflfamilies.com"
					   class="d-inline-flex align-items-center px-2"
					   style="min-height:44px;">
					  appeal.hearings@myflfamilies.com
					</a>
				  </li>
				</ul>
			</div>
		</div>
	</div>
					  <div class="col-12 col-md-6">
					<div class="card mb-3">
					  <div class="card-body">
