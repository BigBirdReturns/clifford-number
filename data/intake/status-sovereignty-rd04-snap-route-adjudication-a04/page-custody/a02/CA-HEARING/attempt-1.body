<!-- In-House Language Translate Widget --> 
<form>
	<span id="language_widget" hidden>
	<i class="fas fa-globe"></i>
		<select id="language_select" aria-label="Select language" onchange="location = this.options[this.selectedIndex].value;">		
		</select>
	</span>
</form>

<script>
$(function () {
    const languages = [
        { extension: "", name: "English" },
        { extension: "-zh", name: "中文" },
        { extension: "-es", name: "Español" },
        { extension: "-ko", name: "한국어" },
        { extension: "-tl", name: "Tagalog" },
        { extension: "-vi", name: "Tiếng Việt" }
    ];

    let dropdown = $("#language_select");
    let originalUrl = window.location.href.toLowerCase();
    let url = originalUrl.split(/[?#]/)[0].replace(/\/$/, "");
    let args = originalUrl.slice(url.length);
    let page_language = "English";
    let foundLanguages = [];
    let ajaxRequests = [];

    if (url.includes("cdss.ca.gov")) {

        // Strip any language extension from the current URL to get the base
        for (let i = 1; i < languages.length; i++) {
            if (url.endsWith(languages[i].extension)) {
                url = url.substring(0, url.length - languages[i].extension.length);
                page_language = languages[i].name;
                break;
            }
        }

        function check_language(link_url, lang) {
            let deferred = $.Deferred();

            function doRequest(attempt) {
                if (lang.extension === "") {
                    // English pages won't have a <div lang=""> tag by design,
                    // so skip the content check and just confirm the page loads.
                    $.ajax({
                        url: link_url,
                        type: "HEAD",
                        timeout: 5000
                    }).done(function () {
                        foundLanguages.push(lang);
                        deferred.resolve();
                    }).fail(function (xhr) {
                        if (xhr.status === 404) {
                            deferred.resolve();
                        } else if (attempt === 1) {
                            doRequest(2);
                        } else {
                            deferred.resolve();
                        }
                    });
                } else {
                    // For all translated languages, fetch the page and look for
                    // <div lang="xx"> matching the expected language code.
                    // DNN's fallback/parent page will never have this tag, so
                    // it's a guaranteed signal that the real translated page exists.
                    $.ajax({
                        url: link_url,
                        type: "GET",
                        timeout: 5000
                    }).done(function (data) {
                        // Extract the lang code from the extension (e.g. "-es" -> "es")
                        let langCode = lang.extension.replace("-", "");
                        let hasLangDiv = new RegExp('<div[^>]+lang=["\']' + langCode + '["\']', 'i').test(data);

                        if (hasLangDiv) {
                            foundLanguages.push(lang);
                        }

                        deferred.resolve();

                    }).fail(function (xhr) {
                        if (xhr.status === 404) {
                            deferred.resolve();
                        } else if (attempt === 1) {
                            doRequest(2); // Retry once on timeout or network error
                        } else {
                            deferred.resolve();
                        }
                    });
                }
            }

            doRequest(1);
            return deferred.promise();
        }

        function constructTargetUrl(baseUrl, newLangExt, originalArgs) {
            return baseUrl + newLangExt + originalArgs;
        }

        // Check existence WITHOUT args to avoid DNN module fallback (e.g. ?mid=123)
        languages.forEach(lang => {
            ajaxRequests.push(check_language(url + lang.extension, lang));
        });

        // Wait for ALL requests including retries before evaluating
        $.when.apply($, ajaxRequests).always(function () {
            if (foundLanguages.length > 1) {
                foundLanguages.sort((a, b) =>
                    languages.findIndex(l => l.name === a.name) -
                    languages.findIndex(l => l.name === b.name)
                );
                foundLanguages.forEach(lang => {
                    let targetUrl = constructTargetUrl(url, lang.extension, args);
                    let option = new Option(lang.name, targetUrl, false, lang.name === page_language);
                    dropdown.append(option);
                });
                $("#language_widget").show();
            }
        });
    }
});
</script>

