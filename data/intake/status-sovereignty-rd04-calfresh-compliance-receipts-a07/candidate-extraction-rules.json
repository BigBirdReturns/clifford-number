          "regex": "\\bbenefits?\\s+(?:shall|must|are\\s+to\\s+be)\\s+restor(?:e|ed)\\b",
          "flags": "giu"
        },
        {
          "pattern_id": "A07-RES-004",
          "regex": "\\b(?:issue|issued|issuance)\\s+(?:of\\s+)?(?:retroactive|restored|supplemental)\\s+benefits?\\b",
