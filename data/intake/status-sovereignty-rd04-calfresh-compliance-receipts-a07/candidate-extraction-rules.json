          "regex": "\\bbenefits?\\s+(?:shall|must|are\\s+to\\s+be|should\\s+be)\\s+(?:increased|decreased|reduced|adjusted|recalculated|recomputed|redetermined)\\b",
          "flags": "giu"
        },
        {
          "pattern_id": "A07-BEN-003",
          "regex": "\\b(?:supplemental|additional|corrected)\\s+(?:calfresh\\s+)?benefits?\\b",
