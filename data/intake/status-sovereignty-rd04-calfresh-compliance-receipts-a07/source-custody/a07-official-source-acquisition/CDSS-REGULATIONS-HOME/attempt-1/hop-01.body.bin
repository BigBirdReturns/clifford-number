<div class="panel panel-standout">
  <div class="panel-heading">
    <h2><span class="ca-gov-icon-info"></span>
      <span id="dnn_ctr14818_Title_titleLabel" class="panelTitle">Subscribe to Regulations</span>



    </h2>
  </div>
  <div id="dnn_ctr14818_ContentPane" class="panel-body"><!-- Start_Module_14818 --><div id="dnn_ctr14818_ModuleContent" class="DNNModuleContent ModDNNHTMLC">
	<div id="dnn_ctr14818_HtmlModule_lblContent"><h3>Contact Us:</h3>
<p>California Department of Social Services<br>
