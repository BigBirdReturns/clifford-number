>
  <style>
    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"] {
      padding-bottom: var(--divider-height);
      z-index: var(--z-index);
    }

    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"] .background-pause-button {
      bottom: calc(14px + var(--divider-height));
    }

    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"] .section-divider-svg-clip {
      display: none;
    }

    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"].background-width--inset:not(.content-collection):not(.gallery-section):not(.user-items-list-section) {
      padding-bottom: calc(var(--sqs-site-gutter) + var(--divider-height));
    }

    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"].background-width--inset:not(.content-collection):not(.gallery-section):not(.user-items-list-section) .section-background {
      bottom: calc(var(--sqs-site-gutter) + var(--divider-height));
    }

    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"] .section-divider-block {
      height: var(--divider-height);
    }
  </style>
  
  <style data-section-divider-style>
    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"] {
      padding-bottom: 6vw;
    }
    .has-section-divider[data-section-id="69fb5fd28ac06b16c87b0e2e"].background-width--inset:not(.content-collection):not(.gallery-section):not(.user-items-list-section) {
      padding-bottom: calc(var(--sqs-site-gutter) + 6vw);
    }
  </style>
