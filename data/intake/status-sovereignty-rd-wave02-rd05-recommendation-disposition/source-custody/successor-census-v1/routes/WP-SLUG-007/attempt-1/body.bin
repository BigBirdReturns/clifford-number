[{"id":8469,"date":"2024-10-31T09:55:35","modified":"2025-02-06T16:14:52","slug":"aces-subcommittee-on-space-sustainability","status":"publish","link":"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-space-sustainability\/","title":{"rendered":"ACES Subcommittee on Space Sustainability"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Space Sustainability in October 2024 to research and draft recommendations that address growing concerns around space debris, collision avoidance, and the development of sustainable practices for space operations. <\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Members<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/audrey-m-schaffer\/\">Audrey Schaffer<\/a> (Chair)<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/blake-bullock\/\" data-type=\"page\" data-id=\"7962\">Blake Bullock<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/brien-flewelling\/\" data-type=\"page\" data-id=\"8165\">Brien Flewelling<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/tony-frazier\/\" data-type=\"page\" data-id=\"8203\">Tony Frazier<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/jared-hautamaki\/\" data-type=\"page\" data-id=\"7929\">Jared Hautamaki<\/a><\/li>\n\n\n\n<li>Josef Koller (on behalf of <a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/kalpak-gude\/\" data-type=\"page\" data-id=\"7842\">Kalpak Gude<\/a>)<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/christopher-kunstadter\/\" data-type=\"page\" data-id=\"7839\">Chris Kunstadter<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/clare-martin\/\" data-type=\"page\" data-id=\"7976\">Clare Martin<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/michael-nicolls\/\" data-type=\"page\" data-id=\"8224\">Mike Nicolls<\/a><\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/\" style=\"border-radius:20px\">Return to ACES homepage<\/a><\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Space Sustainability in October 2024 to research and draft recommendations that address growing concerns around space debris, collision avoidance, and the development of sustainable practices for space operations. &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-space-sustainability\/\"> <span class=\"screen-reader-text\">ACES Subcommittee on Space Sustainability<\/span> Read More &raquo;<\/a><\/p>\n","protected":false},"parent":6809}]