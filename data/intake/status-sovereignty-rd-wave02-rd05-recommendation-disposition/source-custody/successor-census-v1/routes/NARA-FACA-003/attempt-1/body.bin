  <div id="page-body" class="no-sidebar">
    <header id="title-bar">
                    <p>Federal Records Management</p>
                            <div class="breadcrumb">
                <a href="/">Home</a> &gt; <a href="/records-mgmt">Federal Records Management</a> &gt; <a href="/records-mgmt/grs">What are the General Records Schedules (GRS) </a> &gt; FAQ 6.2 About managing FACA records            </div><!-- /breadcrumbs -->
            </header>

    <div class="row">
