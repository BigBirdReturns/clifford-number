[{"id":9245,"date":"2025-02-10T16:09:40","modified":"2025-02-28T14:27:21","slug":"march-2025-meeting","status":"publish","link":"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-meetings\/march-2025-meeting\/","title":{"rendered":"March 2025 Meeting"},"content":{"rendered":"\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"750\" height=\"368\" src=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg\" alt=\"Logo of the Advisory Committee on Excellence in Space - ACES\" class=\"wp-image-8412\" style=\"width:501px;height:auto\" srcset=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg 750w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-300x147.jpg 300w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-150x74.jpg 150w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-100x49.jpg 100w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-200x98.jpg 200w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-450x221.jpg 450w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-600x294.jpg 600w\" sizes=\"auto, (max-width: 750px) 100vw, 750px\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\">UPDATE: This meeting has been canceled until further notice.<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The Office of Space Commerce will <strong>no longer <\/strong>host the second meeting of the Advisory Committee on Excellence in Space (ACES) on Wednesday, March 5, 2025.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.federalregister.gov\/d\/2025-01885\" target=\"_blank\" rel=\"noreferrer noopener\">View announcement in the Federal Register<\/a><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Event Details<\/h2>\n\n\n\n<h3 class=\"wp-block-heading\">Location:<\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">U.S. Department of Commerce, Herbert C. Hoover Building\u2014Commerce Research Library, 1401 Constitution Ave. NW, Washington, DC 20230. In-person participation is limited to ACES members and DOC personnel.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\">Virtual Participation: <\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">Public participation will occur via a hybrid format. <\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/attendee.gotowebinar.com\/register\/5531095886576354391\" target=\"_blank\" rel=\"noreferrer noopener\">Register at GoToWebinar.com<\/a><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Public Comments<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The meeting is open the public via webinar connection. The agenda includes dedicated time for the public to offer remarks or ask questions. Members of the public may submit comments ahead of the meeting to space.commerce@noaa.gov. <strong>Comments are requested no later than March 3, 2025.<\/strong><\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Agenda (as of 2\/10\/2025)<\/h2>\n\n\n\n<figure class=\"wp-block-table is-style-stripes\"><table><tbody><tr><td>8:30 a.m. EST<\/td><td><strong>Check-in<\/strong><\/td><\/tr><tr><td>9:00<\/td><td><strong>Call to order and roll call<\/strong><br><em>Jason Y. Kim, Designated Federal Officer (DFO), NOAA Office of Space Commerce<\/em><\/td><\/tr><tr><td>9:05<\/td><td><strong>Welcome<\/strong><br><em>Janice Starzyk, Acting Director, NOAA Office of Space Commerce<\/em><\/td><\/tr><tr><td>9:10<\/td><td><strong><strong>Opening Remarks<\/strong><\/strong><br><em>Caryn Schenewerk, Chair; Dave Gauthier, Vice Chair<\/em><\/td><\/tr><tr><td>9:15<\/td><td><strong><strong>Subcommittee Report: Space Sustainability<\/strong><\/strong><br><em><em>Audrey Schaffer, Chair, Space Sustainability Subcommittee<\/em><\/em><\/td><\/tr><tr><td>9:30<\/td><td><strong><strong>Subcommittee Report: Licensing of Private Remote Sensing Space Systems<\/strong><\/strong><br><em>Danielle Pineres, Chair, Licensing of Private Remote Sensing Space Systems Subcommittee<\/em><\/td><\/tr><tr><td>9:45<\/td><td><strong><strong>Subcommittee Report: Commercial Space Mission Authorization<\/strong><\/strong><br><em><em>Dave Cavossa, Chair, Commercial Space Mission Authorization Subcommittee<\/em><\/em><\/td><\/tr><tr><td>10:00<\/td><td><strong><strong>Briefing on CRSRA Interagency Consultation &amp; Review Process \/ Discussion<\/strong><br><\/strong><em><em>Sarah Brothers, Director, Commercial Remote Sensing Regulatory Affairs (CRSRA) Division, NOAA Office of Space Commerce; Derek Hanson, NOAA Office of General Counsel<\/em><\/em><\/td><\/tr><tr><td>10:30<\/td><td><strong>Break<\/strong><\/td><\/tr><tr><td>10:45<\/td><td><strong>Public Comments \/ Discussion<\/strong><\/td><\/tr><tr><td>12:00 p.m.<\/td><td><strong>Lunch<\/strong><\/td><\/tr><tr><td>1:00<\/td><td><strong><strong>Discussion: Commercial Space Mission Authorization<br><\/strong><\/strong><em>Dave Cavossa, Chair, Commercial Space Mission Authorization Subcommittee<\/em><\/td><\/tr><tr><td>2:45<\/td><td><strong><strong>Break<\/strong><\/strong><\/td><\/tr><tr><td>3:00<\/td><td><strong><strong>Finalization of Recommendations to NOAA<\/strong><\/strong><br><em><em>Caryn Schenewerk, Chair; Dave Gauthier, Vice Chair<\/em><\/em><\/td><\/tr><tr><td>4:45<\/td><td><strong>Other business<\/strong><br><em>Caryn Schenewerk, Chair; Dave Gauthier, Vice Chair; Jason Y. Kim, DFO<\/em><\/td><\/tr><tr><td>4:55<\/td><td><strong>Group photo<\/strong><\/td><\/tr><tr><td>5:00<\/td><td><strong>Adjourn<\/strong><\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\">Presentation Materials<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Slides presented during the meeting will be posted here as soon as they become available.<\/p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button has-custom-font-size is-style-outline has-normal-font-size is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"\/aces\" style=\"border-radius:10px\">Back to ACES homepage<\/a><\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>UPDATE: This meeting has been canceled until further notice. The Office of Space Commerce will no longer host the second meeting of the Advisory Committee on Excellence in Space (ACES) on Wednesday, March 5, 2025. View announcement in the Federal &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-meetings\/march-2025-meeting\/\"> <span class=\"screen-reader-text\">March 2025 Meeting<\/span> Read More &raquo;<\/a><\/p>\n","protected":false},"parent":8055}]