[{"id":8465,"date":"2024-10-31T09:54:27","modified":"2024-10-31T09:54:28","slug":"aces-subcommittee-on-licensing-of-private-remote-sensing-space-systems","status":"publish","link":"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-licensing-of-private-remote-sensing-space-systems\/","title":{"rendered":"ACES Subcommittee on Licensing of Private Remote Sensing Space Systems"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Commercial Space Mission Authorization in October 2024 to research and draft recommendations on the U.S. remote sensing system licensing practices. This subcommittee is evaluating the current regulatory landscape for remote sensing operators to identify areas where streamlining can reduce administrative burdens without compromising national security or foreign policy interests.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Members<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/danielle-pineres\/\" data-type=\"page\" data-id=\"7957\">Danielle Pineres<\/a> (Chair)<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/elvert-gardner\/\" data-type=\"page\" data-id=\"8219\">El Gardner<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/brien-flewelling\/\" data-type=\"page\" data-id=\"8165\">Brien Flewelling<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/tony-frazier\/\" data-type=\"page\" data-id=\"8203\">Tony Frazier<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/michael-nicolls\/\" data-type=\"page\" data-id=\"8224\">Mike Nicolls<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/al-tadros\/\" data-type=\"page\" data-id=\"8172\">Al Tadros<\/a><\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/\" style=\"border-radius:20px\">Return to ACES homepage<\/a><\/div>\n<\/div>\n\n\n\n<p class=\"wp-block-paragraph\"><\/p>\n","protected":false},"excerpt":{"rendered":"<p>The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Commercial Space Mission Authorization in October 2024 to research and draft recommendations on the U.S. remote sensing system licensing practices. This subcommittee is evaluating the current regulatory landscape &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-licensing-of-private-remote-sensing-space-systems\/\"> <span class=\"screen-reader-text\">ACES Subcommittee on Licensing of Private Remote Sensing Space Systems<\/span> Read More &raquo;<\/a><\/p>\n","protected":false},"parent":6809}]