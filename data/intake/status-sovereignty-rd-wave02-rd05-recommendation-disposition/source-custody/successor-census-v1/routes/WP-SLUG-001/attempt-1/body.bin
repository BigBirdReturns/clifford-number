[{"id":7924,"date":"2024-10-25T11:28:52","modified":"2025-01-23T00:43:18","slug":"first-aces-public-meeting-set-for-october-3","status":"publish","link":"https:\/\/space.commerce.gov\/first-aces-public-meeting-set-for-october-3\/","title":{"rendered":"First ACES Public Meeting &#8211; October 3, 2024"},"content":{"rendered":"\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"750\" height=\"368\" src=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg\" alt=\"Logo of the Advisory Committee on Excellence in Space - ACES\" class=\"wp-image-8412\" style=\"width:520px;height:auto\" srcset=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg 750w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-300x147.jpg 300w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-150x74.jpg 150w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-100x49.jpg 100w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-200x98.jpg 200w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-450x221.jpg 450w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-600x294.jpg 600w\" sizes=\"auto, (max-width: 750px) 100vw, 750px\" \/><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">The Office of Space Commerce (OSC) convened the first public meeting of the newly established Advisory Committee on Excellence in Space (ACES) on Thursday, October 3, 2024, from 9 a.m. to 5 p.m. EDT.<\/p>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"ACES Public Meeting Sept 24, 2024\" width=\"605\" height=\"340\" src=\"https:\/\/www.youtube.com\/embed\/Iz5pKfFXT5M?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\n<\/div><\/figure>\n\n\n\n<p class=\"wp-block-paragraph\">ACES provides advice and recommendations to NOAA and OSC on matters relating to OSC\u2019s statutory purview. Originally established in 2002 as the Advisory Committee on Commercial Remote Sensing (ACCRES), the committee was rescoped and rechartered in 2024 to address a broader range of commercial space issues.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Agenda (updated 9\/23)<\/h2>\n\n\n\n<figure class=\"wp-block-table is-style-stripes\"><table><tbody><tr><td>8:30 a.m. EDT<\/td><td><strong>Check-in<\/strong><\/td><\/tr><tr><td>9:00<\/td><td><strong>Call to order and roll call<\/strong><br><em>Jason Y. Kim, Designated Federal Officer (DFO), NOAA Office of Space Commerce<\/em><\/td><\/tr><tr><td>9:15<\/td><td><strong>FACA overview briefing<br><\/strong><em>Jennifer Chung, DOC Office of General Counsel<\/em><\/td><\/tr><tr><td>9:45<\/td><td><strong>Approval of subcommittee topics, chairs, and members<\/strong><br><em>Caryn Schenewerk, Chair; Dave Gauthier, Vice Chair; Jason Y. Kim, DFO<\/em><\/td><\/tr><tr><td>10:00<\/td><td><strong>Overview of Office of Space Commerce \/ Discussion<\/strong><br><em>Richard DalBello, Director, NOAA Office of Space Commerce<\/em><\/td><\/tr><tr><td>10:30<\/td><td><strong>Break<\/strong><\/td><\/tr><tr><td>10:40<\/td><td><strong>Licensing of Private Remote Sensing Space Systems \/ Discussion<\/strong><br><em>Sarah Brothers, Director, Commercial Remote Sensing Regulatory Affairs (CRSRA) Division, NOAA Office of Space Commerce<br><\/em><\/td><\/tr><tr><td>12:00 p.m.<\/td><td><strong>Lunch<\/strong><\/td><\/tr><tr><td>1:00<\/td><td><strong>NOAA leadership remarks \/ Discussion<\/strong><br><em>Hon. Rick Spinrad, Ph.D., Under Secretary for Oceans and Atmosphere<\/em><\/td><\/tr><tr><td>1:30<\/td><td><strong>DOC leadership remarks \/ Discussion<br><\/strong><em>Hon. Don Graves, Deputy Secretary of Commerce<\/em><\/td><\/tr><tr><td>2:00<\/td><td><strong>Commercial space mission authorization \/ Discussion<br><\/strong><em>Derek Hanson, NOAA Office of General Counsel<\/em><\/td><\/tr><tr><td>3:20<\/td><td><strong>Break<\/strong><\/td><\/tr><tr><td>3:30<\/td><td><strong>Public comments \/ Discussion<\/strong><\/td><\/tr><tr><td>4:00<\/td><td><strong>Finalize recommendations<\/strong><br><em>All members<\/em><\/td><\/tr><tr><td>4:45<\/td><td><strong>Next steps: Subcommittees, next meeting, by-laws, other business<\/strong><br><em>Caryn Schenewerk, Chair; Dave Gauthier, Vice Chair; Jason Y. Kim, DFO<\/em><\/td><\/tr><tr><td>4:55<\/td><td><strong>Group photo<\/strong><\/td><\/tr><tr><td>5:00<\/td><td><strong>Adjourn<\/strong><\/td><\/tr><\/tbody><\/table><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\">Presentation Materials<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">Slides presented during the meeting are provided below in PDF format.<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-Public-Presentation_L.pdf\">Office of Space Commerce<\/a> &#8211; Richard DalBello<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-_-CRSRA-Presentation_L.pdf\">Commercial Remote Sensing Regulatory Affairs<\/a> &#8211; Dr. Sarah Brothers<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-_-Mission-Authorization-Presentation_L.pdf\">Mission Authorization<\/a> &#8211; Gabriel Swiney, Derek Hanson, Gary Dreyzen<\/li>\n<\/ul>\n\n\n\n<h2 class=\"wp-block-heading\">Public Participation<\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The meeting was announced in the Federal Register and open the public via webinar connection, with the committee members meeting in person at the Department of Commerce in Washington. The agenda included dedicated time for the public to offer remarks.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.federalregister.gov\/d\/2024-21105\" target=\"_blank\" rel=\"noreferrer noopener\">View announcement in the Federal Register<\/a><\/p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-1024x576.jpg\" alt=\"Group of men and women pose in front of a blue curtain and flags\" class=\"wp-image-8295\" srcset=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-1024x576.jpg 1024w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-300x169.jpg 300w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-150x84.jpg 150w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-768x432.jpg 768w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-1536x864.jpg 1536w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-100x56.jpg 100w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-200x113.jpg 200w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-450x253.jpg 450w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-600x338.jpg 600w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72-900x506.jpg 900w, https:\/\/space.commerce.gov\/wp-content\/uploads\/GroupPhoto_72.jpg 2000w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/><\/figure>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"\/aces\" style=\"border-radius:20px\">Learn more about ACES<\/a><\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>The Office of Space Commerce (OSC) convened the first public meeting of the newly established Advisory Committee on Excellence in Space (ACES) on Thursday, October 3, 2024, from 9 a.m. to 5 p.m. EDT. ACES provides advice and recommendations to &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/first-aces-public-meeting-set-for-october-3\/\"> <span class=\"screen-reader-text\">First ACES Public Meeting &#8211; October 3, 2024<\/span> Read More &raquo;<\/a><\/p>\n","protected":false}}]