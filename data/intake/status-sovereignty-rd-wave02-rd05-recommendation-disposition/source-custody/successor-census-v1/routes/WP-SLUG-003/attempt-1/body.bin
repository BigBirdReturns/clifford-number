[{"id":9123,"date":"2025-01-29T13:05:41","modified":"2025-02-28T17:34:52","slug":"aces-public-meeting-march-5-2025","status":"publish","link":"https:\/\/space.commerce.gov\/aces-public-meeting-march-5-2025\/","title":{"rendered":"Second ACES Meeting Set for March 5"},"content":{"rendered":"\n<figure class=\"wp-block-image size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"750\" height=\"368\" src=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg\" alt=\"Logo of the Advisory Committee on Excellence in Space - ACES\" class=\"wp-image-8412\" style=\"object-fit:cover\" srcset=\"https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1.jpg 750w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-300x147.jpg 300w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-150x74.jpg 150w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-100x49.jpg 100w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-200x98.jpg 200w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-450x221.jpg 450w, https:\/\/space.commerce.gov\/wp-content\/uploads\/ACES-logo-homepage-1-600x294.jpg 600w\" sizes=\"auto, (max-width: 750px) 100vw, 750px\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>UPDATE: This meeting has been canceled until further notice.<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">The Office of Space Commerce announces the second meeting of the <a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/\">Advisory Committee on Excellence in Space (ACES)<\/a>, a Federal Advisory Committee providing NOAA guidance on U.S. commercial space issues. The meeting will be held on Wednesday, March 5, 2025.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https:\/\/www.federalregister.gov\/d\/2025-01885\" target=\"_blank\" rel=\"noreferrer noopener\">View announcement at federalregister.gov<\/a><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Members of the public are invited to join and participate via webinar.<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Date:<\/strong> March 5, 2025<\/li>\n\n\n\n<li><strong>Time:<\/strong> 9 a.m. to 5 p.m. EDT<\/li>\n\n\n\n<li><strong>Virtual Participation: <\/strong>A registration link will be provided on this website when available.&nbsp;<\/li>\n\n\n\n<li><strong>Public Comment<\/strong>s: Members of the public may submit comments ahead of the meeting to <a href=\"mailto:space.commerce@noaa.gov\">space.commerce@noaa.gov<\/a>. Comments are requested no later than March 3, 2025.<\/li>\n<\/ul>\n\n\n\n<p class=\"wp-block-paragraph\">An agenda and additional details will be released at <a href=\"\/aces\">space.commerce.gov\/aces<\/a> in the coming days.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>UPDATE: This meeting has been canceled until further notice. The Office of Space Commerce announces the second meeting of the Advisory Committee on Excellence in Space (ACES), a Federal Advisory Committee providing NOAA guidance on U.S. commercial space issues. The &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/aces-public-meeting-march-5-2025\/\"> <span class=\"screen-reader-text\">Second ACES Meeting Set for March 5<\/span> Read More &raquo;<\/a><\/p>\n","protected":false}}]