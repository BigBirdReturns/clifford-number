[{"id":8463,"date":"2024-10-31T09:57:12","modified":"2024-10-31T09:57:12","slug":"aces-subcommittee-on-commercial-space-mission-authorization","status":"publish","link":"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-commercial-space-mission-authorization\/","title":{"rendered":"ACES Subcommittee on Commercial Space Mission Authorization"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Commercial Space Mission Authorization in October 2024 to research and draft recommendations on the U.S. authorization and supervision of commercial space activities. The subcommittee is investigating approaches for authorizing new types of commercial space activities in a manner that encourages innovation while ensuring compliance with Outer Space Treaty obligations.<\/p>\n\n\n\n<h2 class=\"wp-block-heading\">Members<\/h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/dave-cavossa\/\" data-type=\"page\" data-id=\"8214\">Dave Cavossa<\/a> (Chair)<\/li>\n\n\n\n<li>Amber Charlesworth (on behalf of <a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/kalpak-gude\/\" data-type=\"page\" data-id=\"7842\">Kalpak Gude<\/a>)<\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/mary-lynne-dittmar\/\" data-type=\"page\" data-id=\"7966\">Mary Lynne Dittmar<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/alex-gilbert\/\" data-type=\"page\" data-id=\"7981\">Alex Gilbert<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/christopher-kunstadter\/\" data-type=\"page\" data-id=\"7839\">Chris Kunstadter<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/clare-martin\/\" data-type=\"page\" data-id=\"7976\">Clare Martin<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/jared-hautamaki\/\" data-type=\"page\" data-id=\"7929\">Jared Hautamaki<\/a><\/li>\n\n\n\n<li><a href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-membership\/al-tadros\/\" data-type=\"page\" data-id=\"8172\">Al Tadros<\/a><\/li>\n<\/ul>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/\" style=\"border-radius:20px\">Return to ACES homepage<\/a><\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>The Advisory Committee on Excellence in Space (ACES) established the Subcommittee on Commercial Space Mission Authorization in October 2024 to research and draft recommendations on the U.S. authorization and supervision of commercial space activities. The subcommittee is investigating approaches for &hellip;<\/p>\n<p class=\"read-more\"> <a class=\"more-link\" href=\"https:\/\/space.commerce.gov\/advisory-committee-on-excellence-in-space-aces\/aces-subcommittee-on-commercial-space-mission-authorization\/\"> <span class=\"screen-reader-text\">ACES Subcommittee on Commercial Space Mission Authorization<\/span> Read More &raquo;<\/a><\/p>\n","protected":false},"parent":6809}]