esponsive-block-editor-addons-block-buttons.block-b0452e00-ac80-4e6e-a848-0ca1133720bf {display: block;}}@media only screen and (max-width: 767px) {.responsive-block-editor-addons-block-buttons.block-b0452e00-ac80-4e6e-a848-0ca1133720bf {display: block;}}.responsive-block-editor-addons-block-spacer.block-f92f0882-1cde-49c0-8aea-9eea7fd13ecd {display: block;position: relative;z-index: 1;}.responsive-block-editor-addons-block-spacer.block-f92f0882-1cde-49c0-8aea-9eea7fd13ecd.responsive-block-editor-addons-spacer{height: 100px;margin: 0px;}@media only screen and (max-width: 976px) {.responsive-block-editor-addons-block-spacer.block-f92f0882-1cde-49c0-8aea-9eea7fd13ecd {display: block;z-index: 1;}}@media only screen and (max-width: 767px) {.responsive-block-editor-addons-block-spacer.block-f92f0882-1cde-49c0-8aea-9eea7fd13ecd {display: block;z-index: 1;}}</style><style id="wp-custom-css">
/* Remove cumulative gap between header and carousel */
div#wrapper,
.content-outer.container,
article.post-10750,
.entry-content,
.responsive-block-editor-addons-is-root-container,
main.content-area,
section.responsive-block-editor-addons-block-post-carousel,
.post-entry {
    padding-top: 0 !important;
    margin-top: 0 !important;
}
.wp-block-responsive-block-editor-addons-container.alignfull {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
}

/* Optional: Prevent horizontal scroll if using 100vw */
body {
    overflow-x: hidden;
}

/* Topbar Container */
#site-header-row-container-inner {
  background-color: #f1f1f1;
  /*border-bottom: 4px solid #005ea2;*/
  font-family: Arial, sans-serif;
  font-size: 10px;
  color: #212121;
  padding: 5px 20px;
}

/* --- Topbar text and toggle --- */
.gvt-accordion p.topline {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 0px;
}

.gvt-accordion img.flag {
  width: 20px;
  height: auto;
	padding-right: 5px	
}

.gvt-accordion .toggle-btn {
  cursor: pointer;
  color: #005ea2;
  text-decoration: underline;
  margin-left: 10px;
  font-weight: normal;
}

/* --- Hide the checkbox --- */
.gvt-accordion input[type=checkbox] {
  display: none;
}

/* --- Dropdown content --- */
.gvt-accordion .gvt-accordion-content {
  display: none;
  padding: 15px 0;
  /*border-top: 1px solid #d0d0d0;*/
  overflow: hidden;
}

/* Show dropdown when checked */
.gvt-accordion input[type=checkbox]:checked ~ .gvt-accordion-content {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 0px;
}

/* --- Columns --- */
.gvt-accordion .gvtleftbox,
.gvt-accordion .gvtrightbox {
  flex: 1 1 300px;
  max-width: 350px;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  padding: 5px;
  gap: 15px; /* ADD THIS for the gap */

	
/* grow/shrink, min width */
  max-width: 350px;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  padding-top: 0px;
	padding: 5px
}

.gvt-accordion .gvtleftbox img,
.gvt-accordion .gvtrightbox img {
  width: 20px;
	padding-left: 0px
	
}

.gvt-accordion .gvtleftbox p,
.gvt-accordion .gvtrightbox p {
  margin: 0;
}

/* --- Responsive --- */
@media (max-width: 500px) {
  .gvt-accordion .gvt-accordion-content {
    flex-direction: column;
    padding: 5px;
  }

/* --- Fix the Header Wrapper Padding --- */
.header-widgets-wrapper {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}
	
.wp-block-responsive-block-editor-addons-container :is(h1, h2, h3, h4, h5, h6, p, ul, ol) {
    margin-top: 0px;
}
</style>
	<style id="core-block-supports-inline-css">
.wp-container-core-columns-is-layout-7387b849{flex-wrap:nowrap;}
/*# sourceURL=core-block-supports-inline-css */
</style>

</head>

