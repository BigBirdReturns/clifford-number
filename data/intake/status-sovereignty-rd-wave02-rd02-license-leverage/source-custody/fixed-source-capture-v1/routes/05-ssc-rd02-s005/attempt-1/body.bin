  <h1 data-test="title" >
<span>SBIC directory</span>
</h1>


<div id="block-sba-content" class="block block-system block-system-main-block">
  
    
      
<article class="basic-page">
  
    

  <div>
        <div class="basic-page__summary" data-test="pageSummary">
      Contact an SBA-licensed Small Business Investment Company (SBIC) looking to invest in small businesses.
    </div>
    
    
        <div class="paragraph paragraph--type--text-section paragraph--view-mode--default sba-standard-margin-spacing">
          
            <div class="usa-prose field__item" data-test="fieldItem"><p><span>Use the fields to narrow your search and click “Filter” to see your results below. Companies are also listed alphabetically in the following table, or use the “Download CSV” button to download a complete list in .csv file format. Average Investment reflects FY15 - FY24 as of June 30, 2024.</span></p>
</div>
      
      </div>

    <div class="paragraph paragraph--type--contact-lookup paragraph--view-mode--default sba-standard-margin-spacing">
            <div class="views-element-container">  
<div class="view-contacts">
      <div class="view-contacts__header">
      
                   <div class="view-contacts__title-wrapper-no-title">
                      <a class="view-contacts__export-button usa-button usa-button--outline usa-button--inverse" href="/export/contacts/sbic">Download CSV</a>
                  </div>
           
        <form class="views-exposed-form usa-form usa-form--large" data-drupal-selector="views-exposed-form-sbic-listing-sbic-embed" action="/funding-programs/investment-capital/sbic-directory" method="get" id="views-exposed-form-sbic-listing-sbic-embed" accept-charset="UTF-8" novalidate="true">
      <div class="form-item js-form-item form-type-select js-form-type-select form-item-field-investment-strategy-target-id js-form-item-field-investment-strategy-target-id">
      <label for="edit-field-investment-strategy-target-id" class="usa-label control-label">Investment strategy</label>
  
  
          
  
        <div class="select-wrapper">
          <select data-drupal-selector="edit-field-investment-strategy-target-id" id="edit-field-investment-strategy-target-id" name="field_investment_strategy_target_id" class="form-select usa-select">
                        <option
            value="All" selected="selected">- Any -</option>
                                <option
            value="261">Balanced Venture</option>
                                <option
            value="262">Buyout</option>
                                <option
            value="264">Buyout/Growth/Hybrid</option>
                                <option
            value="263">Direct Lending</option>
                                <option
            value="258">Early Stage</option>
                                <option
            value="260">Early Venture</option>
                                <option
            value="269">Expansion</option>
                                <option
            value="265">Growth Equity</option>
                                <option
            value="266">Hybrid Debt/Equity</option>
                                <option
            value="267">Mezzanine</option>
                                <option
            value="268">Multiple</option>
                                <option
            value="259">Venture</option>
                  </select>
      </div>
  
  
  
  
  
  
  
  </div>
<div class="form-item js-form-item form-type-select js-form-type-select form-item-field-fund-style-target-id js-form-item-field-fund-style-target-id">
      <label for="edit-field-fund-style-target-id" class="usa-label control-label">Fund Style</label>
  
  
          
  
        <div class="select-wrapper">
          <select data-drupal-selector="edit-field-fund-style-target-id" id="edit-field-fund-style-target-id" name="field_fund_style_target_id" class="form-select usa-select">
                        <option
            value="All" selected="selected">- Any -</option>
                                <option
            value="358">Fund of Funds</option>
                                <option
            value="285">Growth Equity</option>
                                <option
            value="286">Hybrid</option>
                                <option
            value="287">Private Credit</option>
                                <option
