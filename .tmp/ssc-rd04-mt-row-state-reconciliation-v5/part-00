test "$(git diff --name-only --diff-filter=A "$CANONICAL_PARENT" | LC_ALL=C sort)" = "$(printf '%s\n' "${PATHS[@]}" | LC_ALL=C sort)"
test -z "$(git diff --name-only --diff-filter=MDTCRUXB "$CANONICAL_PARENT")"

