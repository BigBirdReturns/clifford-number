class ValidationError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValidationError(message)


def load(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ValidationError(f"invalid JSON {path}: {exc}") from exc


def sha256_bytes(body: bytes) -> str:
    return hashlib.sha256(body).hexdigest()


def canonical_sha(obj: Any) -> str:
    return sha256_bytes(json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8"))


def file_identity(path: Path) -> dict[str, Any]:
    body = path.read_bytes()
    return {"bytes": len(body), "sha256": sha256_bytes(body)}


def exact_keys(obj: dict[str, Any], keys: set[str], label: str) -> None:
    require(set(obj) == keys, f"{label} keys differ: {sorted(set(obj) ^ keys)}")


def validate(product_root: Path, repo_root: Path, pdf_tools: bool = False) -> dict[str, Any]:
    out = product_root / REL_DIR
    require(out.is_dir(), f"missing product directory {out}")
    actual_paths = sorted(p.relative_to(product_root).as_posix() for p in product_root.rglob("*") if p.is_file())
    expected_paths = sorted((REL_DIR / name).as_posix() for name in FILES)
    require(actual_paths == expected_paths, f"product path denominator differs: {actual_paths}")
    require(all(not p.startswith(".github/") and "/tools/" not in p and "/test/" not in p for p in actual_paths), "workflow/tool/test path present")

    docs = {name: load(out / name) for name in FILES}
    adjudication = docs["adjudication.json"]
    candidate = docs["candidate-disposition.json"]
    current = docs["current-cell-custody.json"]
    manifest = docs["product-manifest.json"]
    source = docs["source-custody.json"]
    summary = docs["summary.json"]

    for name, obj in docs.items():
        require(isinstance(obj, dict), f"{name} must be an object")
        require(obj.get("wave_id") == "SSC-RD-W03", f"{name} wave mismatch")
        require(obj.get("lane_id") == "RD-04", f"{name} lane mismatch")
        require(obj.get("class_id") == "RD-04-C02", f"{name} class mismatch")
        require(obj.get("issue") == 1017, f"{name} issue mismatch")

    exact_keys(adjudication, {
        "schema_version", "wave_id", "lane_id", "class_id", "issue", "construction_date", "object_class",
        "terminal_classification", "source_finding", "candidate_disposition", "current_authority_state",
        "authority_boundary", "evidence_ledger", "prohibited_inferences"
    }, "adjudication")
    exact_keys(candidate, {
        "schema_version", "wave_id", "lane_id", "class_id", "issue", "candidate_id", "decision_id", "unit_id",
        "field_id", "candidate_source_body_sha256", "original_candidate_target_state", "disposition",
        "promotion_authorized", "historical_evidence_retained", "current_field_state_after",
        "current_field_terminal_after", "current_row_state_after", "reason_code", "reasoning", "review_custody",
        "supersession", "next_bounded_operation"
    }, "candidate")
    exact_keys(current, {
        "schema_version", "wave_id", "lane_id", "class_id", "issue", "canonical_parent", "canonical_parent_tree",
        "matrix", "field_contract", "north_dakota", "expired_predecessor_comparators", "mutation_boundary"
    }, "current-cell custody")
    exact_keys(source, {
        "schema_version", "wave_id", "lane_id", "class_id", "issue", "construction_date", "source_classification",
        "source_custody", "page_complete_review", "source_finding", "transport_provenance", "request_boundary"
    }, "source custody")
    exact_keys(summary, {
        "schema_version", "wave_id", "lane_id", "class_id", "issue", "status", "source", "decision",
        "unchanged_counts", "effects", "next_bounded_operation", "control_question"
    }, "summary")

    require(current["canonical_parent"] == CANONICAL_PARENT and current["canonical_parent_tree"] == CANONICAL_TREE, "canonical parent binding differs")
    require(manifest["canonical_parent"] == CANONICA