assert len(target)==len(rowcell)==1
target,rowcell=target[0],rowcell[0]
assert digest(target)==target_expected and digest(rowcell)==row_expected
assert current_row['row_state']=='still_open' and current_row['terminal_fields']==7 and current_row['open_fields']==2
before_row_sha=digest(current_row)
unchanged_rows_before={r['unit_id']:digest(r) for r in matrix['rows'] if r['unit_id']!='US-STATE-ND'}
