rows=[r for r in matrix['rows'] if r.get('unit_id')=='US-STATE-ND']
assert len(rows)==1
current_row=rows[0]
target=[c for c in current_row['cells'] if c.get('field_id')=='abawd_or_work_requirement_waiver_state_and_governing_period']
