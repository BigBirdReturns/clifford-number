  "stages": [
    {
      "stage_id": "C1-agenda-formation",
      "label": "Agenda formation",
      "question": "Who defined the public problem, supplied the vocabulary, elevated the threat or opportunity, and excluded alternatives before a formal gate existed?",
      "required_objects": [
        "problem frames",
        "commissioning records",
        "drafts and consultations",
        "advisory and convening surfaces",
        "authorship and adoption chronology"
      ]
    },
    {
      "stage_id": "C2-option-set-formation",
      "label": "Option-set formation",
      "question": "Which people, firms, architectures, vehicles, and financing models became eligible, and who selected or validated them before formal competition?",
      "required_objects": [
        "complete denominators",
        "accelerator and fund cohorts",
        "market research",
        "eligibility and exclusion rules",
        "unsuccessful and non-networked controls"
      ]
    },
    {
      "stage_id": "C3-public-conversion",
      "label": "Public conversion",
      "question": "Which policy, appointment, appropriation, solicitation, evaluation, prototype, approval, or authority instrument made the private proposition publicly operative?",
      "required_objects": [
        "adoption records",
        "appointments",
        "budget and authority instruments",
        "solicitations and evaluations",
        "orders, grants, leases, and resolutions"
      ]
    },
    {
      "stage_id": "C4-control-architecture",
      "label": "Control architecture",
      "question": "Who acquired control over data, ontology, interfaces, standards, intellectual property, accreditation, integration knowledge, governance rights, land, debt, or contract options?",
      "required_objects": [
        "data-rights schedules",
        "interface-control documents",
        "licenses and assignments",
        "standards records",
        "governance instruments",
        "title, lease, lien, and debt instruments"
      ]
    },
    {
      "stage_id": "C5-dependency-and-compulsion",
      "label": "Dependency and compulsion",
      "question": "When did an optional product or arrangement become preferred, default, required, technically indispensable, legally mandatory, or practically irreversible?",
      "required_objects": [
        "mandates and operating policies",
        "workflow and access rules",
        "technical dependency records",
        "switching-cost and portability evidence",
        "appeal, override, and exception mechanisms"
      ]
    },
    {
      "stage_id": "C6-residual-value",
      "label": "Residual value",
      "question": "After public money, authority, infrastructure, and risk were applied, who retained equity, recurring revenue, intellectual property, data position, land value, governance rights, contract options, or strategic market position?",
      "required_objects": [
        "ownership and fund records",
        "compensation and transaction records",
        "revenue and award stages",
        "public contribution and risk ledgers",
        "private rights and upside ledgers",
        "clawbacks and recovery rights"
      ]
    },
    {
      "stage_id": "C7-reversibility-and-counterpower",
      "label": "Reversibility and counterpower",
      "question": "Could the public inspect, challenge, substitute, terminate, fork, migrate, recover, or reverse the system, and were meaningful competitors and counterweights preserved?",
      "required_objects": [
        "termination and transition clauses",
        "data and ontology portability",
        "substitution tests",
        "audits and inspector findings",
        "protests, litigation, and adjudications",
        "ordinary and unsuccessful comparators"
      ]
    }
  ],
