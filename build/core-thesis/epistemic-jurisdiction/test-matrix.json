{
  "schema_version": "m04f-epistemic-jurisdiction-test-matrix@3",
  "estate_id": "epistemic-jurisdiction-burden-counterfactual-estate",
  "proof_tests": [
    {
      "test_id": "EJT1-inference-authority",
      "question": "Who may convert incomplete knowledge, risk, relationship, forecast, or professional judgment into institutional action?",
      "minimum_objects": [
        "named actor or institution",
        "bounded system",
        "dated authority or workflow",
        "action enabled",
        "alternative explanation"
      ]
    },
    {
      "test_id": "EJT2-threshold-authorship",
      "question": "Who selected the confidence, eligibility, risk, performance, or sufficiency threshold?",
      "minimum_objects": [
        "threshold or standard",
        "author or adopting authority",
        "date/version",
        "exception rule",
        "change history"
      ]
    },
    {
      "test_id": "EJT3-burden-allocation",
      "question": "Who must justify the action before it occurs, and who must prove error, injury, or entitlement afterward?",
      "minimum_objects": [
        "ex ante justification rule",
        "post-action burden",
        "review forum",
        "standard of review",
        "cost and timing"
      ]
    },
    {
      "test_id": "EJT4-temporal-asymmetry",
      "question": "Can the affected party obtain notice, inspection, or a stay before consequence, or only review afterward?",
      "minimum_objects": [
        "notice chronology",
        "action chronology",
        "stay or pause path",
        "review chronology",
        "final consequence"
      ]
    },
    {
      "test_id": "EJT5-evidence-custody",
      "question": "Who controls the data, model, logs, rationale, rejected alternatives, and records needed to reconstruct the decision?",
      "minimum_objects": [
        "source inventory",
        "custodian",
        "retention/versioning",
        "disclosure route",
        "audit or discovery right"
      ]
    },
    {
      "test_id": "EJT6-counterfactual-foreclosure",
      "question": "Which alternatives were allowed to generate evidence, which were excluded, and who benefited from their absence?",
      "minimum_objects": [
        "complete denominator",
        "selection/exclusion record",
        "pilot or operating result",
        "matched comparator",
        "stopping rule"
      ]
    },
    {
      "test_id": "EJT7-exception-privilege",
      "question": "Who may depart from the rule, authorize an exception, or reinterpret failure without being recategorized as noncompliant?",
      "minimum_objects": [
        "ordinary rule",
        "exception holder",
        "exception basis",
        "recorded use",
        "review or appeal"
      ]
    },
    {
      "test_id": "EJT8-error-metabolism",
      "question": "Who bears the immediate error or consequence, and who receives the resulting learning, capacity, revenue, or legitimacy?",
      "minimum_objects": [
        "error or uncertainty",
        "affected party",
        "learning loop",
        "benefit recipient",
        "correction or compensation"
      ]
    }
  ],
